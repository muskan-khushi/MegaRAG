    <edge source="Migration" target="Ironworking">
      <data key="d6">2.0</data>
      <data key="d7">Ironworking facilitated migration by clearing paths through dense forests, connecting previously isolated regions.</data>
      <data key="d8">"path_clearing"&lt;?|&gt;&lt;1&gt;</data>
