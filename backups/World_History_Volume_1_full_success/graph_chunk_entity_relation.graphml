    <node id="Athens">
      <data key="d0">Athens</data>
      <data key="d1">historical_figure</data>
      <data key="d2">A major city-state in Ancient Greece, renowned for its democratic governance, cultural achievements, and participation in the Peloponnesian War.</data>
      <data key="d3">chunk-3097b7631833d13406561b217f399efa</data>
