    </node>
    <node id="Ptolemaic rulers of Egypt">
      <data key="d0">Ptolemaic rulers of Egypt</data>
      <data key="d1">historical_figure</data>
      <data key="d2">The Ptolemaic rulers of Egypt legitimized their rule by adopting Egyptian religious practices and styling themselves as pharaohs.</data>
      <data key="d3">chunk-69daf8633779d8478fa1be3b5bf8fb8b</data>
      <data key="d4">dumps/World_History_Volume_1/pages_content.json</data>
