      <data key="d11">1783211067</data>
    </edge>
    <edge source="Maya Ball Court" target="Decipherment of Maya Writing">
      <data key="d6">2.0</data>
      <data key="d7">The understanding of the Maya writing system contributed greatly to knowledge about their ball court designs and cultural practices.</data>
      <data key="d8">"writing system,4,ball court",decipherment</data>
      <data key="d9">chunk-86b8b74f4921d905c9deab7414c00e0c</data>
