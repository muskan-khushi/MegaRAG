    <node id="&lt;World Trade Organization (WTO)">
      <data key="d0">&lt;World Trade Organization (WTO)</data>
      <data key="d1">&lt;source_or_artifact&gt;</data>
      <data key="d2">&lt;The World Trade Organization is an international body meant to regulate global trade, established in 1995, continuing a pattern of organized trade regulation that dates back to historical efforts such as those initiated by Chinggis Khan.&gt;</data>
      <data key="d3">chunk-4e57e6349a7929fcf289f8da82a3abde</data>
      <data key="d4">dumps/World_History_Volume_1/pages_content.json</data>
