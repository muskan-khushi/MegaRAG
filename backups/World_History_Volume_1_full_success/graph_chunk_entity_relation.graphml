    </edge>
    <edge source="&lt;Zoroastrianism&gt;" target="&lt;Angra Mainu&gt;">
      <data key="d6">12.0</data>
      <data key="d7">Angra Mainu is a central antagonist to Ahura Mazda in Zoroastrianism, symbolizing wickedness and destruction as a contrast to the forces of good.</data>
      <data key="d8">opposition_relationship</data>
      <data key="d9">chunk-2e05c323f2387cfb1c337fb65115e181</data>
      <data key="d10">dumps/World_History_Volume_1/pages_content.json</data>
