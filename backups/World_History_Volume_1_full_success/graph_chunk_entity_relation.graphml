    <node id="Unit 3 An Age Of Religion, 500–1200 CE">
      <data key="d0">Unit 3 An Age Of Religion, 500–1200 CE</data>
      <data key="d1">time_period</data>
      <data key="d2">This time period spans from 500 to 1200 CE and focuses on religious developments.</data>
