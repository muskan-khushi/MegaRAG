    </node>
    <node id="Cleopatra statue">
      <data key="d0">Cleopatra statue</data>
      <data key="d1">source_or_artifact</data>
      <data key="d2">The Cleopatra statue, one of only seven surviving from ancient times, reflects the early influence of Egyptian art on Greek sculptures and shares conventions such as arms close to the body and parallel feet.</data>
      <data key="d3">chunk-92db262d76cb92ec5e196188c5a0fba7</data>
      <data key="d4">dumps/World_History_Volume_1/pages_content.json</data>
