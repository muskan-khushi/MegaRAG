      <data key="d1">geographical_location</data>
      <data key="d2">&lt;Adulis was an important port city on the Red Sea controlled by the Aksumites before it was conquered by Arab forces in the 630s CE.&gt;</data>
      <data key="d3">chunk-6ea12f4a3376daf41b860db682d4f0a3</data>
      <data key="d4">dumps/World_History_Volume_1/pages_content.json</data>
