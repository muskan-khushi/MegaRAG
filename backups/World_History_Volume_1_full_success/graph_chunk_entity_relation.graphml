    <node id="&lt;&quot;Amenhotep III&quot;">
      <data key="d0">&lt;"Amenhotep III"</data>
      <data key="d1">&lt;"historical_figure</data>
      <data key="d2">&lt;"Amenhotep III was a Pharaoh of the Eighteenth Dynasty of Egypt known for his nearly forty-year reign. He is recognized for building monumental architectural projects, including temples and palaces in Thebes."&lt;|</data>
      <data key="d3">chunk-e99b695e71f9120e8fa39e113560a3bc</data>
