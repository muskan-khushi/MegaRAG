    <node id="San Lorenzo">
      <data key="d0">San Lorenzo</data>
      <data key="d1">historical_concept_or_event</data>
      <data key="d2">San Lorenzo marks the beginning of the Olmec civilization, which stretches back to approximately 1350 BCE with large earthen platforms and monumental architecture.</data>
