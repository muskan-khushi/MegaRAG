      <data key="d6">2.0</data>
      <data key="d7">&lt;"This event served to strengthen Piye’s claim to power by establishing his family's influence over key religious figures, thus reinforcing both political and spiritual authority."&gt;</data>
      <data key="d8">&lt;"Political Strategy; Religious Influence"&gt;</data>
      <data key="d9">chunk-b13ca3c5039a592c7efe58cadf289401</data>
      <data key="d10">dumps/World_History_Volume_1/pages_content.json</data>
      <data key="d11">1783211071</data>
    </edge>
    <edge source="&lt;&quot;Kushite kingdom&quot;" target="&lt;&quot;Kushite conquest of Egypt&quot;&gt;">
      <data key="d6">2.0</data>
      <data key="d7">&lt;"The conquest signaled a significant shift in the Kushites' geopolitical position from controlling parts of Egypt to eventually ruling it entirely, indicating a profound change in their strategic goals and capabilities."&gt;</data>
      <data key="d8">&lt;"Military Power; Political Control; Cultural Expansion"&gt;</data>
      <data key="d9">chunk-b13ca3c5039a592c7efe58cadf289401</data>
      <data key="d10">dumps/World_History_Volume_1/pages_content.json</data>
      <data key="d11">1783211072</data>
    </edge>
