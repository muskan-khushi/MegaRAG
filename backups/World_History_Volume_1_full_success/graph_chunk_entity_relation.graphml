    <node id="tenth-century Fatimid Caliphate">
      <data key="d0">tenth-century Fatimid Caliphate</data>
      <data key="d1">historical_concept_or_event</data>
      <data key="d2">"The tenth-century Fatimid Caliphate was a powerful state based in North Africa with control extending to the holy city of Mecca, represented by Figure 13.12."&lt;&lt;|</data>
      <data key="d3">chunk-4e6159a3a03e9e9c4b77cef61f6b5166</data>
      <data key="d4">dumps/World_History_Volume_1/pages_content.json</data>
