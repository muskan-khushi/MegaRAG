      <data key="d0">Margins of Empire</data>
      <data key="d1">geographical_location</data>
      <data key="d2">The Margins of Empire represents the peripheral regions under the influence or control of larger empires.</data>
      <data key="d3">chunk-c13c9d68535c84e9a2084524eeed3c86</data>
