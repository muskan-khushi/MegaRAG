    </node>
    <node id="Augustan Victory Monument">
      <data key="d0">Augustan Victory Monument</data>
      <data key="d1">source_or_artifact</data>
      <data key="d2">A monument from Nicopolis collected by Emperor Constantine for his new capital city.</data>
      <data key="d3">chunk-1ca8bf4d9560cf713649b9941df5971f</data>
      <data key="d4">dumps/World_History_Volume_1/pages_content.json</data>
      <data key="d5">1783210946</data>
