    <node id="Ottoman miletsystem">
      <data key="d0">Ottoman miletsystem</data>
      <data key="d1">historical_concept_or_event</data>
      <data key="d2">The Ottoman millet system was established during Mehmed's reign, allowing significant religious community autonomy. This administrative system granted substantial autonomy to different religious communities, permitting them to manage their own internal affairs and maintain their distinct cultural and religious practices under the overarching sovereignty of the Ottoman Empire.</data>
      <data key="d3">chunk-8adac32853d2cbcb9cfc409ace493450</data>
      <data key="d4">dumps/World_History_Volume_1/pages_content.json</data>
      <data key="d5">1783211034</data>
    </node>
    <node id="hakhambashi">
      <data key="d0">hakhambashi</data>
      <data key="d1">civilization_or_empire</data>
      <data key="d2">Hakhambashi, or chief rabbi, is a position established by Mehmed II for leading the Jewish community in the Ottoman Empire.</data>
      <data key="d3">chunk-8adac32853d2cbcb9cfc409ace493450</data>
      <data key="d4">dumps/World_History_Volume_1/pages_content.json</data>
