      <data key="d4">dumps/World_History_Volume_1/pages_content.json</data>
      <data key="d5">1783210800</data>
    </node>
    <node id="&lt;Shoes&gt;">
      <data key="d0">&lt;Shoes&gt;</data>
      <data key="d1">source_or_artifact</data>
      <data key="d2">Footwear used to protect feet from the harsh elements, key survival equipment in the Paleolithic Age. Ötzi’s shoes are a prime example of this.</data>
      <data key="d3">chunk-959d0e5d4763f5423c8c6e422ec0cdb2</data>
      <data key="d4">dumps/World_History_Volume_1/pages_content.json</data>
