    <node id="&lt;&quot;Justinian I&quot;&gt;">
      <data key="d0">&lt;"Justinian I"&gt;</data>
      <data key="d1">&lt;"historical_figure"&gt;</data>
      <data key="d2">&lt;"Emperor Justinian I was the Roman Emperor who ruled from 527 to 565. He is known for his legal reforms, extensive building projects, and significant military achievements."</data>
      <data key="d3">chunk-0f3483082d977617409e75f5948382d4</data>
      <data key="d4">dumps/World_History_Volume_1/pages_content.json</data>
