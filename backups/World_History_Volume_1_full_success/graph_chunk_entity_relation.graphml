    <node id="Eleventh Century">
      <data key="d0">Eleventh Century</data>
      <data key="d1">time_period</data>
      <data key="d2">The eleventh century marked a significant period when Ghana faced challenges related to Islamic influence and expansion.</data>
      <data key="d3">chunk-d32d7ef2fac445505a9bd6f9b878a6f4</data>
      <data key="d4">dumps/World_History_Volume_1/pages_content.json</data>
