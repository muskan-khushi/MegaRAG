    <node id="&lt;&quot;Medina&quot;">
      <data key="d0">&lt;"Medina"</data>
      <data key="d1">&lt;"geographical_location</data>
      <data key="d2">&lt;Entity_description: The first capital of the Rashidun Caliphate, serving as Muhammad's refuge and from where he governed. It remained an important city for early Islamic governance before moving to Damascus under Umayyad rule.</data>
      <data key="d3">chunk-eca248d7090f58e7e1c63a9bfb407080</data>
      <data key="d4">dumps/World_History_Volume_1/pages_content.json</data>
