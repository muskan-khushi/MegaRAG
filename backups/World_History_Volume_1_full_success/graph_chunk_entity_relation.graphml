    <node id="Allies">
      <data key="d0">Allies</data>
      <data key="d1">historical_concept_or_event</data>
      <data key="d2">Alliances with other kingdoms like Kush played a significant role during the Second Intermediate Period in maintaining and expanding power.</data>
      <data key="d3">chunk-01819cdf305281e0ef22ba7cb3469e6a</data>
      <data key="d4">dumps/World_History_Volume_1/pages_content.json</data>
