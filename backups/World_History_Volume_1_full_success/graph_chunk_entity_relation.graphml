    <node id="&lt;&quot;Franklin D. Roosevelt&quot;&gt;">
      <data key="d0">&lt;"Franklin D. Roosevelt"&gt;</data>
      <data key="d1">&lt;historical_figure&gt;</data>
      <data key="d2">&lt;"Roosevelt was the President of the United States during World War II and delivered one of the most famous speeches in history, addressing the American people after Japan's attack on Pearl Harbor."&gt;</data>
      <data key="d3">chunk-22e11e00c89a73ab13d5224fcee3fd78</data>
      <data key="d4">dumps/World_History_Volume_1/pages_content.json</data>
      <data key="d5">1783210791</data>
    </node>
    <node id="&lt;&quot;United States&quot;&gt;">
      <data key="d0">&lt;"United States"&gt;</data>
      <data key="d1">&lt;geographical_location&gt;</data>
      <data key="d2">&lt;"The United States is a major country that played a significant role in World War II. In Roosevelt's speech, he expresses unity and determination for victory against the Japanese Empire."&gt;</data>
      <data key="d3">chunk-22e11e00c89a73ab13d5224fcee3fd78</data>
      <data key="d4">dumps/World_History_Volume_1/pages_content.json</data>
      <data key="d5">1783210791</data>
    </node>
    <node id="&lt;&quot;Japanese Empire&quot;&gt;">
      <data key="d0">&lt;"Japanese Empire"&gt;</data>
      <data key="d1">&lt;historical_concept_or_event&gt;</data>
      <data key="d2">&lt;"The Japanese Empire refers to the military government of Japan during World War II. The attack on Pearl Harbor by Japan is a key event that Roosevelt mentions in his speech, framing it as a premeditated and unprovoked invasion."&gt;</data>
      <data key="d3">chunk-22e11e00c89a73ab13d5224fcee3fd78</data>
      <data key="d4">dumps/World_History_Volume_1/pages_content.json</data>
      <data key="d5">1783210791</data>
    </node>
    <node id="&lt;&quot;attack by japan&quot;&gt;">
      <data key="d0">&lt;"attack by japan"&gt;</data>
      <data key="d1">&lt;historical_concept_or_event&gt;</data>
      <data key="d2">&lt;"The attack by Japan refers to the surprise offensive launched against the United States at Pearl Harbor. This event marks the official entry of the United States into World War II. Roosevelt vividly describes it as a 'surprise offensive' and 'unprovoked' act of aggression."&gt;</data>
      <data key="d3">chunk-22e11e00c89a73ab13d5224fcee3fd78</data>
      <data key="d4">dumps/World_History_Volume_1/pages_content.json</data>
      <data key="d5">1783210791</data>
    </node>
    <node id="&lt;&quot;Pearl Harbor&quot;&gt;">
      <data key="d0">&lt;"Pearl Harbor"&gt;</data>
      <data key="d1">&lt;geographical_location&gt;</data>
      <data key="d2">&lt;"Pearl Harbor was an American naval base in Hawaii, where Japan launched its surprise attack on December 7, 1941. This event is the central topic of Roosevelt's speech and marks a critical turning point in World War II."&gt;</data>
      <data key="d3">chunk-22e11e00c89a73ab13d5224fcee3fd78</data>
      <data key="d4">dumps/World_History_Volume_1/pages_content.json</data>
      <data key="d5">1783210791</data>
    </node>
    <node id="&lt;&quot;Congress&quot;&gt;">
      <data key="d0">&lt;"Congress"&gt;</data>
      <data key="d1">&lt;cultural_or_religious_movement&gt;</data>
      <data key="d2">&lt;"Congress, here primarily refers to the legislative branch of the United States government. In the context of Roosevelt's speech, he emphasizes the necessity for Congress to pass laws and take actions to support the war effort."&gt;</data>
      <data key="d3">chunk-22e11e00c89a73ab13d5224fcee3fd78</data>
      <data key="d4">dumps/World_History_Volume_1/pages_content.json</data>
