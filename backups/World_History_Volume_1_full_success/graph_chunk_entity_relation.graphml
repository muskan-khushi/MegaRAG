      <data key="d0">&lt;"West Africa geographical_location"&gt;</data>
      <data key="d1">geographical_location</data>
      <data key="d2">The western part of the African continent, known for its diverse cultural and linguistic groups.</data>
      <data key="d3">chunk-77b80d611a0770d6a510e247aaf56af0</data>
      <data key="d4">dumps/World_History_Volume_1/pages_content.json</data>
