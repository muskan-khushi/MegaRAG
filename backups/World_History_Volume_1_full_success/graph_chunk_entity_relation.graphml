      <data key="d0">&lt;"Acropolis"&gt;</data>
      <data key="d1">&lt;cultural_or_religious_site&gt;</data>
      <data key="d2">&lt;"Forts or strongholds from which inhabitants could retreat during danger, often with significant temples nearby. Important centers for religious and cultural activities in Ancient Greece."&gt;</data>
      <data key="d3">chunk-deeeaa267faae20e29663a365d84657c</data>
      <data key="d4">dumps/World_History_Volume_1/pages_content.json</data>
