    </node>
    <node id="Barygaza">
      <data key="d0">Barygaza</data>
      <data key="d1">geographical_location</data>
      <data key="d2">Barygaza was an important port city along the west coast of India mentioned in the Periplus for its trade activities and presence of Greek coins bearing inscriptions.</data>
      <data key="d3">chunk-bceaa7979e3d60d1deb8d4848dbe01fa</data>
      <data key="d4">dumps/World_History_Volume_1/pages_content.json</data>
