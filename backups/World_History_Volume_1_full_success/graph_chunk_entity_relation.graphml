    <node id="Ottoman Control Overland and Maritime Silk Routes">
      <data key="d0">Ottoman Control Overland and Maritime Silk Routes</data>
      <data key="d1">geographical_location</data>
      <data key="d2">During Ottoman rule in 1517-16th century, the Ottomans expanded their control over major trade routes such as the Silk Road. This expansion included defeating the Mamluk Sultanate and establishing significant trading relationships with India.</data>
      <data key="d3">chunk-54c526f99d90b73a6903c122c8847aeb</data>
      <data key="d4">dumps/World_History_Volume_1/pages_content.json</data>
      <data key="d5">1783211028</data>
    </node>
    <node id="Fall of Constantinople">
      <data key="d0">Fall of Constantinople</data>
      <data key="d1">historical_event</data>
      <data key="d2">Marks the end of the Byzantine Empire in 1453 AD, signifying a major shift in world power dynamics. This event led to a wave of Greek refugees seeking refuge in western Europe, particularly Venice, where Anna Notaras provided assistance.</data>
      <data key="d3">chunk-54c526f99d90b73a6903c122c8847aeb</data>
      <data key="d4">dumps/World_History_Volume_1/pages_content.json</data>
      <data key="d5">1783211028</data>
    </node>
    <node id="Trade Routes and European Response">
      <data key="d0">Trade Routes and European Response</data>
      <data key="d1">time_period</data>
      <data key="d2">The shift of European trading patterns from overland to maritime routes in the 15-16th century due to heavy Ottoman taxes on overland trade and a desire to avoid dealing with Muslims directly. This period also marked an increased interest in maritime exploration for new pathways.</data>
      <data key="d3">chunk-54c526f99d90b73a6903c122c8847aeb</data>
      <data key="d4">dumps/World_History_Volume_1/pages_content.json</data>
      <data key="d5">1783211028</data>
    </node>
    <node id="Anna Notaras">
      <data key="d0">Anna Notaras</data>
      <data key="d1">historical_figure</data>
      <data key="d2">A well-known noblewoman who aided many refugees from Constantinople, especially in Venice where she facilitated their settlement and adjustment to their new lives through her patronage.</data>
      <data key="d3">chunk-54c526f99d90b73a6903c122c8847aeb</data>
      <data key="d4">dumps/World_History_Volume_1/pages_content.json</data>
      <data key="d5">1783211028</data>
    </node>
    <node id="Byzantine Migration to Italy">
      <data key="d0">Byzantine Migration to Italy</data>
      <data key="d1">migration_event</data>
      <data key="d2">The movement of Greeks and scholars from Constantinople to northern Italian city-states like Venice during the late 1400s-early 1500s, driven by safety concerns after the fall of their capital.</data>
      <data key="d3">chunk-54c526f99d90b73a6903c122c8847aeb</data>
      <data key="d4">dumps/World_History_Volume_1/pages_content.json</data>
      <data key="d5">1783211028</data>
    </node>
    <node id="Knowledge Transfer During Renaissance">
      <data key="d0">Knowledge Transfer During Renaissance</data>
      <data key="d1">knowledge_transfer</data>
      <data key="d2">The transfer of classical texts and ideas from Byzantine scholars to Europe in the latter part of the 1400s-early 1500s, significantly impacting the intellectual growth of the Italian Renaissance.</data>
      <data key="d3">chunk-54c526f99d90b73a6903c122c8847aeb</data>
      <data key="d4">dumps/World_History_Volume_1/pages_content.json</data>
      <data key="d5">1783211028</data>
    </node>
    <node id="Petrarch Influence on Latin Language and Style">
      <data key="d0">Petrarch Influence on Latin Language and Style</data>
      <data key="d1">historical_concept_or_event</data>
      <data key="d2">The advocacy by Petrarch for using 'pure' Classical Latin along with his encouragement to emulate ancient Roman orators and poets, which had a profound impact on the revival of classical culture in Europe.</data>
      <data key="d3">chunk-54c526f99d90b73a6903c122c8847aeb</data>
      <data key="d4">dumps/World_History_Volume_1/pages_content.json</data>
      <data key="d5">1783211028</data>
    </node>
    <node id="Byzantine Influence on Italian City-States Trade and Culture">
      <data key="d0">Byzantine Influence on Italian City-States Trade and Culture</data>
      <data key="d1">trade_agreement</data>
      <data key="d2">The establishment of rich trade relationships between Byzantine refugees and Venetian city-states during the late 1400s-early 1600s, driven by significant economic activity in areas overseen by the Ottoman Empire.</data>
      <data key="d3">chunk-54c526f99d90b73a6903c122c8847aeb</data>
      <data key="d4">dumps/World_History_Volume_1/pages_content.json</data>
      <data key="d5">1783211028</data>
    </node>
    <node id="Petrarch's Contribution to Renaissance Revival of Classics">
      <data key="d0">Petrarch's Contribution to Renaissance Revival of Classics</data>
      <data key="d1">intellectual_movement</data>
      <data key="d2">Petrarch’s promotion and application of classical Latin literature and style, focusing on simplicity and clarity, which strongly influenced the cultural revival during the Italian Renaissance.</data>
      <data key="d3">chunk-54c526f99d90b73a6903c122c8847aeb</data>
      <data key="d4">dumps/World_History_Volume_1/pages_content.json</data>
      <data key="d5">1783211028</data>
    </node>
    <node id="1485">
      <data key="d0">1485</data>
      <data key="d1">time_period</data>
      <data key="d2">1485 marks the year of Sandro Botticelli's painting The Birth of Venus, which is a symbol of the evolving artistic sensibilities during the Renaissance period.</data>
      <data key="d3">chunk-23659b0349306744ecfc24e78e40bee3</data>
      <data key="d4">dumps/World_History_Volume_1/pages_content.json</data>
      <data key="d5">1783211028</data>
    </node>
    <node id="The Birth of Venus (1485)">
      <data key="d0">The Birth of Venus (1485)</data>
      <data key="d1">artifact</data>
      <data key="d2">This artifact, a painting by Sandro Botticelli in 1485, depicts the Roman goddess Venus emerging from the water onto a seashell. It is associated with the Renaissance's revival of classical themes.</data>
      <data key="d3">chunk-23659b0349306744ecfc24e78e40bee3</data>
      <data key="d4">dumps/World_History_Volume_1/pages_content.json</data>
      <data key="d5">1783211028</data>
    </node>
    <node id="Humanism">
      <data key="d0">Humanism</data>
      <data key="d1">historical_concept_or_event</data>
      <data key="d2">Humanism was a philosophical movement of the Renaissance that emphasized the study of human beings, their nature, and achievements over traditional theological subjects. It focused on the inherent value and dignity of humanity rather than its sinful state.</data>
      <data key="d3">chunk-23659b0349306744ecfc24e78e40bee3</data>
      <data key="d4">dumps/World_History_Volume_1/pages_content.json</data>
      <data key="d5">1783211028</data>
    </node>
    <node id="Petrarch">
      <data key="d0">Petrarch</data>
      <data key="d1">historical_figure</data>
      <data key="d2">Petrarch was an Italian scholar and poet who is credited with initiating the movement of Renaissance humanism and is often called the 'father of humanism' due to his significant contributions.</data>
      <data key="d3">chunk-23659b0349306744ecfc24e78e40bee3</data>
      <data key="d4">dumps/World_History_Volume_1/pages_content.json</data>
      <data key="d5">1783211028</data>
    </node>
    <node id="The Arnolfini Portrait (1434)">
      <data key="d0">The Arnolfini Portrait (1434)</data>
      <data key="d1">artifact</data>
      <data key="d2">This artifact, a painting by Jan van Eyck from 1434, depicts the Italian merchant Giovanni Arnolfini and his wife. It is an example of Renaissance art's focus on individuals and their wealth, reflecting social changes during the period.</data>
      <data key="d3">chunk-23659b0349306744ecfc24e78e40bee3</data>
      <data key="d4">dumps/World_History_Volume_1/pages_content.json</data>
      <data key="d5">1783211028</data>
    </node>
    <node id="Giovanni Arnolfini (and his wife)">
      <data key="d0">Giovanni Arnolfini (and his wife)</data>
      <data key="d1">historical_figure</data>
      <data key="d2">Giovanni Arnolfini was an Italian merchant whose portrait in The Arnolfini Portrait by Jan van Eyck is a significant example of the representation of wealthy merchants in Renaissance art.</data>
      <data key="d3">chunk-23659b0349306744ecfc24e78e40bee3</data>
      <data key="d4">dumps/World_History_Volume_1/pages_content.json</data>
      <data key="d5">1783211028</data>
    </node>
    <node id="Jan van Eyck">
      <data key="d0">Jan van Eyck</data>
      <data key="d1">historical_figure</data>
      <data key="d2">Jan van Eyck was a Flemish painter known for his detailed and realistic artistic style, particularly evident in his 1434 painting, "The Arnolfini Portrait." This work not only highlights his skill in portraying individuals but also captures their wealth, making van Eyck an important figure of the Early Renaissance period.</data>
      <data key="d3">chunk-23659b0349306744ecfc24e78e40bee3&lt;SEP&gt;chunk-39f50645a1a52a72b5d8d61856942487</data>
      <data key="d4">dumps/World_History_Volume_1/pages_content.json</data>
      <data key="d5">1783211034</data>
    </node>
    <node id="Italian Merchant Class (early Renaissance)">
      <data key="d0">Italian Merchant Class (early Renaissance)</data>
      <data key="d1">social_group</data>
      <data key="d2">The wealthy members of the Italian merchant class were often depicted in Renaissance paintings, such as The Arnolfini Portrait by Jan van Eyck. These portrayals reflect the growing influence of humanism on art and society.</data>
      <data key="d3">chunk-23659b0349306744ecfc24e78e40bee3</data>
      <data key="d4">dumps/World_History_Volume_1/pages_content.json</data>
      <data key="d5">1783211029</data>
    </node>
    <node id="Giovanni Arnolfini">
      <data key="d0">Giovanni Arnolfini</data>
      <data key="d1">historical_figure</data>
      <data key="d2">Italian merchant and subject depicted in Jan van Eyck's painting, The Arnolfini Portrait, representing a wealthy member of the merchant class during the Renaissance era.</data>
      <data key="d3">chunk-23659b0349306744ecfc24e78e40bee3</data>
      <data key="d4">dumps/World_History_Volume_1/pages_content.json</data>
      <data key="d5">1783211029</data>
    </node>
    <node id="1434">
      <data key="d0">1434</data>
      <data key="d1">time_period</data>
      <data key="d2">The Arnolfini Portrait was painted in 1434, providing context to the time period of early Renaissance art.</data>
      <data key="d3">chunk-39f50645a1a52a72b5d8d61856942487</data>
      <data key="d4">dumps/World_History_Volume_1/pages_content.json</data>
      <data key="d5">1783211029</data>
    </node>
    <node id="Bruges">
      <data key="d0">Bruges</data>
      <data key="d1">geographical_location</data>
      <data key="d2">The painting depicts the merchant Giovanni di Nicolao di Arnolfini and his wife at their home in Bruges, Belgium, indicating the geographical location in Northern Europe.</data>
      <data key="d3">chunk-39f50645a1a52a72b5d8d61856942487</data>
      <data key="d4">dumps/World_History_Volume_1/pages_content.json</data>
      <data key="d5">1783211029</data>
    </node>
    <node id="The Arnolfini Portrait">
      <data key="d0">The Arnolfini Portrait</data>
      <data key="d1">source_or_artifact</data>
      <data key="d2">The Arnolfini Portrait is the subject of discussion and detail analysis in the provided text, a key artifact from early Northern European painting.</data>
      <data key="d3">chunk-39f50645a1a52a72b5d8d61856942487</data>
      <data key="d4">dumps/World_History_Volume_1/pages_content.json</data>
      <data key="d5">1783211029</data>
    </node>
    <node id="Giovanni di Nicolao di Arnolfini">
      <data key="d0">Giovanni di Nicolao di Arnolfini</data>
      <data key="d1">historical_figure</data>
      <data key="d2">Giovanni di Nicolao di Arnolfini was a wealthy merchant from Bruges painted in The Arnolfini Portrait. The painting offers insight into the lifestyle and social status of such merchants.</data>
      <data key="d3">chunk-39f50645a1a52a72b5d8d61856942487</data>
      <data key="d4">dumps/World_History_Volume_1/pages_content.json</data>
      <data key="d5">1783211029</data>
    </node>
    <node id="wealth indicators">
      <data key="d0">wealth indicators</data>
      <data key="d1">historical_concept_or_event</data>
      <data key="d2">Wealth indicators refer to objects or features in art that demonstrate the socio-economic status of individuals, such as the rich fabrics, chandeliers, and other luxurious elements depicted in The Arnolfini Portrait.</data>
      <data key="d3">chunk-39f50645a1a52a72b5d8d61856942487</data>
      <data key="d4">dumps/World_History_Volume_1/pages_content.json</data>
      <data key="d5">1783211029</data>
    </node>
    <node id="The Ghent Altarpiece">
      <data key="d0">The Ghent Altarpiece</data>
      <data key="d1">source_or_artifact</data>
      <data key="d2">A masterpiece by Jan Van Eyck, The Ghent Altarpiece is another famous work that showcases his realistic and intricate style, contributing to the reputation of Flemish art during the Early Renaissance.</data>
      <data key="d3">chunk-39f50645a1a52a72b5d8d61856942487</data>
      <data key="d4">dumps/World_History_Volume_1/pages_content.json</data>
      <data key="d5">1783211029</data>
    </node>
    <node id="Marsilio Ficino">
      <data key="d0">Marsilio Ficino</data>
      <data key="d1">historical_figure</data>
      <data key="d2">Marsilio Ficino was an Italian philosopher and translator active during the Renaissance. His work influenced humanist values, which are reflected in art like The Arnolfini Portrait.</data>
      <data key="d3">chunk-39f50645a1a52a72b5d8d61856942487</data>
      <data key="d4">dumps/World_History_Volume_1/pages_content.json</data>
      <data key="d5">1783211029</data>
    </node>
    <node id="Byzantine scholars">
      <data key="d0">Byzantine scholars</data>
      <data key="d1">historical_figure</data>
      <data key="d2">The Arnolfini Portrait reflects the intellectual exchanges between Byzantine scholars and Italian humanists, which influenced artistic practices during the Renaissance.</data>
      <data key="d3">chunk-39f50645a1a52a72b5d8d61856942487</data>
      <data key="d4">dumps/World_History_Volume_1/pages_content.json</data>
      <data key="d5">1783211029</data>
    </node>
    <node id="medieval architecture">
      <data key="d0">medieval architecture</data>
      <data key="d1">historical_concept_or_event</data>
      <data key="d2">Medieval architecture provided the architectural background for many Renaissance artworks, including the depiction of houses and interiors in paintings such as The Arnolfini Portrait.</data>
      <data key="d3">chunk-39f50645a1a52a72b5d8d61856942487</data>
      <data key="d4">dumps/World_History_Volume_1/pages_content.json</data>
      <data key="d5">1783211029</data>
    </node>
    <node id="16th and 17th centuries">
      <data key="d0">16th and 17th centuries</data>
      <data key="d1">time_period</data>
      <data key="d2">The period during which the Scientific Revolution took place.</data>
      <data key="d3">chunk-6472411bb2f04035fe16270eda293c74</data>
      <data key="d4">dumps/World_History_Volume_1/pages_content.json</data>
      <data key="d5">1783211029</data>
    </node>
    <node id="Italian Renaissance">
      <data key="d0">Italian Renaissance</data>
      <data key="d1">historical_concept_or_event</data>
      <data key="d2">A cultural movement in Italy from the 14th to the 17th century that was characterized by rebirth of classical learning and wisdom.</data>
      <data key="d3">chunk-6472411bb2f04035fe16270eda293c74</data>
      <data key="d4">dumps/World_History_Volume_1/pages_content.json</data>
      <data key="d5">1783211029</data>
    </node>
    <node id="Scientific Revolution">
      <data key="d0">Scientific Revolution</data>
      <data key="d1">historical_concept_or_event</data>
      <data key="d2">A period marked by rapid scientific advancements and the development of modern scientific methods, primarily occurring in Europe during the 16th and 17th centuries.</data>
      <data key="d3">chunk-6472411bb2f04035fe16270eda293c74</data>
      <data key="d4">dumps/World_History_Volume_1/pages_content.json</data>
      <data key="d5">1783211029</data>
    </node>
    <node id="Nicholas Cusanus">
      <data key="d0">Nicholas Cusanus</data>
      <data key="d1">historical_figure</data>
      <data key="d2">An Italian Neoplatonist philosopher who had a significant impact on the Scientific Revolution.</data>
      <data key="d3">chunk-6472411bb2f04035fe16270eda293c74</data>
      <data key="d4">dumps/World_History_Volume_1/pages_content.json</data>
      <data key="d5">1783211029</data>
    </node>
    <node id="Empiricism">
      <data key="d0">Empiricism</data>
      <data key="d1">historical_concept_or_event</data>
      <data key="d2">The philosophical theory that sensory experience is the source of all knowledge and the proper basis for its validation, as advocated by Aristotle.</data>
      <data key="d3">chunk-6472411bb2f04035fe16270eda293c74</data>
      <data key="d4">dumps/World_History_Volume_1/pages_content.json</data>
      <data key="d5">1783211029</data>
    </node>
    <node id="Astronomy">
      <data key="d0">Astronomy</data>
      <data key="d1">cultural_or_religious_movement</data>
      <data key="d2">The study of celestial objects and phenomena involving Nicholas Kepler, a German astronomer known for his mathematical discoveries.</data>
      <data key="d3">chunk-6472411bb2f04035fe16270eda293c74</data>
      <data key="d4">dumps/World_History_Volume_1/pages_content.json</data>
      <data key="d5">1783211029</data>
    </node>
    <node id="Nicolaus Copernicus">
      <data key="d0">Nicolaus Copernicus</data>
      <data key="d1">historical_figure</data>
      <data key="d2">A Renaissance mathematician who proposed the heliocentric model of the Solar System in 1543.</data>
      <data key="d3">chunk-6472411bb2f04035fe16270eda293c74</data>
      <data key="d4">dumps/World_History_Volume_1/pages_content.json</data>
      <data key="d5">1783211029</data>
    </node>
    <node id="Galileo Galilei">
      <data key="d0">Galileo Galilei</data>
      <data key="d1">historical_figure</data>
      <data key="d2">An Italian astronomer and physicist, associated with the Scientific Revolution and known for his improvements in telescope design and astronomical observations.</data>
      <data key="d3">chunk-6472411bb2f04035fe16270eda293c74</data>
      <data key="d4">dumps/World_History_Volume_1/pages_content.json</data>
      <data key="d5">1783211029</data>
    </node>
    <node id="Heliocentric Universe">
      <data key="d0">Heliocentric Universe</data>
      <data key="d1">textbook_structure</data>
      <data key="d2">The model of the Solar System where the Sun is at the center, as proposed by Copernicus and supported by Galileo through mathematical discoveries.</data>
      <data key="d3">chunk-6472411bb2f04035fe16270eda293c74</data>
      <data key="d4">dumps/World_History_Volume_1/pages_content.json</data>
      <data key="d5">1783211029</data>
    </node>
    <node id="Ptolemaic Model">
      <data key="d0">Ptolemaic Model</data>
      <data key="d1">historical_concept_or_event</data>
      <data key="d2">The geocentric or Earth-centered model of the universe that was dominant before the acceptance of the heliocentric model during the Scientific Revolution.</data>
      <data key="d3">chunk-6472411bb2f04035fe16270eda293c74</data>
      <data key="d4">dumps/World_History_Volume_1/pages_content.json</data>
      <data key="d5">1783211029</data>
    </node>
    <node id="Neoplatonists">
      <data key="d0">Neoplatonists</data>
      <data key="d1">civilization_or_empire</data>
      <data key="d2">Neoplatonists had a complex relationship with Aristotle's philosophies, integrating some of his concepts while rejecting others such as empiricism.</data>
      <data key="d3">chunk-bf5cfe6916b81abc088c0896d934f008</data>
      <data key="d4">dumps/World_History_Volume_1/pages_content.json</data>
      <data key="d5">1783211029</data>
    </node>
    <node id="Aristotles empiricism">
      <data key="d0">Aristotles empiricism</data>
      <data key="d1">historical_concept_or_event</data>
      <data key="d2">Aristotle’s focus on empirical evidence and observation was significant but not fully embraced by Neoplatonists.</data>
      <data key="d3">chunk-bf5cfe6916b81abc088c0896d934f008</data>
      <data key="d4">dumps/World_History_Volume_1/pages_content.json</data>
      <data key="d5">1783211029</data>
    </node>
    <node id="Human excellence">
      <data key="d0">Human excellence</data>
      <data key="d1">concept</data>
      <data key="d2">The concept of 'virtue' in Aristotle's philosophy contributed to the humanist idea of human excellence.</data>
      <data key="d3">chunk-bf5cfe6916b81abc088c0896d934f008</data>
      <data key="d4">dumps/World_History_Volume_1/pages_content.json</data>
      <data key="d5">1783211030</data>
    </node>
    <node id="Scientific fields other than astronomy">
      <data key="d0">Scientific fields other than astronomy</data>
      <data key="d1">field_of_study</data>
      <data key="d2">Aristotle’s emphasis on knowledge through observation influenced scientific disciplines beyond astronomy.</data>
      <data key="d3">chunk-bf5cfe6916b81abc088c0896d934f008</data>
      <data key="d4">dumps/World_History_Volume_1/pages_content.json</data>
      <data key="d5">1783211030</data>
    </node>
    <node id="Linear perspective technique">
      <data key="d0">Linear perspective technique</data>
      <data key="d1">technique</data>
      <data key="d2">The linear perspective technique was rediscovered by Filippo Brunelleschi and then used by Masaccio in paintings to create realism.</data>
      <data key="d3">chunk-bf5cfe6916b81abc088c0896d934f008</data>
      <data key="d4">dumps/World_History_Volume_1/pages_content.json</data>
      <data key="d5">1783211030</data>
    </node>
