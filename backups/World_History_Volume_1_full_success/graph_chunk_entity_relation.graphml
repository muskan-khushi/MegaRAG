      <data key="d4">dumps/World_History_Volume_1/pages_content.json</data>
      <data key="d5">1783210801</data>
    </node>
    <node id="&lt;Saltwater marine life&gt;">
      <data key="d0">&lt;Saltwater marine life&gt;</data>
      <data key="d1">cultural_or_religious_movement</data>
      <data key="d2">Exploitation of saltwater marine life also indicates adaptation and diversification in paleolithic practices.</data>
