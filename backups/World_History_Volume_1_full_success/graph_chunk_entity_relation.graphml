    <node id="Beringia">
      <data key="d0">Beringia</data>
      <data key="d1">geographical_location</data>
      <data key="d2">Beringia is an ancient land bridge between modern Alaska and Russia that once connected Asia and North America, allowing humans to cross during the last ice age.</data>
      <data key="d3">chunk-97ab4cac183886ee18d87b065b2e0ad5</data>
