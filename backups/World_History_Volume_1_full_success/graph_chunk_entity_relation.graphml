    <node id="Edict of Milan">
      <data key="d0">Edict of Milan</data>
      <data key="d1">historical_concept_or_event</data>
      <data key="d2">The Edict of Milan is an edict issued by Emperor Constantine in 313 AD that legalized Christianity within the Roman Empire, granting religious freedom and protection to Christians.</data>
