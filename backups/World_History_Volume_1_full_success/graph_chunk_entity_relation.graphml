    <edge source="Second Crusade" target="Knights Templar">
      <data key="d6">6.0</data>
      <data key="d7">The Knights Templar were part of the Christian forces in the Second Crusade but faced significant defeats, reflecting the overall failure of this campaign to gain ground against Muslims.</data>
      <data key="d8">defeat,participation"</data>
      <data key="d9">chunk-b150c3e9d15dec1eaca94b8168bda0ba</data>
      <data key="d10">dumps/World_History_Volume_1/pages_content.json</data>
      <data key="d11">1783211090</data>
    </edge>
    <edge source="Knights Templar" target="Bernard of Clairvaux">
      <data key="d6">8.0</data>
      <data key="d7">Bernard of Clairvaux played a key role in founding the Knights Templar and was instrumental in inspiring the Second Crusade.</data>
      <data key="d8">founding,inspiration"</data>
      <data key="d9">chunk-b150c3e9d15dec1eaca94b8168bda0ba</data>
      <data key="d10">dumps/World_History_Volume_1/pages_content.json</data>
      <data key="d11">1783211090</data>
    </edge>
    <edge source="Richard the Lionhearted" target="&quot;King Louis VII'">
      <data key="d6">6.0</data>
