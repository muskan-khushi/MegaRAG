    <node id="&lt;&quot;Corcyra&quot;">
      <data key="d0">&lt;"Corcyra"</data>
      <data key="d1">&lt;geographical_location</data>
      <data key="d2">&lt;"A Greek island strategically important to both Athens and Corinth, caught in their political conflicts."</data>
      <data key="d3">chunk-2950474ba33f47bb39e303f028b2774e</data>
