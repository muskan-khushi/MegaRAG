    <node id="Roman Empire Moves East">
      <data key="d0">Roman Empire Moves East</data>
      <data key="d1">historical_event</data>
      <data key="d2">The eastward shift of the Roman Empire’s geographic focus with Constantinople becoming its new capital.</data>
      <data key="d3">chunk-1ca8bf4d9560cf713649b9941df5971f</data>
      <data key="d4">dumps/World_History_Volume_1/pages_content.json</data>
      <data key="d5">1783210946</data>
    </node>
    <node id="Constantine (Emperor)">
      <data key="d0">Constantine (Emperor)</data>
      <data key="d1">historical_figure</data>
      <data key="d2">The emperor who founded Constantinople and renamed it, dedicating it in 330 CE.</data>
      <data key="d3">chunk-1ca8bf4d9560cf713649b9941df5971f</data>
      <data key="d4">dumps/World_History_Volume_1/pages_content.json</data>
      <data key="d5">1783210946</data>
    </node>
    <node id="New Rome">
      <data key="d0">New Rome</data>
      <data key="d1">cultural_or_religious_movement</data>
      <data key="d2">The concept of Constantinople as the new center of Roman culture and power, replacing Rome symbolically.</data>
      <data key="d3">chunk-1ca8bf4d9560cf713649b9941df5971f</data>
      <data key="d4">dumps/World_History_Volume_1/pages_content.json</data>
      <data key="d5">1783210946</data>
    </node>
    <node id="Serpent Column">
      <data key="d0">Serpent Column</data>
      <data key="d1">source_or_artifact</data>
      <data key="d2">A piece of art from Delphi brought to decorate Constantinople by Emperor Constantine.</data>
      <data key="d3">chunk-1ca8bf4d9560cf713649b9941df5971f</data>
      <data key="d4">dumps/World_History_Volume_1/pages_content.json</data>
