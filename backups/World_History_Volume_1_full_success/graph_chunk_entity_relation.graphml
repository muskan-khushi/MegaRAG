    <node id="Zeus of Otricoli">
      <data key="d0">Zeus of Otricoli</data>
      <data key="d1">source_or_artifact</data>
      <data key="d2">Zeus of Otricoli is a marble bust believed to be a Roman copy of a fourth-century BCE Greek original, found in Otricoli, Italy, in 1775.</data>
      <data key="d3">chunk-7e152daf4ec320b12f5eed36d7fbef7a</data>
      <data key="d4">dumps/World_History_Volume_1/pages_content.json</data>
