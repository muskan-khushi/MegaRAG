    <node id="Kublai Khans Rule">
      <data key="d0">Kublai Khans Rule</data>
      <data key="d1">time_period</data>
      <data key="d2">Kublai Khan's rule refers to the period when he attempted to unify and control the Mongol Empire after taking power in China.</data>
      <data key="d3">chunk-050e5acc95e8e8a8dba391a9f249062f</data>
      <data key="d4">dumps/World_History_Volume_1/pages_content.json</data>
