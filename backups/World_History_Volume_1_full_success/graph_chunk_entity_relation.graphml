      <data key="d0">&lt;"Tribute money payments"</data>
      <data key="d1">&lt;conceptual_element</data>
      <data key="d2">&lt;"Financial contributions from member states of the Delian League to support Athens, which later became a source of contention with other city-states."</data>
      <data key="d3">chunk-2950474ba33f47bb39e303f028b2774e</data>
