    </node>
    <node id="&lt;Clothing&gt;">
      <data key="d0">&lt;Clothing&gt;</data>
      <data key="d1">cultural_or_religious_movement</data>
      <data key="d2">Cultures adapted clothing to protect against the elements, essential in the Paleolithic Age for survival.</data>
