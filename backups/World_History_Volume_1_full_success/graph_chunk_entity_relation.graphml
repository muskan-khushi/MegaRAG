    <node id="Machu Picchu">
      <data key="d0">Machu Picchu</data>
      <data key="d1">geographical_location</data>
      <data key="d2">"Machu Picchu is a historical site located between two peaks in the Andes Mountains and is significant for its role in the Inca civilization."&lt;|</data>
