      <data key="d0">&lt;"Umayyads/</data>
      <data key="d1">&lt;"civilization_or_empire</data>
      <data key="d2">&lt;"A ruling dynasty that controlled much of the Islamic world in the early Middle Ages, known for their grand architectural projects like the Dome of the Rock. They played a crucial role during the late 7th century."</data>
      <data key="d3">chunk-acb0a07de6465f61f482a035df463ed8</data>
