      <data key="d1">historical_figure</data>
      <data key="d2">Non-Arab converts to Islam who were subject to special legal and social statuses within early Islamic society.</data>
      <data key="d3">chunk-1446ed4b941391bd4aa671377ea66c91</data>
      <data key="d4">dumps/World_History_Volume_1/pages_content.json</data>
      <data key="d5">1783210967</data>
    </node>
    <node id="Ridda Wars">
      <data key="d0">Ridda Wars</data>
      <data key="d1">historical_concept_or_event</data>
      <data key="d2">Religious conflicts in the early Muslim community, primarily between those who accepted Muhammad's prophethood (Muslims) and those who rejected it (non-believers), leading to civil unrest within Arabia.</data>
      <data key="d3">chunk-1446ed4b941391bd4aa671377ea66c91</data>
