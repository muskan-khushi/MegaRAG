    <node id="Christopher Columbus">
      <data key="d0">Christopher Columbus</data>
      <data key="d1">historical_figure</data>
      <data key="d2">Italian explorer who led voyages across the Atlantic Ocean, initiating the period of European discovery of the Americas.</data>
      <data key="d3">chunk-37806dbd0da9f5dfc4edb78615a5b7a5</data>
      <data key="d4">dumps/World_History_Volume_1/pages_content.json</data>
      <data key="d5">1783211003</data>
    </node>
    <node id="&lt;&quot;Ghana Empire&quot;">
      <data key="d0">&lt;"Ghana Empire"</data>
      <data key="d1">&lt;civilization_or_religious_movement</data>
      <data key="d2">The Ghana Empire was a powerful West African kingdom that reached its pinnacle in the early 11th century CE and is known for its wealth, particularly through trade in salt and gold. Key to its power were the Soninke people who unified various groups into a loose federation under the leadership of Diabe Cisse. The empire played a crucial role as a trading hub along the Trans-Saharan trade routes, contributing significantly to the spread of Islam and cultural blending while maintaining robust internal governance structures. It controlled vast gold fields and significant trade routes, making it an influential player in the regional and international economy during its peak period.</data>
      <data key="d3">chunk-2fe04789d432c77f53257607a3693395&lt;SEP&gt;chunk-69012398e94fc567ca6593314057bcf0</data>
      <data key="d4">dumps/World_History_Volume_1/pages_content.json</data>
      <data key="d5">1783211008</data>
    </node>
    <node id="&lt;&quot;11th century CE&quot;">
      <data key="d0">&lt;"11th century CE"</data>
      <data key="d1">&lt;time_period</data>
      <data key="d2">&lt;"The 11th century CE marked the zenith of Ghana's power and influence, around which many significant events occurred, such as Diabe Cisse's unification efforts and Ghana's military expansion."&gt;|</data>
      <data key="d3">chunk-2fe04789d432c77f53257607a3693395</data>
      <data key="d4">dumps/World_History_Volume_1/pages_content.json</data>
      <data key="d5">1783211003</data>
    </node>
    <node id="&lt;&quot;Soninke speakers&quot;">
      <data key="d0">&lt;"Soninke speakers"</data>
      <data key="d1">&lt;cultural_or_religious_movement</data>
      <data key="d2">&lt;"The Soninke were a West African ethnic group whose language was spoken in the region of modern-day Mali, where they formed part of the larger Ghana Empire. They played a key role under Diabe Cisse's unification efforts and contributed significantly to the empire's military and economic might."&gt;|</data>
      <data key="d3">chunk-2fe04789d432c77f53257607a3693395</data>
      <data key="d4">dumps/World_History_Volume_1/pages_content.json</data>
      <data key="d5">1783211003</data>
    </node>
    <node id="&lt;&quot;Wagadu&quot;">
      <data key="d0">&lt;"Wagadu"</data>
      <data key="d1">&lt;civilization_or_religious_movement</data>
      <data key="d2">&lt;"Wagadu was an ancient kingdom that predates the official Ghana Empire, but it is often considered associated with parts of what later became the Ghana Empire due to its geographical and cultural proximity."&gt;|</data>
      <data key="d3">chunk-2fe04789d432c77f53257607a3693395</data>
      <data key="d4">dumps/World_History_Volume_1/pages_content.json</data>
      <data key="d5">1783211003</data>
    </node>
    <node id="&lt;&quot;Diabe Cisse&quot;">
      <data key="d0">&lt;"Diabe Cisse"</data>
      <data key="d1">&lt;historical_figure</data>
      <data key="d2">&lt;"Diabe Cisse was a significant historical figure who unified the Soninke people in the early 11th century CE, underpinning the military and economic expansion of the Ghana Empire through their cavalry leadership."&gt;|</data>
      <data key="d3">chunk-2fe04789d432c77f53257607a3693395</data>
      <data key="d4">dumps/World_History_Volume_1/pages_content.json</data>
      <data key="d5">1783211003</data>
    </node>
    <node id="&lt;&quot;Dinga (nomadic mystic)&quot;">
      <data key="d0">&lt;"Dinga (nomadic mystic)"</data>
      <data key="d1">&lt;historical_figure</data>
      <data key="d2">&lt;"Dinga was a nomadic mystic who played an ideological role in the region possibly associated with founding or influencing certain key figures, such as Diabe Cisse, though exact historical roles are often contested."&gt;|</data>
      <data key="d3">chunk-2fe04789d432c77f53257607a3693395</data>
      <data key="d4">dumps/World_History_Volume_1/pages_content.json</data>
      <data key="d5">1783211003</data>
    </node>
    <node id="&lt;&quot;Female water genie&quot;">
      <data key="d0">&lt;"Female water genie"</data>
      <data key="d1">&lt;mythological_entity</data>
      <data key="d2">&lt;"The Female Water Genie was a mythical figure potentially important to the cultural beliefs and practices of the Soninke people during the Ghana Empire period, possibly symbolizing natural forces or goddesses related to water sources crucial for life."&gt;|</data>
      <data key="d3">chunk-2fe04789d432c77f53257607a3693395</data>
      <data key="d4">dumps/World_History_Volume_1/pages_content.json</data>
      <data key="d5">1783211003</data>
    </node>
    <node id="&lt;&quot;Sanhaja people&quot;">
      <data key="d0">&lt;"Sanhaja people"</data>
      <data key="d1">&lt;cultural_or_religious_movement</data>
      <data key="d2">&lt;"The Sanhaja were nomadic tribes that occasionally engaged in conflict with the settled Soninke society associated with the Ghana Empire, representing a force of raiding and disruption against the agricultural centers."&gt;|</data>
      <data key="d3">chunk-2fe04789d432c77f53257607a3693395</data>
      <data key="d4">dumps/World_History_Volume_1/pages_content.json</data>
      <data key="d5">1783211003</data>
    </node>
    <node id="&lt;&quot;Sahel region&quot;">
      <data key="d0">&lt;"Sahel region"</data>
      <data key="d1">&lt;geographical_location</data>
      <data key="d2">&lt;"The Sahel region is an ecosystem and geographical area bordering the Sahara Desert to the north and savanna regions further south in West Africa. It was central for trade routes involving both salt and gold, which were key resources for Ghana's wealth."&gt;|</data>
      <data key="d3">chunk-2fe04789d432c77f53257607a3693395</data>
      <data key="d4">dumps/World_History_Volume_1/pages_content.json</data>
      <data key="d5">1783211004</data>
    </node>
    <node id="&lt;&quot;Nomadic raids&quot;">
      <data key="d0">&lt;"Nomadic raids"</data>
      <data key="d1">&lt;historical_concept_or_event</data>
      <data key="d2">&lt;"Nomadic Raiders from tribes such as the Sanhaja posed a significant threat to settled societies like those of Soninke and the Ghana Empire, often disrupting their economies through forceful theft or other violent means."&gt;|</data>
      <data key="d3">chunk-2fe04789d432c77f53257607a3693395</data>
      <data key="d4">dumps/World_History_Volume_1/pages_content.json</data>
      <data key="d5">1783211004</data>
    </node>
    <node id="&lt;&quot;Soninke cavalry commanders&quot;">
      <data key="d0">&lt;"Soninke cavalry commanders"</data>
      <data key="d1">&lt;historical_figure_type</data>
      <data key="d2">&lt;"These were military leaders within the army of Diabe Cisse's united Soninke groups who played a crucial role in defending the Ghana Empire from external threats and expanding its territories through military campaigns."&gt;|</data>
      <data key="d3">chunk-2fe04789d432c77f53257607a3693395</data>
      <data key="d4">dumps/World_History_Volume_1/pages_content.json</data>
      <data key="d5">1783211004</data>
    </node>
    <node id="&lt;&quot;Central provinces of Ghana Empire&quot;">
      <data key="d0">&lt;"Central provinces of Ghana Empire"</data>
      <data key="d1">&lt;geopolitical_structure</data>
      <data key="d2">&lt;"The central provinces were established by Diabe Cisse as part of his unification efforts to create more organized governance within the empire, involving strategic locations for control and administration."&gt;|</data>
      <data key="d3">chunk-2fe04789d432c77f53257607a3693395</data>
      <data key="d4">dumps/World_History_Volume_1/pages_content.json</data>
      <data key="d5">1783211004</data>
    </node>
    <node id="&lt;&quot;Conquered vassal chiefdoms and kingdoms&quot;">
      <data key="d0">&lt;"Conquered vassal chiefdoms and kingdoms"</data>
      <data key="d1">&lt;geopolitical_structure</data>
      <data key="d2">&lt;"These territories were peripheral regions under the direct rule of the Ghana Empire's core political system, providing resources and support for central governance in return for protection against external threats."&gt;|</data>
      <data key="d3">chunk-2fe04789d432c77f53257607a3693395</data>
      <data key="d4">dumps/World_History_Volume_1/pages_content.json</data>
      <data key="d5">1783211004</data>
    </node>
    <node id="&lt;&quot;Trans-Saharan trade&quot;">
      <data key="d0">&lt;"Trans-Saharan trade"</data>
      <data key="d1">&lt;economic_system</data>
      <data key="d2">&lt;"A vital economic network connecting North Africa with Sub-Saharan Africa via camel caravans, critical to the wealth and influence of Ghana during its peak."&gt;|</data>
      <data key="d3">chunk-2fe04789d432c77f53257607a3693395</data>
      <data key="d4">dumps/World_History_Volume_1/pages_content.json</data>
      <data key="d5">1783211004</data>
    </node>
    <node id="&lt;&quot;Salt&quot;">
      <data key="d0">&lt;"Salt"</data>
      <data key="d1">&lt;resource</data>
      <data key="d2">&lt;"A precious commodity highly valued by both local and trans-regional economies, salt from mines in the Ghana region was a major product traded along the Trans-Saharan routes."&gt;|</data>
      <data key="d3">chunk-2fe04789d432c77f53257607a3693395</data>
      <data key="d4">dumps/World_History_Volume_1/pages_content.json</data>
      <data key="d5">1783211004</data>
    </node>
    <node id="&lt;&quot;Gold&quot;">
      <data key="d0">&lt;"Gold"</data>
      <data key="d1">&lt;resource</data>
      <data key="d2">&lt;"Gold was another valuable resource traded extensively, often serving as part of royal wealth or tribute paid to the empire, contributing significantly to its prosperity and international standing."&gt;|</data>
      <data key="d3">chunk-2fe04789d432c77f53257607a3693395</data>
      <data key="d4">dumps/World_History_Volume_1/pages_content.json</data>
