    <node id="Calculated Frightfulness">
      <data key="d0">Calculated Frightfulness</data>
      <data key="d1">concept</data>
      <data key="d2">A tactic used by Neo-Assyrians to demonstrate the harsh consequences of resistance, including various forms of torture on conquered peoples.</data>
