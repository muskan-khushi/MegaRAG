    <node id="&lt;United Nations&gt;">
      <data key="d0">&lt;United Nations&gt;</data>
      <data key="d1">&lt;cultural_or_religious_movement&gt;</data>
      <data key="d2">&lt;The United Nations is an intergovernmental organization founded in 1945 with the aim of promoting international cooperation and peace, reflecting a broader trend towards global organization and governance that can be traced back to Chinggis Khan’s empire.&gt;</data>
      <data key="d3">chunk-4e57e6349a7929fcf289f8da82a3abde</data>
      <data key="d4">dumps/World_History_Volume_1/pages_content.json</data>
