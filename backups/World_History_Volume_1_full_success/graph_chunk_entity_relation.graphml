    </edge>
    <edge source="Quebrada Jaguay" target="Obsidian">
      <data key="d6">8.0</data>
      <data key="d7">Obsidian found at Quebrada Jaguay indicates trade or long-distance exchange networks existing in prehistoric coastal communities of South America.</data>
      <data key="d8">trade_networks</data>
      <data key="d9">chunk-b57294b6404d0e2e6323ef615e064cfc</data>
      <data key="d10">dumps/World_History_Volume_1/pages_content.json</data>
