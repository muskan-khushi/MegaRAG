    <node id="&lt;international commerce&gt;">
      <data key="d0">&lt;international commerce&gt;</data>
      <data key="d1">&lt;historical_concept_or_event&gt;</data>
      <data key="d2">&lt;International commerce refers to trade and exchange between different nations or regions, an idea first advanced in the time of Chinggis Khan and continued by organizations like the WTO.&gt;</data>
      <data key="d3">chunk-4e57e6349a7929fcf289f8da82a3abde</data>
      <data key="d4">dumps/World_History_Volume_1/pages_content.json</data>
      <data key="d5">1783210993</data>
    </node>
    <node id="&lt;trade networks of the past&gt;">
      <data key="d0">&lt;trade networks of the past&gt;</data>
      <data key="d1">&lt;historical_concept_or_event&gt;</data>
      <data key="d2">&lt;Trade networks established during Chinggis Khan's era laid down foundational structures that the WTO later formalized into a global system.&gt;</data>
      <data key="d3">chunk-4e57e6349a7929fcf289f8da82a3abde</data>
      <data key="d4">dumps/World_History_Volume_1/pages_content.json</data>
