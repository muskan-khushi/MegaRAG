    <node id="&lt;Çatalhöüküyuk&gt;">
      <data key="d0">&lt;Çatalhöüküyuk&gt;</data>
      <data key="d1">&lt;source_or_artifact&gt;</data>
      <data key="d2">&lt;"The source or artifact entities in Çatalhöyük include mud brick for construction, cattle imagery as religious symbols, obsidian for tool-making and trade, agricultural products like crops, and pottery."&gt;</data>
      <data key="d3">chunk-dbfe0b8551a1c1ccdee815dd5bff6442</data>
      <data key="d4">dumps/World_History_Volume_1/pages_content.json</data>
