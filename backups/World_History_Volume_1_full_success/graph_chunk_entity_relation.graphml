    </edge>
    <edge source="Guitarrero Cave" target="Projectile Points">
      <data key="d6">8.0</data>
      <data key="d7">Projectile points found at Guitarrero Cave provide evidence of hunting activities by prehistoric groups occupying the site from around 8000 BCE onward.</data>
      <data key="d8">artifact_hunting</data>
      <data key="d9">chunk-b57294b6404d0e2e6323ef615e064cfc</data>
      <data key="d10">dumps/World_History_Volume_1/pages_content.json</data>
