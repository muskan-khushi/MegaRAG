    <node id="Periplus of the Erythraean Sea">
      <data key="d0">Periplus of the Erythraean Sea</data>
      <data key="d1">source_or_artifact</data>
      <data key="d2">The Periplus of the Erythraean Sea is a firsthand account of trade routes from Egypt to India, written around 70 CE and provides insights into regional cultures and goods.</data>
      <data key="d3">chunk-bceaa7979e3d60d1deb8d4848dbe01fa</data>
      <data key="d4">dumps/World_History_Volume_1/pages_content.json</data>
