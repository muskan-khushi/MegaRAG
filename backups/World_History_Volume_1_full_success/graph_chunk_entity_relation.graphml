    <node id="&lt;Steppe&gt;">
      <data key="d0">&lt;Steppe&gt;</data>
      <data key="d1">&lt;geographical_location&gt;</data>
      <data key="d2">&lt;The steppe region from which Chinggis Khan operated, providing a base for military campaigns and establishing warehouse complexes for war booty. The steppe was the core territory where Mongol operations were centered.</data>
      <data key="d3">chunk-c065aace43270eef7d2c60439e6d228b</data>
      <data key="d4">dumps/World_History_Volume_1/pages_content.json</data>
      <data key="d5">1783210993</data>
    </node>
    <node id="&lt;Caspian Sea&gt;">
      <data key="d0">&lt;Caspian Sea&gt;</data>
      <data key="d1">&lt;geographical_location&gt;</data>
      <data key="d2">&lt;The Caspian Sea is a large inland body of water and historically played a significant role as a trade route connecting Central Asia with Europe.&gt;</data>
      <data key="d3">chunk-4e57e6349a7929fcf289f8da82a3abde</data>
      <data key="d4">dumps/World_History_Volume_1/pages_content.json</data>
