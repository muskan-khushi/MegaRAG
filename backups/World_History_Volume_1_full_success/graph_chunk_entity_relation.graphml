    </node>
    <node id="&lt;Code of Hammurabi&gt;">
      <data key="d0">&lt;Code of Hammurabi&gt;</data>
      <data key="d1">source_or_artifact</data>
      <data key="d2">Law code from ancient Babylon, detailing legal codes and punishments for various offenses.</data>
      <data key="d3">chunk-bacddcb0411fbd18f80694e00c36c414</data>
