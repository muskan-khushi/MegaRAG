    </node>
    <node id="Spread Through Arabian Peninsula (Before Islam) ">
      <data key="d0">Spread Through Arabian Peninsula (Before Islam) </data>
      <data key="d1">time_period</data>
      <data key="d2">How monotheistic faiths spread through the Arabian Peninsula before the rise of Islam is discussed.</data>
      <data key="d3">chunk-8b0c39d289796b14f7f59c5c9f5dc056</data>
      <data key="d4">dumps/World_History_Volume_1/pages_content.json</data>
