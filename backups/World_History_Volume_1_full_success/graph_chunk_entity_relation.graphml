      <data key="d0">&lt;"Aisha bint Abu Bakr"</data>
      <data key="d1">&lt;"historical_figure</data>
      <data key="d2">&lt;Entity_description: The wife of Muhammad, known for her significant role in early Islamic debates about hadith transmission. She played a crucial part in discussions surrounding religious law and principles during the Rashidun and early Umayyad periods.</data>
      <data key="d3">chunk-eca248d7090f58e7e1c63a9bfb407080</data>
      <data key="d4">dumps/World_History_Volume_1/pages_content.json</data>
