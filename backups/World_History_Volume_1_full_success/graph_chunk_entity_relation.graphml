    <node id="&lt;&quot;Ali ibn Abi Talib&quot;">
      <data key="d0">&lt;"Ali ibn Abi Talib"</data>
      <data key="d1">&lt;"historical_figure</data>
      <data key="d2">&lt;Entity_description: The fourth caliph who led the Rashidun Caliphate during a period of significant conflict and civil war. Ali's leadership culminated with his own assassination and marked the beginning of Umayyad rule.</data>
      <data key="d3">chunk-eca248d7090f58e7e1c63a9bfb407080</data>
      <data key="d4">dumps/World_History_Volume_1/pages_content.json</data>
