    <node id="Battle of Granicus">
      <data key="d0">Battle of Granicus</data>
      <data key="d1">historical_event</data>
      <data key="d2">The Battle of Granicus in 334 BC was a significant engagement between Alexander's forces and the Persian Empire, which is described as turning point in Alexander’s campaign to conquer the Achaemenid Persian Empire.</data>
      <data key="d3">chunk-b0c96eda8ec75ff7b7bb50a03f72ca9a</data>
