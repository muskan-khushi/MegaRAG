      <data key="d0">Attack on Pearl Harbor Photographs</data>
      <data key="d1">source_or_artifact</data>
      <data key="d2">The images of Pearl Harbor under attack, taken from Japanese planes during the attack, which are part of Naval History and Heritage Command/Wikimedia Commons, Public Domain.</data>
      <data key="d3">chunk-6f7fc147e6b53d5322148aad649d8fde</data>
      <data key="d4">dumps/World_History_Volume_1/pages_content.json</data>
      <data key="d5">1783210791</data>
    </node>
    <node id="Speech to Congress">
      <data key="d0">Speech to Congress</data>
      <data key="d1">textbook_structure</data>
      <data key="d2">The formal address by President Roosevelt delivered in response to the Pearl Harbor Attack, explaining the events and requesting a declaration of war against Japan.</data>
      <data key="d3">chunk-6f7fc147e6b53d5322148aad649d8fde</data>
      <data key="d4">dumps/World_History_Volume_1/pages_content.json</data>
      <data key="d5">1783210791</data>
