      <data key="d0">&lt;8300 BCE&gt;</data>
      <data key="d1">&lt;time_period&gt;</data>
      <data key="d2">&lt;"The estimated earliest occupation date for Jericho, indicating a significant timeline within the Neolithic period before Çatalhöyük's rise as an advanced settlement."&gt;</data>
      <data key="d3">chunk-dbfe0b8551a1c1ccdee815dd5bff6442</data>
      <data key="d4">dumps/World_History_Volume_1/pages_content.json</data>
