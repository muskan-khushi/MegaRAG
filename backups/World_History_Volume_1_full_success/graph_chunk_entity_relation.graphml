      <data key="d0">Stone Relief from an Assyrian Palace</data>
      <data key="d1">source_or_artifact</data>
      <data key="d2">Comprehensive description of a stone relief from an Assyrian palace, depicting military battles and showcasing the artistic and architectural achievements of the Neo-Assyrian period.</data>
      <data key="d3">chunk-23d1e6b89ed34f781b195088854edaee</data>
      <data key="d4">dumps/World_History_Volume_1/pages_content.json</data>
      <data key="d5">1783210834</data>
    </node>
    <node id="Assyrian Arabian Battle">
      <data key="d0">Assyrian Arabian Battle</data>
      <data key="d1">source_or_artifact</data>
      <data key="d2">Specifically refers to a seventh-century BCE stone relief showing Ashurbanipal's army battling nomadic Arabian desert groups. Artistic representation of Assyrian military might during the Iron Age.</data>
      <data key="d3">chunk-23d1e6b89ed34f781b195088854edaee</data>
      <data key="d4">dumps/World_History_Volume_1/pages_content.json</data>
      <data key="d5">1783210834</data>
