      <data key="d0">Mandingo-speaking Mande people, Soumaoros raids survival</data>
      <data key="d1">historical_figure</data>
      <data key="d2">Refers to Prince Sundiata and his origins as a survivor of a raid.</data>
      <data key="d3">chunk-42e94d3dccf53e38234edf815e468339</data>
