      <data key="d1">cultural_or_religious_movement</data>
      <data key="d2">Monotheistic Traditions refers to shared beliefs among Judaism, Christianity, and Islam regarding worshiping one god.</data>
      <data key="d3">chunk-7114383587a4baf0af7064a88a7b0f99</data>
      <data key="d4">dumps/World_History_Volume_1/pages_content.json</data>
