      <data key="d0">&lt;"Delian League"</data>
      <data key="d1">&lt;source_or_artifact</data>
      <data key="d2">&lt;"A confederation of Greek city-states organized under Athenian leadership to resist future Persian threats, which eventually became a tool for Athens' imperial ambitions."</data>
      <data key="d3">chunk-2950474ba33f47bb39e303f028b2774e</data>
      <data key="d4">dumps/World_History_Volume_1/pages_content.json</data>
      <data key="d5">1783210880</data>
    </node>
