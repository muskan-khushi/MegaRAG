      <data key="d7">&lt;"target_entity"&gt;</data>
      <data key="d8">&lt;"historical_figure"&gt;</data>
      <data key="d9">chunk-05354118c56ecef0622f39f1588c78ac</data>
      <data key="d10">dumps/World_History_Volume_1/pages_content.json</data>
      <data key="d11">1783211098</data>
    </edge>
    <edge source="&lt;Little Ice Age&gt;" target="&lt;Northern Hemisphere Temperature Reconstruction by Moberg et al., 2005&gt;">
      <data key="d6">16.0</data>
      <data key="d7">The data from this reconstruction supports the existence of the Little Ice Age during the 16th century</data>
      <data key="d8">Temperature reconstruction,historical evidence</data>
      <data key="d9">chunk-7891c6c99c50753a0d022eafb7d7196a</data>
      <data key="d10">dumps/World_History_Volume_1/pages_content.json</data>
      <data key="d11">1783211098</data>
    </edge>
    <edge source="&lt;Little Ice Age&gt;" target="&lt;Medieval Warm Period&gt;">
      <data key="d6">14.0</data>
      <data key="d7">These two periods represent contrasting temperature patterns in the same geographical area over a similar time frame</data>
      <data key="d8">Climate variability,historical temperatures</data>
      <data key="d9">chunk-7891c6c99c50753a0d022eafb7d7196a</data>
      <data key="d10">dumps/World_History_Volume_1/pages_content.json</data>
      <data key="d11">1783211098</data>
    </edge>
    <edge source="&lt;Northern Hemisphere Temperature Reconstruction by Moberg et al., 2005&gt;" target="&lt;China and Northern Europe Cold Weather, Lake and River Freezing&gt;">
      <data key="d6">18.0</data>
      <data key="d7">The reconstructions show cold weather patterns consistent with the experiences of China and Northern Europe during the Little Ice Age</data>
      <data key="d8">Climate reconstruction,historical evidence</data>
      <data key="d9">chunk-7891c6c99c50753a0d022eafb7d7196a</data>
      <data key="d10">dumps/World_History_Volume_1/pages_content.json</data>
      <data key="d11">1783211098</data>
    </edge>
    <edge source="&lt;Medieval Warm Period&gt;" target="&lt;North American Interior Hot Summers with Less Rain and Colder Winters&gt;">
      <data key="d6">14.0</data>
      <data key="d7">Both periods experienced extreme temperature contrasts with different seasonal patterns, highlighting climate variability over time</data>
      <data key="d8">Temperature contrast,climate change</data>
      <data key="d9">chunk-7891c6c99c50753a0d022eafb7d7196a</data>
      <data key="d10">dumps/World_History_Volume_1/pages_content.json</data>
      <data key="d11">1783211098</data>
    </edge>
    <edge source="&lt;Global Temperature Decrease (0.6\(\degree\)C)&gt;" target="&lt;Mountain Glaciers Advance&gt;">
      <data key="d6">18.0</data>
      <data key="d7">The advance of mountain glaciers is evidence for a global decrease in temperature by 0.6 degrees Celsius during the Little Ice Age</data>
      <data key="d8">Glacier movement,temperature change</data>
      <data key="d9">chunk-7891c6c99c50753a0d022eafb7d7196a</data>
      <data key="d10">dumps/World_History_Volume_1/pages_content.json</data>
      <data key="d11">1783211098</data>
    </edge>
    <edge source="&lt;Mountain Glaciers Advance&gt;" target="&lt;Mediterranean and West Africa Droughts&gt;">
      <data key="d6">16.0</data>
      <data key="d7">Advancing glaciers suggest a cooler global climate that would have led to drought in these regions</data>
      <data key="d8">Glacier movement,climate change,drought</data>
      <data key="d9">chunk-7891c6c99c50753a0d022eafb7d7196a</data>
      <data key="d10">dumps/World_History_Volume_1/pages_content.json</data>
      <data key="d11">1783211098</data>
    </edge>
    <edge source="&lt;Catastrophic Crop Failures and Widespread Famine in Northern Hemisphere&gt;" target="&lt;Europe and Asia Extraordinary Rains and Poor Harvests (1314)&gt;">
      <data key="d6">16.0</data>
      <data key="d7">Both events are described as part of the broader effects of the Little Ice Age on agriculture</data>
      <data key="d8">Famine,climate impact,poor harvests</data>
      <data key="d9">chunk-7891c6c99c50753a0d022eafb7d7196a</data>
      <data key="d10">dumps/World_History_Volume_1/pages_content.json</data>
      <data key="d11">1783211098</data>
    </edge>
    <edge source="&lt;Catastrophic Crop Failures and Widespread Famine in Northern Hemisphere&gt;" target="&lt;Mediterranean and West Africa Droughts&gt;">
      <data key="d6">14.0</data>
      <data key="d7">Droughts in these regions contributed to the widespread famine described for the northern hemisphere during the Little Ice Age</data>
      <data key="d8">Drought,climate change,famine</data>
      <data key="d9">chunk-7891c6c99c50753a0d022eafb7d7196a</data>
      <data key="d10">dumps/World_History_Volume_1/pages_content.json</data>
      <data key="d11">1783211098</data>
    </edge>
    <edge source="Great Famine " target="St. Albans, England ">
      <data key="d6">6.0</data>
      <data key="d7">King Edward II visited St. Albans and faced shortages in bread supply due to the impact of the Great Famine on agricultural production.</data>
      <data key="d8">feast_shortages,great_famine_impact</data>
      <data key="d9">chunk-711e8b5f07c221ff8749b18f9665fc50</data>
      <data key="d10">dumps/World_History_Volume_1/pages_content.json</data>
      <data key="d11">1783211098</data>
    </edge>
    <edge source="&lt;black death&gt;" target="&lt;mongol rule period&gt;">
      <data key="d6">6.0</data>
      <data key="d7">The Black Death arrived in China between 1331 and 1334, impacting various regions, including parts governed by the Mongols. Its arrival coincided with significant geopolitical and trade disruptions under Mongol rule.</data>
      <data key="d8">plague-mongol-relation</data>
      <data key="d9">chunk-5010e0f708f284a5e25e323f470ad4d6</data>
      <data key="d10">dumps/World_History_Volume_1/pages_content.json</data>
      <data key="d11">1783211098</data>
    </edge>
    <edge source="&lt;black death&gt;" target="&lt;yuan dynasty&gt;">
      <data key="d6">4.0</data>
      <data key="d7">Despite arriving in China between 1331 and 1334, the exact date is unknown. The Black Death led to a massive loss of around thirteen million people, perceived as divine displeasure. This event coincided with significant geopolitical changes within the Yuan dynasty.</data>
      <data key="d8">plague-dynasty-relation</data>
      <data key="d9">chunk-5010e0f708f284a5e25e323f470ad4d6</data>
      <data key="d10">dumps/World_History_Volume_1/pages_content.json</data>
      <data key="d11">1783211098</data>
    </edge>
    <edge source="&lt;black death&gt;" target="&lt;il-khanate&gt;">
      <data key="d6">8.0</data>
      <data key="d7">The Black Death had a severe impact on the Il-Khanate, leading to significant population loss and trade disruptions. These events contributed to the decline of Mongol rule in cities like Tabriz after Abu Sa’id’s death in 1335.</data>
      <data key="d8">plague-impact-on-il-khanate</data>
      <data key="d9">chunk-5010e0f708f284a5e25e323f470ad4d6</data>
      <data key="d10">dumps/World_History_Volume_1/pages_content.json</data>
      <data key="d11">1783211098</data>
    </edge>
    <edge source="&lt;black death&gt;" target="&lt;mamluk empire&gt;">
      <data key="d6">6.0</data>
      <data key="d7">The Mamluk Empire suffered significant population loss (approximately one-third) and high mortality rates across the Middle East due to the Black Death. This event disrupted regional stability and trade networks.</data>
      <data key="d8">plague-mamluk-relation</data>
      <data key="d9">chunk-5010e0f708f284a5e25e323f470ad4d6</data>
      <data key="d10">dumps/World_History_Volume_1/pages_content.json</data>
      <data key="d11">1783211099</data>
    </edge>
    <edge source="&lt;&quot;Black Death in Europe&quot;&gt;" target="&lt;&quot;Cairo and Alexandria&quot;&gt;">
      <data key="d6">2.0</data>
      <data key="d7">&lt;"These cities experienced severe impacts due to high density populations, leading to major declines in trade, agriculture, and overall urban life. The plague spread rapidly through these centers."&gt;</data>
      <data key="d8">&lt;"impact of plague on cities"&gt;</data>
      <data key="d9">chunk-2ae7648f16b65be16cc6ebc5e6c4363b</data>
      <data key="d10">dumps/World_History_Volume_1/pages_content.json</data>
      <data key="d11">1783211098</data>
    </edge>
    <edge source="&lt;&quot;Cairo and Alexandria&quot;&gt;" target="&lt;&quot;localized famines&quot;&gt;">
      <data key="d6">2.0</data>
      <data key="d7">&lt;"Migration of rural peasants seeking employment in cities contributed to population growth in Cairo and Alexandria during the time of the Black Death. This further increased the density in these areas, making them more vulnerable to plague spread."&gt;</data>
      <data key="d8">&lt;"migration from countryside to cities"&gt;</data>
      <data key="d9">chunk-2ae7648f16b65be16cc6ebc5e6c4363b</data>
      <data key="d10">dumps/World_History_Volume_1/pages_content.json</data>
      <data key="d11">1783211098</data>
    </edge>
    <edge source="&lt;&quot;Cairo and Alexandria&quot;&gt;" target="&lt;&quot;Mamluk Elite Fleeing&quot;&gt;">
      <data key="d6">2.0</data>
      <data key="d7">&lt;"The movement of Mamluk elite out of major cities during the plague had a significant impact on the governance structures in Cairo and Alexandria, leading to temporary disruptions in administrative operations."&gt;</data>
      <data key="d8">&lt;"impact on leadership"</data>
      <data key="d9">chunk-2ae7648f16b65be16cc6ebc5e6c4363b</data>
      <data key="d10">dumps/World_History_Volume_1/pages_content.json</data>
      <data key="d11">1783211098</data>
    </edge>
    <edge source="&lt;&quot;Islamic scholars&quot;&gt;" target="&lt;&quot;Mamluk Sultanate&quot;&gt;">
      <data key="d6">2.0</data>
      <data key="d7">&lt;"Islamic scholars provided valuable medical advice, moral support, and spiritual guidance during the Black Death, influencing public health policies and societal responses throughout the Mamluk Sultanate. Their writings had a significant impact on how people responded to the plague."&gt;</data>
      <data key="d8">&lt;"advice and guidance during crisis"</data>
      <data key="d9">chunk-2ae7648f16b65be16cc6ebc5e6c4363b</data>
      <data key="d10">dumps/World_History_Volume_1/pages_content.json</data>
      <data key="d11">1783211098</data>
    </edge>
    <edge source="Ottoman Sons" target="control_of_ottoman_domains">
      <data key="d6">10.0</data>
      <data key="d7">Suleyman controlled Ottoman Europe, Isa had control over Anatolia, and Mehmed governed Amasya; Musa and later Mustafa also contested for the throne after 1402.</data>
      <data key="d8">controled_domains</data>
      <data key="d9">chunk-0e02f2af9c7712235155281a18fd34d7</data>
      <data key="d10">dumps/World_History_Volume_1/pages_content.json</data>
      <data key="d11">1783211100</data>
    </edge>
    <edge source="&lt;&quot;Conquest of Constantinople&quot;" target="&lt;&quot;Mehmed and Murad II&quot;&gt;">
      <data key="d6">10.0</data>
      <data key="d7">This primary goal motivated Ottoman rulers in their efforts to reclaim the Byzantine capital.</data>
      <data key="d8">Constantinople Conquest,Rulership Goals</data>
      <data key="d9">chunk-433f69fe105bcc9a81a2592b9a43cef3</data>
      <data key="d10">dumps/World_History_Volume_1/pages_content.json</data>
      <data key="d11">1783211100</data>
    </edge>
    <edge source="history" target="topkapi palace, byzantine cathedral of hagia sophia, city walls, weapons foundry, hospital, fatih mosque, madrasas">
      <data key="d6">4.0</data>
      <data key="d7">Mehmed's projects such as these historical sites are still visited and preserved.</data>
      <data key="d8">Historical Preservation</data>
      <data key="d9">chunk-b67f0f7afc2d163b11e5f62d24179b37</data>
      <data key="d10">dumps/World_History_Volume_1/pages_content.json</data>
      <data key="d11">1783211100</data>
    </edge>
    <edge source="humanism" target="Italian Neoplatonists">
      <data key="d6">12.0</data>
      <data key="d7">"Artists of the time included members of the merchant class like the Arnolfinis because humanist values emphasized the importance and uniqueness of individual humans, reflecting in paintings a focus on realism and detailed representation of daily life."/&gt;</data>
      <data key="d8">6</data>
      <data key="d9">chunk-39f50645a1a52a72b5d8d61856942487</data>
      <data key="d10">dumps/World_History_Volume_1/pages_content.json</data>
      <data key="d11">1783211101</data>
    </edge>
    <edge source="Chief Minister Position " target="Hongwu Emperor ">
      <data key="d6">4.0</data>
      <data key="d7">The abolition of the chief minister position by Hongwu signified a shift towards highly centralized rule aiming at reducing internal threats, demonstrating a strong relationship between political structure changes and consolidation of power.</data>
      <data key="d8">centralization,power</data>
      <data key="d9">chunk-cb1aed2461d605387294e530dbb57f99</data>
      <data key="d10">dumps/World_History_Volume_1/pages_content.json</data>
      <data key="d11">1783211102</data>
    </edge>
    <edge source="Hongwu Emperor " target="Secret Police Force ">
      <data key="d6">6.0</data>
      <data key="d7">Hongwu established the secret police as part of his extensive reform efforts to strengthen surveillance and control, indicating a direct causal link.</data>
      <data key="d8">control,surveillance</data>
      <data key="d9">chunk-cb1aed2461d605387294e530dbb57f99</data>
      <data key="d10">dumps/World_History_Volume_1/pages_content.json</data>
      <data key="d11">1783211102</data>
    </edge>
    <edge source="Hongwu Emperor " target="Kingdom of Dali ">
      <data key="d6">2.0</data>
      <data key="d7">During Hongwu’s rule, military efforts were directed against the Kingdom of Dali as part of broader territorial ambitions of the Ming dynasty.</data>
      <data key="d8">expansion,territory</data>
      <data key="d9">chunk-cb1aed2461d605387294e530dbb57f99</data>
      <data key="d10">dumps/World_History_Volume_1/pages_content.json</data>
      <data key="d11">1783211103</data>
    </edge>
    <edge source="Mamluk Sultanate System" target="Slave Life Under Ottomans and Mamluks">
      <data key="d6">8.0</data>
      <data key="d7">The system underpinning the life of enslaved individuals in this context is a manifestation of state-administered slave regimes." "&lt;br&gt;This highlights the institutional aspects governing human lives within larger political frameworks." </data>
      <data key="d8">historical context,institutional systems,social structures</data>
      <data key="d9">chunk-f3acbd758cf8087488127fa375dda8fa</data>
      <data key="d10">dumps/World_History_Volume_1/pages_content.json</data>
      <data key="d11">1783211103</data>
    </edge>
