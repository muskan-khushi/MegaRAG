    </node>
    <node id="Upper Egypt">
      <data key="d0">Upper Egypt</data>
      <data key="d1">geographical_location</data>
      <data key="d2">Upper Egypt refers to the northern part of present-day Upper Egypt in Egypt and represents a region crucial to political and cultural centers during various periods, including the Second Intermediate Period.</data>
      <data key="d3">chunk-01819cdf305281e0ef22ba7cb3469e6a</data>
      <data key="d4">dumps/World_History_Volume_1/pages_content.json</data>
