      <data key="d0">&lt;"Thasos"</data>
      <data key="d1">&lt;geographical_location</data>
      <data key="d2">&lt;"A Greek island known for its rebellion against Athens, symbolizing regional resistance within the Athenian Empire."</data>
      <data key="d3">chunk-2950474ba33f47bb39e303f028b2774e</data>
