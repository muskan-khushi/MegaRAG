      <data key="d0">&lt;"Umar ibn al-Khattab"</data>
      <data key="d1">&lt;"historical_figure</data>
      <data key="d2">&lt;Entity_description: The second caliph of the Rashidun Caliphate, known for his effective administration and consolidation of empire. Umar's rule extended from 634-644 CE until his assassination.</data>
      <data key="d3">chunk-eca248d7090f58e7e1c63a9bfb407080</data>
      <data key="d4">dumps/World_History_Volume_1/pages_content.json</data>
