    <node id="Amphora">
      <data key="d0">Amphora</data>
      <data key="d1">source_or_artifact</data>
      <data key="d2">Large storage vessels called amphorae were crucial for shipping liquid goods, with their design allowing easy storage whether placed upright or set on the ground.</data>
      <data key="d3">chunk-26ccbf3441b6b8fad246e6cd56535b53</data>
      <data key="d4">dumps/World_History_Volume_1/pages_content.json</data>
