      <data key="d11">1783211043</data>
    </edge>
    <edge source="&lt;Deerskin and bark lined shoes&gt;" target="&lt;Freshwater marine life&gt;">
      <data key="d6">7.6</data>
      <data key="d7">Both represent the varied resource utilization during the PaleolithicAge.</data>
      <data key="d8">Resource_diversity</data>
      <data key="d9">chunk-959d0e5d4763f5423c8c6e422ec0cdb2</data>
