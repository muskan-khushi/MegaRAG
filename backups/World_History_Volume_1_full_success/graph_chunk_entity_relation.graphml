      <data key="d0">First Millennium</data>
      <data key="d1">time_period</data>
      <data key="d2">This term encompasses the period before or during the formation of Ghana, highlighting early developments that set the stage for its rise to power.</data>
      <data key="d3">chunk-d32d7ef2fac445505a9bd6f9b878a6f4</data>
