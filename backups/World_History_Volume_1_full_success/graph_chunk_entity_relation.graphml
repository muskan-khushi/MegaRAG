    <node id="Ayyubid dynasty">
      <data key="d0">Ayyubid dynasty</data>
      <data key="d1">historical_figure</data>
      <data key="d2">The Ayyubid dynasty ruled Egypt and Syria from the mid-12th to late 13th centuries, with key figures like Saladin leading successful military campaigns against the Crusaders.</data>
      <data key="d3">chunk-bbaccac96c9ea8e056f368393c0b33b3</data>
      <data key="d4">dumps/World_History_Volume_1/pages_content.json</data>
