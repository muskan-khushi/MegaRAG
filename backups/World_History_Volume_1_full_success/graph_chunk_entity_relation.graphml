      <data key="d6">6.0</data>
      <data key="d7">Indicating the historical event within the broader context of Aryan influence on Vedic religion</data>
      <data key="d8">Vedic religion,civilization decline,conquerors</data>
      <data key="d9">chunk-6cbd9d663b9bcdcbd4f8a3f2604aa0a3</data>
