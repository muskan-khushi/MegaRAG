    <edge source="&lt;&quot;Procopius&quot;" target="&lt;&quot;Justinian I&quot;">
      <data key="d6">2.0</data>
      <data key="d7">&lt;"Procopius's work provides vivid depictions of Justinian's personal and political life, particularly his questionable path to power. This portrayal affects the reader's perception of the emperor’s fitness for rule."</data>
      <data key="d8">&lt;"historiographical accounts &amp; emperor's legitimacy"</data>
      <data key="d9">chunk-0f3483082d977617409e75f5948382d4</data>
      <data key="d10">dumps/World_History_Volume_1/pages_content.json</data>
      <data key="d11">1783211075</data>
    </edge>
    <edge source="&lt;&quot;Parthians&quot;" target="&lt;&quot;Seleucids&quot;">
      <data key="d6">2.0</data>
      <data key="d7">&lt;"'The decline of the Seleucid Empire created a power vacuum that allowed the Parthian Empire, under Parthian leadership, to rise. This illustrates historical conflicts leading to geopolitical shifts."</data>
      <data key="d8">&lt;"conflict &amp; succession of empires"</data>
      <data key="d9">chunk-0f3483082d977617409e75f5948382d4</data>
      <data key="d10">dumps/World_History_Volume_1/pages_content.json</data>
      <data key="d11">1783211075</data>
    </edge>
    <edge source="&lt;&quot;Parthians&quot;" target="&lt;&quot;Sasanians&quot;">
      <data key="d6">2.0</data>
      <data key="d7">&lt;"'The Sasanian Empire emerged as a successor state to the Parthian Empire, inheriting much of its territory. This transition reflects the evolution and reorganization of power in West Asia."</data>
      <data key="d8">&lt;"succession from predecessor state"</data>
      <data key="d9">chunk-0f3483082d977617409e75f5948382d4</data>
      <data key="d10">dumps/World_History_Volume_1/pages_content.json</data>
      <data key="d11">1783211075</data>
    </edge>
    <edge source="&lt;&quot;Sasanians&quot;" target="&lt;&quot;Ardashir I&quot;">
      <data key="d6">2.0</data>
      <data key="d7">&lt;"'Ardashir I founded the Sassanid Empire, which became a major world power. His conquests and policies set the stage for Sasanian dominance in Iran."</data>
      <data key="d8">&lt; "founder &amp; establishment of empire"</data>
      <data key="d9">chunk-0f3483082d977617409e75f5948382d4</data>
      <data key="d10">dumps/World_History_Volume_1/pages_content.json</data>
      <data key="d11">1783211075</data>
    </edge>
    <edge source="&lt;&quot;Sasanians&quot;" target="&lt;&quot;Shapur I&quot;">
      <data key="d6">2.0</data>
      <data key="d7">&lt;"'Shapur I solidified Sasanian control with his military campaigns, including the famous capture of Emperor Valerian. This expansion cemented Sasanian power in the ancient world."</data>
      <data key="d8">&lt; " consolidation &amp; expansion of empire"</data>
      <data key="d9">chunk-0f3483082d977617409e75f5948382d4</data>
      <data key="d10">dumps/World_History_Volume_1/pages_content.json</data>
