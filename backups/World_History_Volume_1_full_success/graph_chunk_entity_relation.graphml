    <node id="&lt;&quot;Chinggis Khan's conquest tactics&quot;&gt;">
      <data key="d0">&lt;"Chinggis Khan's conquest tactics"&gt;</data>
      <data key="d1">&lt;historical_concept_or_event&gt;</data>
      <data key="d2">&lt;"Chinggis Khan used various conquest tactics, such as internal dissent and cultural narratives of liberation to expand the empire."&gt;</data>
      <data key="d3">chunk-405d14b235f769c3d78504b096eb8659</data>
