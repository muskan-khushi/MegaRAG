      <data key="d1">textbook_structure</data>
      <data key="d2">Camel transformed trade across the Sahara, facilitating the movement of goods such as salt and luxury items.</data>
      <data key="d3">chunk-69daf8633779d8478fa1be3b5bf8fb8b</data>
      <data key="d4">dumps/World_History_Volume_1/pages_content.json</data>
      <data key="d5">1783210940</data>
    </node>
    <node id="trade moving salt across the Sahara">
      <data key="d0">trade moving salt across the Sahara</data>
      <data key="d1">cultural_or_religious_movement</data>
      <data key="d2">Early trans-Saharan traders moved salt across the desert into sub-Saharan Africa because salt was necessary and scarce in the region.</data>
      <data key="d3">chunk-69daf8633779d8478fa1be3b5bf8fb8b</data>
      <data key="d4">dumps/World_History_Volume_1/pages_content.json</data>
