      <data key="d6">8.0</data>
      <data key="d7">Central religious site dedicated to Quetzalcoatl, reflecting the deity's influence and significant in understanding Teotihuacán's spiritual activities.</data>
      <data key="d8">Religion/Architecture</data>
      <data key="d9">chunk-4083e7ff876dd54b2e91d37d47639816</data>
      <data key="d10">dumps/World_History_Volume_1/pages_content.json</data>
      <data key="d11">1783211067</data>
    </edge>
