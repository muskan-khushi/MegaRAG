    <node id="&lt;Sumer&gt;">
      <data key="d0">&lt;Sumer&gt;</data>
      <data key="d1">&lt;civilization_or_empire&gt;</data>
      <data key="d2">&lt;Sumer was an ancient civilization located in Mesopotamia, present-day Iraq, known for its innovations in writing (cuneiform), irrigation systems, and early city-states. It flourished from about 4500 BCE to 2000 BCE.&gt;</data>
      <data key="d3">chunk-2b5f6c1ce60c5a963cfeed75216a1324</data>
      <data key="d4">dumps/World_History_Volume_1/pages_content.json</data>
      <data key="d5">1783211037</data>
    </node>
    <node id="&lt;Assyria&gt;">
      <data key="d0">&lt;Assyria&gt;</data>
      <data key="d1">&lt;civilization_or_empire&gt;</data>
      <data key="d2">&lt;Assyria was a powerful empire that existed from 911 BCE to 609 BCE, known for its extensive territory and legal codes. It played a significant role in the history of Mesopotamia through conquests and the development of administrative systems.&gt;</data>
      <data key="d3">chunk-2b5f6c1ce60c5a963cfeed75216a1324</data>
      <data key="d4">dumps/World_History_Volume_1/pages_content.json</data>
      <data key="d5">1783211037</data>
    </node>
    <node id="&lt;Greece (Ancient)&gt;">
      <data key="d0">&lt;Greece (Ancient)&gt;</data>
      <data key="d1">&lt;civilization_or_empire&gt;</data>
      <data key="d2">&lt;Ancient Greece was known for its city-states such as Athens and Sparta; it contributed significantly to philosophy, democracy, art, and architecture. The period covers roughly 8th century BCE to the Roman conquest in the 2nd century BCE.&gt;</data>
      <data key="d3">chunk-2b5f6c1ce60c5a963cfeed75216a1324</data>
      <data key="d4">dumps/World_History_Volume_1/pages_content.json</data>
      <data key="d5">1783211037</data>
    </node>
    <node id="&lt;Qin Dynasty&gt;">
      <data key="d0">&lt;Qin Dynasty&gt;</data>
      <data key="d1">&lt;civilization_or_empire&gt;</data>
      <data key="d2">&lt;The Qin Dynasty was founded in 221 BCE by Qin Shi Huang; it is known for unifying China under a central authority through standardizing writing, currency, weights and measures. It plays a crucial role in the early history of Chinese civilization.&gt;</data>
      <data key="d3">chunk-2b5f6c1ce60c5a963cfeed75216a1324</data>
      <data key="d4">dumps/World_History_Volume_1/pages_content.json</data>
