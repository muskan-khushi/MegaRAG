    </node>
    <node id="&lt;Delhi Sultanate&gt;">
      <data key="d0">&lt;Delhi Sultanate&gt;</data>
      <data key="d1">&lt;civilization_or_empire&gt;</data>
      <data key="d2">&lt;The Delhi Sultanate was a political entity and later a confederation of Muslim sultanates in the northern, central, and eastern regions of the Indian subcontinent from 1206 to 1526.&gt;</data>
      <data key="d3">chunk-4e57e6349a7929fcf289f8da82a3abde</data>
      <data key="d4">dumps/World_History_Volume_1/pages_content.json</data>
