    <node id="&lt;&quot;Feudalism (14th Century)&quot;">
      <data key="d0">&lt;"Feudalism (14th Century)"</data>
      <data key="d1">&lt;civilization_or_empire&gt;</data>
      <data key="d2">&lt;"The social, economic, and political system in place during the Middle Ages. Characterized by a rigid class hierarchy with landowners or lords at the top and peasants at the bottom."</data>
