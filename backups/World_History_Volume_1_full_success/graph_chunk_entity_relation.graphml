    <node id="Morocco">
      <data key="d0">Morocco</data>
      <data key="d1">geographical_location</data>
      <data key="d2">Morocco is mentioned as a source of radical reformist Islamic sects that threatened Ghana's peace and prosperity.</data>
      <data key="d3">chunk-d32d7ef2fac445505a9bd6f9b878a6f4</data>
      <data key="d4">dumps/World_History_Volume_1/pages_content.json</data>
