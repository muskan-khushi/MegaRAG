    </node>
    <node id="&lt;Bearskin cap&gt;">
      <data key="d0">&lt;Bearskin cap&gt;</data>
      <data key="d1">source_or_artifact</data>
      <data key="d2">Wearable artifact that provided warmth and protection for the head during cold weather, commonly found among paleolithic populations.</data>
