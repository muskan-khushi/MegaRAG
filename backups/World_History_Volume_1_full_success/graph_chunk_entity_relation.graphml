    <node id="&lt;&quot;Religious Law Formation&quot;">
      <data key="d0">&lt;"Religious Law Formation"</data>
      <data key="d1">&lt;"historical_concept_or_event</data>
      <data key="d2">&lt;Entity_description: The codification of legal principles derived from religious texts, oral traditions like hadith, and scholarly interpretations. This process culminated in the consolidation of Islamic jurisprudence by the Rashidun Caliphs.</data>
      <data key="d3">chunk-eca248d7090f58e7e1c63a9bfb407080</data>
      <data key="d4">dumps/World_History_Volume_1/pages_content.json</data>
