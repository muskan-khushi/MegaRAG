    <node id="The Prophet Abraham">
      <data key="d0">The Prophet Abraham</data>
      <data key="d1">historical_figure</data>
      <data key="d2">The Prophet Abraham is depicted as a central figure in this text, important for all three major monotheistic religions: Judaism, Christianity, and Islam.</data>
      <data key="d3">chunk-7114383587a4baf0af7064a88a7b0f99</data>
