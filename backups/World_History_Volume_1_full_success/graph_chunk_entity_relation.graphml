      <data key="d1">historical_concept_or_event</data>
      <data key="d2">The management and categorization of different ethnicities within the Roman Empire, including the rights and status associated with citizenship versus being a foreigner or peregrinus.</data>
      <data key="d3">chunk-ada1cb5eb9784a9ea1025f60a1b39b64</data>
      <data key="d4">dumps/World_History_Volume_1/pages_content.json</data>
