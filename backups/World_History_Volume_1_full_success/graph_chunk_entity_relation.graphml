      <data key="d0">&lt;"Aegean island of Delos"</data>
      <data key="d1">&lt;geographical_location</data>
      <data key="d2">&lt;"The center of the Delian League after its establishment in 454 BCE, symbolizing Athenian power and control over other Greek states."</data>
      <data key="d3">chunk-2950474ba33f47bb39e303f028b2774e</data>
      <data key="d4">dumps/World_History_Volume_1/pages_content.json</data>
