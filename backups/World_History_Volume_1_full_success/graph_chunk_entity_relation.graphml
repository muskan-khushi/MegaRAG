    <node id="Mecca">
      <data key="d0">Mecca</data>
      <data key="d1">geographical_location</data>
      <data key="d2">Mecca is a holy city located in western Saudi Arabia, known for being the site where Abraham constructed a house of worship. It is a significant destination for Muslim pilgrims, serving as the focal point for the Hajj pilgrimage. Each year, millions of Muslims travel to Mecca to fulfill this religious duty and visit the Kaaba, an important shrine within the city.</data>
      <data key="d3">chunk-fe262a6f9812b90fd703c1e1f0663b6b&lt;SEP&gt;chunk-7114383587a4baf0af7064a88a7b0f99</data>
      <data key="d4">dumps/World_History_Volume_1/pages_content.json</data>
      <data key="d5">1783210960</data>
    </node>
