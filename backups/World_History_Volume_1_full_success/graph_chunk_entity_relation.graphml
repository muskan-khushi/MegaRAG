    </node>
    <node id="Awdaghost">
      <data key="d0">Awdaghost</data>
      <data key="d1">geographical_location</data>
      <data key="d2">Awdaghost is an important Islamic town north of Ghana's capital, which played a key role in Ghana's expansion into Islam.</data>
      <data key="d3">chunk-d32d7ef2fac445505a9bd6f9b878a6f4</data>
      <data key="d4">dumps/World_History_Volume_1/pages_content.json</data>
