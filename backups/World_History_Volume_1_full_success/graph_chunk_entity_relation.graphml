      <data key="d0">&lt;"Hellenes"&gt;</data>
      <data key="d1">&lt;cultural_group&gt;</data>
      <data key="d2">&lt;"A group of people who began referring to themselves as Hellenes by the Archaic period, sharing common language and religion despite political unity among Greek city-states."&gt;</data>
      <data key="d3">chunk-deeeaa267faae20e29663a365d84657c</data>
      <data key="d4">dumps/World_History_Volume_1/pages_content.json</data>
