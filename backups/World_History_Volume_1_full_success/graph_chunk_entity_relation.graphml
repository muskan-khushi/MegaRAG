    <node id="&lt;&quot;Procopius&quot;&gt;">
      <data key="d0">&lt;"Procopius"&gt;</data>
      <data key="d1">&lt;"historical_figure"&gt;</data>
      <data key="d2">&lt;"Procopius was a historian and author who lived during the Byzantine era. His work 'The Secret History' provides insights into the reign of Emperor Justinian I and his empress Theodora, depicting their pasts and behaviors."</data>
      <data key="d3">chunk-0f3483082d977617409e75f5948382d4</data>
