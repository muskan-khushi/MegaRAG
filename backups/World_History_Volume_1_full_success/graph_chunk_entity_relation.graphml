    <node id="Bronze Drum Culture Spread">
      <data key="d0">Bronze Drum Culture Spread</data>
      <data key="d1">cultural_or_religious_movement</data>
      <data key="d2">Dong Son culture is known for its bronze drums, which were adopted by various Southeast Asian societies, symbolizing shared religious or cultural practices.</data>
      <data key="d3">chunk-6444c71b86edf5337c96dbb26fdca53e</data>
