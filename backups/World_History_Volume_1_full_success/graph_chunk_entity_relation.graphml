    <node id="&quot;670 BCE&quot;">
      <data key="d0">"670 BCE"</data>
      <data key="d1">time_period</data>
      <data key="d2">Highlighting one of several key points during the prominence of Assyria through artifacts like bas-reliefs.</data>
      <data key="d3">chunk-b8d6d7a01f04863f017d0ad8ee1b4e77</data>
      <data key="d4">dumps/World_History_Volume_1/pages_content.json</data>
