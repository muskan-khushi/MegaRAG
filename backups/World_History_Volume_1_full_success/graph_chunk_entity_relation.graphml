      <data key="d10">dumps/World_History_Volume_1/pages_content.json</data>
      <data key="d11">1783211051</data>
    </edge>
    <edge source="Hyksos" target="Theban Kingdom">
      <data key="d6">10.0</data>
      <data key="d7">The Theban kings opposed the Hyksos presence, leading to a complex political struggle for control over parts of ancient Egypt.</data>
