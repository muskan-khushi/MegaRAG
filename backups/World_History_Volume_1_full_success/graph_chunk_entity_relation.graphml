      <data key="d0">2550 BCE</data>
      <data key="d1">time_period</data>
      <data key="d2">Date when the Art of Ur box was laid in a royal tomb in ancient Ur</data>
      <data key="d3">chunk-1c1a3500d7732daf2db9f25db73376bf</data>
      <data key="d4">dumps/World_History_Volume_1/pages_content.json</data>
      <data key="d5">1783210810</data>
    </node>
    <node id="Specialization of Labor">
