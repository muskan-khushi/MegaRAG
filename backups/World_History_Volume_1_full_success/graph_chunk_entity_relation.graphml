    <node id="Aksum and Himyar">
      <data key="d0">Aksum and Himyar</data>
      <data key="d1">civilization_or_empire</data>
      <data key="d2">Aksum and Himyar were powerful states during Late Antiquity, located in East Africa and Arabia, respectively, with shared characteristics and interactions with other empires.</data>
      <data key="d3">chunk-64b6a2af1c3cece75a3cbd9b707b8713</data>
      <data key="d4">dumps/World_History_Volume_1/pages_content.json</data>
