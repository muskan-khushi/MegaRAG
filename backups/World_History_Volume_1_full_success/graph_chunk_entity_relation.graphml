    <node id="reform">
      <data key="d0">reform</data>
      <data key="d3">chunk-4b61ce25cf795d5df68cfe86411e23d4</data>
      <data key="d2">Diocletian issued the Edict on Maximum Prices as part of a series of reforms aimed at curbing inflation and supporting trade within the empire.</data>
      <data key="d1">UNKNOWN</data>
      <data key="d4">dumps/World_History_Volume_1/pages_content.json</data>
      <data key="d5">1783203325</data>
    </node>
    <node id="&lt;Constantine&gt;">
      <data key="d0">&lt;Constantine&gt;</data>
      <data key="d3">chunk-fc15c8190bd017249609745764d34f78</data>
      <data key="d2">The edict was issued by Constantine, marking his support for the spread of Christianity within the Empire.</data>
      <data key="d1">UNKNOWN</data>
      <data key="d4">dumps/World_History_Volume_1/pages_content.json</data>
      <data key="d5">1783203325</data>
