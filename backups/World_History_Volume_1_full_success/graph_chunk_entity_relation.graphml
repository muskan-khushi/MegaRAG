      <data key="d6">2.0</data>
      <data key="d7">&lt;"The social tiers defined the roles and statuses within the society, creating a nuanced understanding of social hierarchies."&lt;</data>
      <data key="d8">&lt;"social_hierarchies"</data>
      <data key="d9">chunk-a363d0ffc56298883492bdff98828737</data>
