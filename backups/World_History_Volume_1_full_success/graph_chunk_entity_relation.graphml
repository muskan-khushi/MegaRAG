      <data key="d0">&lt;"Maurya Empire"</data>
      <data key="d1">&lt;"civilization_or_empire</data>
      <data key="d2">&lt;"The Maurya Empire was one of the most powerful empires in ancient India, flourishing from 321 to 185 BCE. Notably known for its cultural and religious developments, including the spread of Buddhism under Emperor Ashoka."&lt;&lt;|</data>
      <data key="d3">chunk-a8006bb84efc385e264f6921f9b06e3d</data>
      <data key="d4">dumps/World_History_Volume_1/pages_content.json</data>
      <data key="d5">1783210870</data>
    </node>
    <node id="&lt;&quot;Buddhism&quot;">
      <data key="d0">&lt;"Buddhism"</data>
      <data key="d1">&lt;"cultural_or_religious_movement</data>
      <data key="d2">Buddhism is a major world religion founded by Siddhartha Gautama in ancient India. It emphasizes the path to enlightenment and liberation from the cycle of rebirth, known as Nirvana. Buddhism was subsequently introduced to Japan via emissaries from King Seong of Baekje in either 538 or 552 CE, marking the beginning of its influence on Japanese culture. Over time, it became the state religion under Empress Suiko's reign, significantly shaping Japanese spiritual and cultural landscapes.</data>
      <data key="d3">chunk-b9fb47c5483296a4e183cc66d1fd4125&lt;SEP&gt;chunk-a8006bb84efc385e264f6921f9b06e3d</data>
      <data key="d4">dumps/World_History_Volume_1/pages_content.json</data>
      <data key="d5">1783210874</data>
    </node>
    <node id="&lt;&quot;Hinduism&quot;">
      <data key="d0">&lt;"Hinduism"</data>
      <data key="d1">&lt;"cultural_religious_movement</data>
      <data key="d2">&lt;"Hinduism is a complex and diverse religious tradition with roots in Vedic India. It includes various practices and beliefs that emerged from the transformation of earlier religious traditions, including concepts like dharma and karma."&lt;&lt;|</data>
      <data key="d3">chunk-a8006bb84efc385e264f6921f9b06e3d</data>
      <data key="d4">dumps/World_History_Volume_1/pages_content.json</data>
      <data key="d5">1783210870</data>
    </node>
    <node id="&lt;&quot;Aryan&quot;">
