    <node id="&lt;&quot;Black Death in Europe&quot;&gt;">
      <data key="d0">&lt;"Black Death in Europe"&gt;</data>
      <data key="d3">chunk-2ae7648f16b65be16cc6ebc5e6c4363b</data>
      <data key="d2">&lt;"These cities experienced severe impacts due to high density populations, leading to major declines in trade, agriculture, and overall urban life. The plague spread rapidly through these centers."&gt;</data>
      <data key="d1">UNKNOWN</data>
      <data key="d4">dumps/World_History_Volume_1/pages_content.json</data>
      <data key="d5">1783203342</data>
    </node>
    <node id="&lt;&quot;Cairo and Alexandria&quot;&gt;">
      <data key="d0">&lt;"Cairo and Alexandria"&gt;</data>
      <data key="d3">chunk-2ae7648f16b65be16cc6ebc5e6c4363b</data>
      <data key="d2">&lt;"These cities experienced severe impacts due to high density populations, leading to major declines in trade, agriculture, and overall urban life. The plague spread rapidly through these centers."&gt;</data>
      <data key="d1">UNKNOWN</data>
      <data key="d4">dumps/World_History_Volume_1/pages_content.json</data>
      <data key="d5">1783203342</data>
    </node>
    <node id="&lt;mongol rule period&gt;">
      <data key="d0">&lt;mongol rule period&gt;</data>
      <data key="d3">chunk-5010e0f708f284a5e25e323f470ad4d6</data>
      <data key="d2">The Black Death arrived in China between 1331 and 1334, impacting various regions, including parts governed by the Mongols. Its arrival coincided with significant geopolitical and trade disruptions under Mongol rule.</data>
      <data key="d1">UNKNOWN</data>
      <data key="d4">dumps/World_History_Volume_1/pages_content.json</data>
      <data key="d5">1783203342</data>
    </node>
    <node id="&lt;&quot;localized famines&quot;&gt;">
      <data key="d0">&lt;"localized famines"&gt;</data>
      <data key="d3">chunk-2ae7648f16b65be16cc6ebc5e6c4363b</data>
      <data key="d2">&lt;"Migration of rural peasants seeking employment in cities contributed to population growth in Cairo and Alexandria during the time of the Black Death. This further increased the density in these areas, making them more vulnerable to plague spread."&gt;</data>
      <data key="d1">UNKNOWN</data>
      <data key="d4">dumps/World_History_Volume_1/pages_content.json</data>
      <data key="d5">1783203343</data>
    </node>
    <node id="&lt;&quot;Islamic scholars&quot;&gt;">
      <data key="d0">&lt;"Islamic scholars"&gt;</data>
      <data key="d3">chunk-2ae7648f16b65be16cc6ebc5e6c4363b</data>
      <data key="d2">&lt;"Islamic scholars provided valuable medical advice, moral support, and spiritual guidance during the Black Death, influencing public health policies and societal responses throughout the Mamluk Sultanate. Their writings had a significant impact on how people responded to the plague."&gt;</data>
      <data key="d1">UNKNOWN</data>
      <data key="d4">dumps/World_History_Volume_1/pages_content.json</data>
      <data key="d5">1783203343</data>
    </node>
    <node id="&lt;&quot;Mamluk Sultanate&quot;&gt;">
      <data key="d0">&lt;"Mamluk Sultanate"&gt;</data>
      <data key="d3">chunk-2ae7648f16b65be16cc6ebc5e6c4363b</data>
      <data key="d2">&lt;"Islamic scholars provided valuable medical advice, moral support, and spiritual guidance during the Black Death, influencing public health policies and societal responses throughout the Mamluk Sultanate. Their writings had a significant impact on how people responded to the plague."&gt;</data>
      <data key="d1">UNKNOWN</data>
      <data key="d4">dumps/World_History_Volume_1/pages_content.json</data>
      <data key="d5">1783203343</data>
    </node>
    <node id="&lt;yuan dynasty&gt;">
      <data key="d0">&lt;yuan dynasty&gt;</data>
      <data key="d3">chunk-5010e0f708f284a5e25e323f470ad4d6</data>
      <data key="d2">Despite arriving in China between 1331 and 1334, the exact date is unknown. The Black Death led to a massive loss of around thirteen million people, perceived as divine displeasure. This event coincided with significant geopolitical changes within the Yuan dynasty.</data>
      <data key="d1">UNKNOWN</data>
      <data key="d4">dumps/World_History_Volume_1/pages_content.json</data>
      <data key="d5">1783203343</data>
    </node>
    <node id="&lt;&quot;Emperor Qin Shi Huang&quot;">
      <data key="d0">&lt;"Emperor Qin Shi Huang"</data>
      <data key="d3">chunk-b7494d5cadc1afd15065737504e9cd58</data>
      <data key="d2">&lt;"The Emperor was the founder and first emperor of the Qin dynasty who unified China under his rule."</data>
      <data key="d1">UNKNOWN</data>
      <data key="d4">dumps/World_History_Volume_1/pages_content.json</data>
      <data key="d5">1783203343</data>
    </node>
    <node id="&lt;&quot;Mamluk Elite Fleeing&quot;&gt;">
      <data key="d0">&lt;"Mamluk Elite Fleeing"&gt;</data>
      <data key="d3">chunk-2ae7648f16b65be16cc6ebc5e6c4363b</data>
      <data key="d2">&lt;"The movement of Mamluk elite out of major cities during the plague had a significant impact on the governance structures in Cairo and Alexandria, leading to temporary disruptions in administrative operations."&gt;</data>
      <data key="d1">UNKNOWN</data>
      <data key="d4">dumps/World_History_Volume_1/pages_content.json</data>
      <data key="d5">1783203343</data>
    </node>
    <node id="&lt;il-khanate&gt;">
      <data key="d0">&lt;il-khanate&gt;</data>
      <data key="d3">chunk-5010e0f708f284a5e25e323f470ad4d6</data>
      <data key="d2">The Black Death had a severe impact on the Il-Khanate, leading to significant population loss and trade disruptions. These events contributed to the decline of Mongol rule in cities like Tabriz after Abu Sa’id’s death in 1335.</data>
      <data key="d1">UNKNOWN</data>
      <data key="d4">dumps/World_History_Volume_1/pages_content.json</data>
      <data key="d5">1783203343</data>
    </node>
    <node id="&lt;mamluk empire&gt;">
      <data key="d0">&lt;mamluk empire&gt;</data>
      <data key="d3">chunk-5010e0f708f284a5e25e323f470ad4d6</data>
      <data key="d2">The Mamluk Empire suffered significant population loss (approximately one-third) and high mortality rates across the Middle East due to the Black Death. This event disrupted regional stability and trade networks.</data>
      <data key="d1">UNKNOWN</data>
      <data key="d4">dumps/World_History_Volume_1/pages_content.json</data>
      <data key="d5">1783203343</data>
    </node>
    <node id="Serbian Army">
      <data key="d0">Serbian Army</data>
      <data key="d3">chunk-51a6e6c0f619a3b37e3ee2a7e7f19b5a</data>
      <data key="d2">The Serbian forces led by Prince Lazar fought valiantly against the Ottomans but were defeated at the Battle of Kosovo.</data>
      <data key="d1">UNKNOWN</data>
      <data key="d4">dumps/World_History_Volume_1/pages_content.json</data>
      <data key="d5">1783203343</data>
    </node>
