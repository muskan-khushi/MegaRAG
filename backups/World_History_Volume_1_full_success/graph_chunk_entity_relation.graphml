      <data key="d0">Temple of Hatshepsut</data>
      <data key="d1">source_or_artifact</data>
      <data key="d2">A mortuary temple built by Queen Hatshepsut during her reign, known for its grandeur and intricate decorations depicting expeditions to Punt.</data>
      <data key="d3">chunk-ea1d66e7e1ca6fb29c879b644db4aab6</data>
