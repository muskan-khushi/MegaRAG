    </node>
    <node id="Indian Peoples">
      <data key="d0">Indian Peoples</data>
      <data key="d1">historical_figure</data>
      <data key="d2">Indian peoples refers to the local populations whose culture blended with that of other influences in Gandhara region.</data>
      <data key="d3">chunk-bceaa7979e3d60d1deb8d4848dbe01fa</data>
      <data key="d4">dumps/World_History_Volume_1/pages_content.json</data>
