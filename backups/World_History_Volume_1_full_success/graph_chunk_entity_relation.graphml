    <node id="Levant">
      <data key="d0">Levant</data>
      <data key="d1">geographical_location</data>
      <data key="d2">The Levant is a region located in Southwest Asia and includes parts of Syria, Lebanon, Jordan, Palestine, and Iraq. Known for its arid climate conditions, this area has a rich historical background, having been initially controlled by Islamic conquests from the early seventh century onwards.</data>
      <data key="d3">chunk-c5b0a78bf038c5aff1201d9ae1d7d241&lt;SEP&gt;chunk-70d03803311b31d7e11f7ace07e0a57f</data>
