      <data key="d6">2.0</data>
      <data key="d7">&lt;"These artifacts provide evidence of the practices and beliefs of Hunter-gatherers who engaged in seasonal occupations."&gt;</data>
      <data key="d8">&lt;"Historical Concept to Artifacts"</data>
