    <node id="Early Islamic Art and Architecture">
      <data key="d0">Early Islamic Art and Architecture</data>
      <data key="d1">textbook_structure</data>
      <data key="d2">Early Islamic Art and Architecture represents a section in a historical textbook focusing on the visual arts and architectural developments during the early period of Islam.</data>
      <data key="d3">chunk-8515eeaece70ecd2cb37ce5d05f004bd</data>
