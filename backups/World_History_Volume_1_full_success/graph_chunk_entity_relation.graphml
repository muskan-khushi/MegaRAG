    </node>
    <node id="&lt;&quot;Emishi People&quot;">
      <data key="d0">&lt;"Emishi People"</data>
      <data key="d1">&lt;"historical_cultural_group</data>
      <data key="d2">&lt;"A group of northern Japanese people, distinct from the Yamato culture. They resisted assimilation and continued their independent way of life until subjugation in the late Heian period."</data>
