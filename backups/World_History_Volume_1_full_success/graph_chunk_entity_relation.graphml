    <node id="Red Palace">
      <data key="d0">Red Palace</data>
      <data key="d1">source_or_artifact</data>
      <data key="d2">The Red Palace, constructed on a 164-foot earthen platform, served as a residence for elites and featured large stone columns and aqueducts. It was likely built around the start of Olmec civilization with significant red ocher pigment decoration.</data>
      <data key="d3">chunk-08fb9bfb38f84b34683dfd75182299f8</data>
      <data key="d4">dumps/World_History_Volume_1/pages_content.json</data>
      <data key="d5">1783210917</data>
    </node>
    <node id="Monumental Architecture">
      <data key="d0">Monumental Architecture</data>
      <data key="d1">textbook_structure</data>
      <data key="d2">Complex architecture including ceremonial structures, water reservoirs, drainage systems, stone art, and massive stone heads were central to Olmec civilization’s development in Mesoamerica.</data>
      <data key="d3">chunk-08fb9bfb38f84b34683dfd75182299f8</data>
      <data key="d4">dumps/World_History_Volume_1/pages_content.json</data>
