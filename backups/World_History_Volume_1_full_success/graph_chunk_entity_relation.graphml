    <node id="&lt;&quot;Christianity&quot;&gt;">
      <data key="d0">&lt;"Christianity"&gt;</data>
      <data key="d1">&lt;"religion"&gt;</data>
      <data key="d2">&lt;"Christianity is one of the world's major religions and was prevalent in many regions conquered by Muslims. During the Arab-Muslim conquests, Christians often retained a degree of autonomy under certain conditions."&gt;</data>
      <data key="d3">chunk-927613aa4aec81a8719529ae83d4bfd6</data>
      <data key="d4">dumps/World_History_Volume_1/pages_content.json</data>
