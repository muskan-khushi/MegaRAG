    <node id="&lt;&quot;Amenhotep's palace at Thebes&quot;">
      <data key="d0">&lt;"Amenhotep's palace at Thebes"</data>
      <data key="d1">&lt;"source_or_artifact</data>
      <data key="d2">&lt;"The palace built during Amenhotep III’s reign, located in Thebes, was a significant residence and center of political power. It showcases the wealth and architectural sophistication of the period."&lt;|</data>
      <data key="d3">chunk-e99b695e71f9120e8fa39e113560a3bc</data>
      <data key="d4">dumps/World_History_Volume_1/pages_content.json</data>
      <data key="d5">1783210844</data>
    </node>
    <node id="&lt;&quot;Thebes&quot;">
      <data key="d0">&lt;"Thebes"</data>
      <data key="d1">&lt;"geographical_location</data>
      <data key="d2">Thebes was an important site of native Egyptian cultural and political power. It experienced a decline in influence due to the cooperation between Kush and Hyksos-controlled Lower Egypt. Thebes also served as a significant religious and cultural capital during ancient Egyptian times, renowned for its temples and palaces, including those constructed by Amenhotep III.</data>
      <data key="d3">chunk-e99b695e71f9120e8fa39e113560a3bc&lt;SEP&gt;chunk-d7edb5c90c1347b6f59e1607916d8804</data>
      <data key="d4">dumps/World_History_Volume_1/pages_content.json</data>
      <data key="d5">1783210848</data>
    </node>
    <node id="&lt;&quot;Serapeum at Saqqara&quot;">
      <data key="d0">&lt;"Serapeum at Saqqara"</data>
      <data key="d1">&lt;"source_or_artifact</data>
      <data key="d2">&lt;"A sacred site dedicated to the god Sarapis in Egypt, located near modern-day Cairo. It was established during Ptolemaic times but shows evidence of earlier religious practices originating from Amenhotep III's reign."&lt;|</data>
      <data key="d3">chunk-e99b695e71f9120e8fa39e113560a3bc</data>
      <data key="d4">dumps/World_History_Volume_1/pages_content.json</data>
      <data key="d5">1783210844</data>
    </node>
    <node id="&lt;&quot;Amarna&quot;">
      <data key="d0">&lt;"Amarna"</data>
      <data key="d1">&lt;"geographical_location</data>
      <data key="d2">&lt;"Amarna is an archaeological site and former capital city founded by Akhenaten, where a monotheistic religion dedicated to the sun disk Aton was practiced during his reign. It served as a significant cultural center."&lt;|</data>
      <data key="d3">chunk-e99b695e71f9120e8fa39e113560a3bc</data>
      <data key="d4">dumps/World_History_Volume_1/pages_content.json</data>
      <data key="d5">1783210844</data>
    </node>
