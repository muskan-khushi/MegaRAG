      <data key="d11">1783211052</data>
    </edge>
    <edge source="Nubia" target="Egypt">
      <data key="d6">10.0</data>
      <data key="d7">Nubia trades valuable resources such as ivory, ebony, leopard skins, incense, and gold with Egypt, contributing to the broader economic networks of the Eastern Mediterranean.</data>
