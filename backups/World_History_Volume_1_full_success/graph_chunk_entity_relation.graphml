    <node id="&lt;Temple of Isis&gt;">
      <data key="d0">&lt;Temple of Isis&gt;</data>
      <data key="d1">geographical_location</data>
      <data key="d2">Hosted communal gatherings and served as a place for public worship practices, integrating diverse religious cultures in ancient Roman society.</data>
      <data key="d3">chunk-a1a606296ab27c5dc7d129e54471d9c8</data>
      <data key="d4">dumps/World_History_Volume_1/pages_content.json</data>
      <data key="d5">1783210910</data>
    </node>
    <node id="&lt;Roman Society&gt;">
      <data key="d0">&lt;Roman Society&gt;</data>
      <data key="d1">civilization_or_empire</data>
      <data key="d2">Comprised of various social classes, practiced multiple religions including traditional ones like that of Isis, and faced growing religious diversity and policies promoting public worship.</data>
      <data key="d3">chunk-a1a606296ab27c5dc7d129e54471d9c8</data>
      <data key="d4">dumps/World_History_Volume_1/pages_content.json</data>
      <data key="d5">1783210910</data>
    </node>
    <node id="&lt;Isis Worship&gt;">
      <data key="d0">&lt;Isis Worship&gt;</data>
      <data key="d1">cultural_or_religious_movement</data>
      <data key="d2">Foreign religious practice integrated into Roman civic life through communal events and rituals hosted at the Temple of Isis.</data>
      <data key="d3">chunk-a1a606296ab27c5dc7d129e54471d9c8</data>
      <data key="d4">dumps/World_History_Volume_1/pages_content.json</data>
      <data key="d5">1783210910</data>
    </node>
    <node id="&lt;Nero's Persecution (64 CE, 68-69 CE)&gt;">
      <data key="d0">&lt;Nero's Persecution (64 CE, 68-69 CE)&gt;</data>
      <data key="d1">historical_concept_or_event</data>
      <data key="d2">Period marked by imperial crackdown on Christians following accusations made during Nero’s reign.</data>
      <data key="d3">chunk-a1a606296ab27c5dc7d129e54471d9c8</data>
      <data key="d4">dumps/World_History_Volume_1/pages_content.json</data>
      <data key="d5">1783210910</data>
    </node>
    <node id="&lt;Perpetua's Martyrdom&gt;">
      <data key="d0">&lt;Perpetua's Martyrdom&gt;</data>
      <data key="d1">historical_concept_or_event</data>
      <data key="d2">Martyrdom of a Christian saint, highlighting early Christian resistance and dedication in the face of persecution.</data>
      <data key="d3">chunk-a1a606296ab27c5dc7d129e54471d9c8</data>
      <data key="d4">dumps/World_History_Volume_1/pages_content.json</data>
      <data key="d5">1783210910</data>
    </node>
    <node id="&lt;Caracalla's Edict (212 CE)&gt;">
      <data key="d0">&lt;Caracalla's Edict (212 CE)&gt;</data>
      <data key="d1">civilization_or_empire</data>
      <data key="d2">Extended Roman citizenship to all free inhabitants with accompanying responsibilities including state sacrifices.</data>
      <data key="d3">chunk-a1a606296ab27c5dc7d129e54471d9c8</data>
      <data key="d4">dumps/World_History_Volume_1/pages_content.json</data>
      <data key="d5">1783210910</data>
    </node>
    <node id="&lt;Decius' Edict (250 CE)&gt;">
      <data key="d0">&lt;Decius' Edict (250 CE)&gt;</data>
      <data key="d1">historical_concept_or_event</data>
      <data key="d2">Required universal sacrifice, leading to severe persecutions against Christians in an attempt to enforce religious uniformity and loyalty to the emperor.</data>
      <data key="d3">chunk-a1a606296ab27c5dc7d129e54471d9c8</data>
      <data key="d4">dumps/World_History_Volume_1/pages_content.json</data>
      <data key="d5">1783210910</data>
    </node>
    <node id="&lt;Diocletians Persecution (303-311 CE)&gt;">
      <data key="d0">&lt;Diocletians Persecution (303-311 CE)&gt;</data>
      <data key="d1">historical_concept_or_event</data>
      <data key="d2">Explicit targeting of Christian communities through destruction of their places of worship, marking one of the harshest campaigns against Christians in Roman history.</data>
      <data key="d3">chunk-a1a606296ab27c5dc7d129e54471d9c8</data>
      <data key="d4">dumps/World_History_Volume_1/pages_content.json</data>
      <data key="d5">1783210910</data>
    </node>
    <node id="&lt;Constantine's Edict of Milan (313 CE)&gt;">
      <data key="d0">&lt;Constantine's Edict of Milan (313 CE)&gt;</data>
      <data key="d1">historical_concept_or_event</data>
      <data key="d2">Policies initiated religious toleration alongside traditional practices, acknowledging Christianity as a legal and accepted part of Roman life.</data>
      <data key="d3">chunk-a1a606296ab27c5dc7d129e54471d9c8</data>
      <data key="d4">dumps/World_History_Volume_1/pages_content.json</data>
      <data key="d5">1783210910</data>
