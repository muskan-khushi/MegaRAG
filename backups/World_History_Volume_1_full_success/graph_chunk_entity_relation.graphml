    <node id="&lt;&quot;islam&quot;">
      <data key="d0">&lt;"islam"</data>
      <data key="d1">&lt;cultural_or_religious_movement&gt;</data>
      <data key="d2">&lt;"Islam began to spread into West Africa during this period through various means such as trade connections and missionary efforts. The presence of mosques in the Ghana Empire indicates the growing influence of Islam."&lt;|</data>
      <data key="d3">chunk-69012398e94fc567ca6593314057bcf0</data>
