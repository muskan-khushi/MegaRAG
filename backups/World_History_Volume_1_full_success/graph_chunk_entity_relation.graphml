    <edge source="&lt;&quot;Chinggis Khan&quot;" target="&lt;&quot;Mongol Empire&quot;&gt;">
      <data key="d6">2.0</data>
      <data key="d7">&lt;"Chinggis Khan played a pivotal role in founding and expanding the Mongol Empire through conquests and effective governance. His actions directly shaped its structure and expansion."&gt;</data>
      <data key="d8">&lt;"founder,expansion"&gt;</data>
      <data key="d9">chunk-405d14b235f769c3d78504b096eb8659</data>
      <data key="d10">dumps/World_History_Volume_1/pages_content.json</data>
