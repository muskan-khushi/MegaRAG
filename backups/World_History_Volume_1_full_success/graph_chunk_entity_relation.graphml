    </node>
    <node id="&lt;&quot;Arab-Muslims/">
      <data key="d0">&lt;"Arab-Muslims/</data>
      <data key="d1">&lt;"civilization_or_empire</data>
      <data key="d2">&lt;"A culture and political entity that emerged from the conquests following the lifetime of Muhammad, characterized by distinct cultural, religious, and administrative practices. They were instrumental in shaping early Islamic history."</data>
      <data key="d3">chunk-acb0a07de6465f61f482a035df463ed8</data>
      <data key="d4">dumps/World_History_Volume_1/pages_content.json</data>
