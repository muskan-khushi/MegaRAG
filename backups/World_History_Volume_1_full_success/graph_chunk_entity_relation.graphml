      <data key="d0">&lt;"Abu Bakr"</data>
      <data key="d1">&lt;"historical_figure</data>
      <data key="d2">&lt;Entity_description: The first caliph of the Rashidun Caliphate following Muhammad's death. He led the community during initial Islamic expansion and organizational stability until his illness in 634 CE.</data>
      <data key="d3">chunk-eca248d7090f58e7e1c63a9bfb407080</data>
      <data key="d4">dumps/World_History_Volume_1/pages_content.json</data>
