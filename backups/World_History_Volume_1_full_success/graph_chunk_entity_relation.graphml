      <data key="d0">Japanese Empire</data>
      <data key="d1">civilization_or_empire</data>
      <data key="d2">The Empire of Japan, which carried out the surprise attack on Pearl Harbor.</data>
      <data key="d3">chunk-6f7fc147e6b53d5322148aad649d8fde</data>
      <data key="d4">dumps/World_History_Volume_1/pages_content.json</data>
      <data key="d5">1783210791</data>
    </node>
    <node id="Attack at Pearl Harbor">
      <data key="d0">Attack at Pearl Harbor</data>
      <data key="d1">historical_concept_or_event</data>
      <data key="d2">The event of the Japanese military's surprise attack on the U.S. forces stationed in Pearl Harbor, Hawaii.</data>
      <data key="d3">chunk-6f7fc147e6b53d5322148aad649d8fde</data>
      <data key="d4">dumps/World_History_Volume_1/pages_content.json</data>
      <data key="d5">1783210791</data>
    </node>
