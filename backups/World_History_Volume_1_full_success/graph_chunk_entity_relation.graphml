      <data key="d0">&lt;"Yamato Kingdom"</data>
      <data key="d1">&lt;"civilization_or_empire</data>
      <data key="d2">&lt;"A political entity that emerged in Japan during the 3rd century AD, centralizing power under a line of divine monarchs and exerting influence through religious and legal reforms. It laid the foundation for Japanese state structures."</data>
      <data key="d3">chunk-6a717a9cc91941f9644696170c9a7c09</data>
      <data key="d4">dumps/World_History_Volume_1/pages_content.json</data>
