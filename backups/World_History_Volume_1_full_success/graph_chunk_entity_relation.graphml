      <data key="d0">Patricians</data>
      <data key="d1">social_class</data>
      <data key="d2">Patricians were individuals who dominated trade on the Swahili coast and claimed Middle Eastern descent, centralizing trading activities at coastal cities like Mombasa and Sofala.</data>
      <data key="d3">chunk-7c340ee23a94a4e0a9b1cf7866cdc4f0</data>
