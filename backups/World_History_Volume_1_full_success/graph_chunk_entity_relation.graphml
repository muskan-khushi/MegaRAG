      <data key="d6">14.0</data>
      <data key="d7">The Arnolfini Portrait depicts Giovanni di Nicolao di Arnolfini and his wife, showcasing their wealthy lifestyle through the realistic depiction of their home and possessions.</data>
      <data key="d8">representation_ofwealth</data>
      <data key="d9">chunk-39f50645a1a52a72b5d8d61856942487</data>
      <data key="d10">dumps/World_History_Volume_1/pages_content.json</data>
      <data key="d11">1783211101</data>
    </edge>
    <edge source="The Arnolfini Portrait" target="medieval architecture">
      <data key="d6">8.0</data>
      <data key="d7">The interior scene in The Arnolfini Portrait reflects elements of medieval architecture commonly found during the Early Renaissance period.</data>
      <data key="d8">architectural_reflection</data>
      <data key="d9">chunk-39f50645a1a52a72b5d8d61856942487</data>
      <data key="d10">dumps/World_History_Volume_1/pages_content.json</data>
