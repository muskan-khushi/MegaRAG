      <data key="d3">chunk-4b61ce25cf795d5df68cfe86411e23d4</data>
      <data key="d2">The tetrarchy under Diocletian was an attempt to stabilize and strengthen governance in response to political upheaval and economic issues.</data>
      <data key="d1">UNKNOWN</data>
      <data key="d4">dumps/World_History_Volume_1/pages_content.json</data>
      <data key="d5">1783203325</data>
