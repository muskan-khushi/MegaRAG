    </edge>
    <edge source="Red Palace" target="San Lorenzo (Site)">
      <data key="d6">10.0</data>
      <data key="d7">The Red Palace is a notable artifact at San Lorenzo and was likely constructed during the early stages of Olmec civilization.</data>
      <data key="d8">architecture_projects,monumental_architecture</data>
      <data key="d9">chunk-08fb9bfb38f84b34683dfd75182299f8</data>
