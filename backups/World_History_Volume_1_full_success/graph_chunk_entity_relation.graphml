    <edge source="Trade" target="Seals">
      <data key="d6">18.0</data>
      <data key="d7">"Seals were used to mark goods during trade, providing a tangible link between the economic activities of the Indus Valley Civilization and Mesopotamia."]</data>
      <data key="d8">9</data>
      <data key="d9">chunk-756f0b26d168efc2bc1d5ec8a2aa2219</data>
