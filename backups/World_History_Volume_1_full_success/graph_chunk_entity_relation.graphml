    <node id="UN Universal Declaration of Human Rights">
      <data key="d0">UN Universal Declaration of Human Rights</data>
      <data key="d1">historical_concept_or_event</data>
      <data key="d2">The United Nations Universal Declaration of Human Rights was a milestone document adopted by the UN General Assembly in 1948, outlining fundamental human rights and freedoms that should be shared universally. Eleanor Roosevelt played a crucial role in its drafting.</data>
      <data key="d3">chunk-edce8753200bddb9b544580a04219fa4</data>
