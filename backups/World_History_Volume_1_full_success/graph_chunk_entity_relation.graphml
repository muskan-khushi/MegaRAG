    <node id="&lt;&quot;Mesopotamia&quot;&gt;">
      <data key="d0">&lt;"Mesopotamia"&gt;</data>
      <data key="d1">&lt;geographical_location&gt;</data>
      <data key="d2">&lt;"An historical region located between the Tigris and Euphrates rivers, encompassing parts of modern-day Iraq and neighboring areas. It is known for its early civilizations and development of writing systems."&gt;</data>
