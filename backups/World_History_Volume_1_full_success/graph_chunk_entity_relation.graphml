      <data key="d0">&lt;"Hadith Transmission"</data>
      <data key="d1">&lt;"historical_concept_or_event</data>
      <data key="d2">&lt;Entity_description: The process by which religious texts and oral traditions were passed on. Aisha bint Abu Bakr was known for her role in early Islamic discussions about the authenticity of hadith during the Rashidun Caliphate.</data>
      <data key="d3">chunk-eca248d7090f58e7e1c63a9bfb407080</data>
      <data key="d4">dumps/World_History_Volume_1/pages_content.json</data>
