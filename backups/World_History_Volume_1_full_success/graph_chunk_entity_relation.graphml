    <node id="Malikite legalism">
      <data key="d0">Malikite legalism</data>
      <data key="d1">cultural legacy</data>
      <data key="d2">Malikite legalism, a form of jurisprudence based on Malik ibn Anas' teachings, was central to Almohad ideology. This approach to Islamic law emphasized strict adherence and consistency with traditional principles.</data>
      <data key="d3">chunk-5f105692039d53c800b15e8de2086313</data>
      <data key="d4">dumps/World_History_Volume_1/pages_content.json</data>
      <data key="d5">1783211011</data>
    </node>
