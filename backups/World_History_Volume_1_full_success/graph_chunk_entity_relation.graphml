    <node id="Carolingian Empire' ">
      <data key="d0">Carolingian Empire' </data>
      <data key="d1">geographical_location_and_historical_figure_or_group</data>
      <data key="d2">Questions about which empire feudalism developed after refer to this empire.</data>
