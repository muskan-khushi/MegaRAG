    <node id="&quot;Venus von Willendorf&quot;|&gt;">
      <data key="d0">"Venus von Willendorf"|&gt;</data>
      <data key="d1">historical_artifact"|&gt;</data>
      <data key="d2">"The Venus von Willendorf is a notable example of a prehistoric female figurine, an early form of fired-clay sculpture dating back to around 28,000-25,000 BCE. It was discovered in modern-day Austria (near Willendorf), reflecting the artistic and symbolic expressions of the Danubian Neolithic culture."|&gt;</data>
      <data key="d3">chunk-8a7ed9ed426c677dfb751ca0d0f6c66e</data>
      <data key="d4">dumps/World_History_Volume_1/pages_content.json</data>
      <data key="d5">1783210800</data>
    </node>
    <node id="&quot;Venus of Dolní Věstonice&quot;|&gt;">
      <data key="d0">"Venus of Dolní Věstonice"|&gt;</data>
      <data key="d1">historical_artifact"|&gt;</data>
      <data key="d2">"The Venus of Dolní Věstonice is a significant early example of a fired-clay sculpture, estimated to be around 29,000 years old. It was found in the Czech Republic and likely represents symbols and cultural practices of prehistoric societies."|&gt;</data>
      <data key="d3">chunk-8a7ed9ed426c677dfb751ca0d0f6c66e</data>
      <data key="d4">dumps/World_History_Volume_1/pages_content.json</data>
      <data key="d5">1783210800</data>
    </node>
    <node id="&quot;Venus figurines&quot;|&gt;">
      <data key="d0">"Venus figurines"|&gt;</data>
      <data key="d1">historical_concept_or_event"|&gt;</data>
      <data key="d2">"The Venus figurines are a group of small, portable terracotta statues primarily characterized by exaggerated female forms, representing a widespread cultural or religious movement across Europe and central Russia during the Palaeolithic period."|&gt;</data>
      <data key="d3">chunk-8a7ed9ed426c677dfb751ca0d0f6c66e</data>
      <data key="d4">dumps/World_History_Volume_1/pages_content.json</data>
      <data key="d5">1783210800</data>
    </node>
    <node id="&quot;Ceramic Artifacts&quot;|&gt;">
      <data key="d0">"Ceramic Artifacts"|&gt;</data>
      <data key="d1">source_or_artifact"|&gt;</data>
      <data key="d2">"Ceramic artifacts such as the Venus of Dolní Věstonice are integral to understanding prehistoric culture, providing insights into the social and religious practices of early human societies."|&gt;</data>
      <data key="d3">chunk-8a7ed9ed426c677dfb751ca0d0f6c66e</data>
      <data key="d4">dumps/World_History_Volume_1/pages_content.json</data>
      <data key="d5">1783210800</data>
    </node>
