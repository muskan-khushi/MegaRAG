      <data key="d11">1783211061</data>
    </edge>
    <edge source="Egyptian Sculpture" target="Greek marble statue">
      <data key="d6">6.0</data>
      <data key="d7">The Greek marble statue resembles Egyptian artistic conventions in its pose and stance, showing how Egyptian influences permeated Greek art during the Classical period.</data>
      <data key="d8">Artistic Influence,Pose Similarity</data>
      <data key="d9">chunk-92db262d76cb92ec5e196188c5a0fba7</data>
      <data key="d10">dumps/World_History_Volume_1/pages_content.json</data>
