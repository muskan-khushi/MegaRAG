      <data key="d4">dumps/World_History_Volume_1/pages_content.json</data>
      <data key="d5">1783210817</data>
    </node>
    <node id="Stele of Hammurabi ">
      <data key="d0">Stele of Hammurabi </data>
      <data key="d1">source_or_artifact</data>
      <data key="d2">The Stele of Hammurabi features an engraving of Hammurabi and details of his code, offering valuable insights into ancient Babylonian legal systems.</data>
      <data key="d3">chunk-37a92110d64655a1b7585b3fb61d29b5</data>
      <data key="d4">dumps/World_History_Volume_1/pages_content.json</data>
