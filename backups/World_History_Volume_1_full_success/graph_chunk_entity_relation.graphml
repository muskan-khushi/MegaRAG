    <node id="&lt;Jericho&gt;">
      <data key="d0">&lt;Jericho&gt;</data>
      <data key="d1">&lt;geographical_location&gt;</data>
      <data key="d2">Jericho is an ancient Neolithic settlement that predates Çatalhöyük in terms of occupation dates. Located to the south of Çatalhöyük, it is known for its early agricultural practices and permanent settlement formation. Jericho shares some similar practices with Çatalhöyük but stands out due to its earlier establishment as a settlement.</data>
      <data key="d3">chunk-dbfe0b8551a1c1ccdee815dd5bff6442</data>
      <data key="d4">dumps/World_History_Volume_1/pages_content.json</data>
      <data key="d5">1783210809</data>
    </node>
