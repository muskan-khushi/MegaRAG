    </node>
    <node id="Praefectus Annonae">
      <data key="d0">Praefectus Annonae</data>
      <data key="d1">historical_figure</data>
      <data key="d2">The prefect who managed the distribution process under the 'Annona', oversaw ports, addressed fraud in markets, and secured grain supply contracts with suppliers.</data>
      <data key="d3">chunk-26ccbf3441b6b8fad246e6cd56535b53</data>
