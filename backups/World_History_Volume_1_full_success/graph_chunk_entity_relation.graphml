      <data key="d0">&lt;"Sasanian Persia/</data>
      <data key="d1">&lt;"civilization_or_empire</data>
      <data key="d2">&lt;"An ancient civilization known for its influential culture and powerful emperors. It interacted with early Islamic states through various cultural and political exchanges."</data>
      <data key="d3">chunk-acb0a07de6465f61f482a035df463ed8</data>
      <data key="d4">dumps/World_History_Volume_1/pages_content.json</data>
