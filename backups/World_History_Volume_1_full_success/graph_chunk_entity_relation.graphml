      <data key="d5">1783210775</data>
    </node>
    <node id="The Near East">
      <data key="d0">The Near East</data>
      <data key="d1">geographical_location</data>
      <data key="d2">The Near East is an overarching region that spans various territories and cultures from ancient times to the present, including but not limited to modern-day Turkey, Lebanon, Israel, Jordan, Syria, Iraq, and parts of Iran and Egypt. This area's history encompasses significant regions such as Mesopotamia, Egypt, and Persia, highlighting its rich and diverse cultural heritage throughout millennia.</data>
      <data key="d3">chunk-7e64e2403dd590a083e0fbec3e790668&lt;SEP&gt;chunk-b8d6d7a01f04863f017d0ad8ee1b4e77</data>
