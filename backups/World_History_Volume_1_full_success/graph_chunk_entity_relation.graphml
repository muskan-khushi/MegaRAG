    <node id="&lt;&quot;hadith&quot;">
      <data key="d0">&lt;"hadith"</data>
      <data key="d1">&lt;"source_or_artifact</data>
      <data key="d2">&lt;Entity_description: Religious texts and traditions that contain sayings, deeds, approvals, or characteristics of Muhammad. During the Rashidun Caliphate, hadith were crucial for the interpretation and codification of religious law and legal principles.</data>
      <data key="d3">chunk-eca248d7090f58e7e1c63a9bfb407080</data>
      <data key="d4">dumps/World_History_Volume_1/pages_content.json</data>
