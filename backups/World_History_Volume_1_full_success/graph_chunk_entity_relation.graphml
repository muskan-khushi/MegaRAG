    <node id="&lt;&quot;surprise offensive&quot;&gt;">
      <data key="d0">&lt;"surprise offensive"&gt;</data>
      <data key="d1">&lt;historical_concept_or_event&gt;</data>
      <data key="d2">&lt;"The surprise offensive is a term used by Roosevelt to describe Japan's attack on Pearl Harbor. It captures the element of stealth and aggression employed by Japan, which caught the United States unprepared."&gt;</data>
      <data key="d3">chunk-22e11e00c89a73ab13d5224fcee3fd78</data>
      <data key="d4">dumps/World_History_Volume_1/pages_content.json</data>
