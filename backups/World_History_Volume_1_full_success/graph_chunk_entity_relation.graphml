    <node id="Military Techniques">
      <data key="d0">Military Techniques</data>
      <data key="d1">historical_concept_or_event</data>
      <data key="d2">During the Second Intermediate Period, military techniques were introduced by the Hyksos to ancient Egypt, significantly impacting its warfare methods.</data>
      <data key="d3">chunk-01819cdf305281e0ef22ba7cb3469e6a</data>
      <data key="d4">dumps/World_History_Volume_1/pages_content.json</data>
