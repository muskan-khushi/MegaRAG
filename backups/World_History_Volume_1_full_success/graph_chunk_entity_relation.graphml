    </edge>
    <edge source="&lt;historical_figure&gt;" target="&lt;textbook_structure&gt;">
      <data key="d6">3.0</data>
      <data key="d7">Textbook structure highlights key figures such as Octavian and his consolidation of power through Senate appointments and titles, which were directly related to historical events like the division of Rome.</data>
      <data key="d8">structure_focus</data>
      <data key="d9">chunk-5914a1bc816edf3338d898be6d68146b</data>
      <data key="d10">dumps/World_History_Volume_1/pages_content.json</data>
