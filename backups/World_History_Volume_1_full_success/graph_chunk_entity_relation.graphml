    </node>
    <node id="&lt;Xi Xia lands&gt;">
      <data key="d0">&lt;Xi Xia lands&gt;</data>
      <data key="d1">&lt;civilization_or_empire&gt;</data>
      <data key="d2">&lt;The Xi Xia (Western Xia) was a Chinese Western Xia state, which existed from 1038 to 1227 as a buffer between the Tangut nation and Mongol invasions during Chinggis Khan’s time.&gt;</data>
      <data key="d3">chunk-4e57e6349a7929fcf289f8da82a3abde</data>
      <data key="d4">dumps/World_History_Volume_1/pages_content.json</data>
