      <data key="d0">Kouroi</data>
      <data key="d1">source_or_artifact</data>
      <data key="d2">Carving of nude youths in ancient Greece, often used in religious sanctuaries, reflecting artistic influences from Egypt and Phoenicia during the Archaic period.</data>
      <data key="d3">chunk-d1b923a222fa396828cfac46f7a026c9</data>
