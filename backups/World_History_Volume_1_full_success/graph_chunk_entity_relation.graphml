    <node id="Babylonian exile and Judean faith">
      <data key="d0">Babylonian exile and Judean faith</data>
      <data key="d1">historical_concept_or_event</data>
      <data key="d2">"The Babylonian Exile (586-539 BCE</data>
      <data key="d3">chunk-1c3a04d4279b2edc62cc6c6bab3d7235</data>
