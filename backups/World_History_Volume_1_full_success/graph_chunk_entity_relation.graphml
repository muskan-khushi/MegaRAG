      <data key="d0">Indian Ocean World</data>
      <data key="d1">geographical_location</data>
      <data key="d2">The Indian Ocean World was crucial in early medieval interactions and commerce between East and West.</data>
      <data key="d3">chunk-c13c9d68535c84e9a2084524eeed3c86</data>
      <data key="d4">dumps/World_History_Volume_1/pages_content.json</data>
