      <data key="d0">Hyksos migrations</data>
      <data key="d1">historical_concept_or_event</data>
      <data key="d2">The movement of people from Asia into Egypt and other parts of the Bronze Age Near East, leading to cultural exchange and conflict.</data>
      <data key="d3">chunk-722b57dcb585512b05d668236596f71a</data>
      <data key="d4">dumps/World_History_Volume_1/pages_content.json</data>
