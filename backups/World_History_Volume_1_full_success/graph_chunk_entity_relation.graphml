    </edge>
    <edge source="&lt;historical_figure&gt;" target="&lt;historical_concept_or_event&gt;">
      <data key="d6">5.0</data>
      <data key="d7">Historical figures had pivotal roles in shaping historical concepts and events, such as Octavian's rise to power through military campaigns and political maneuvers like the division of Rome.</data>
      <data key="d8">figure_influence</data>
      <data key="d9">chunk-5914a1bc816edf3338d898be6d68146b</data>
      <data key="d10">dumps/World_History_Volume_1/pages_content.json</data>
