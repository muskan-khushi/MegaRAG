      <data key="d0">Wine and Olive Oil Trade</data>
      <data key="d1">historical_concept_or_event</data>
      <data key="d2">Trade in wine and olive oil played significant roles in Roman commerce, particularly to regions like Greece and Gaul; trade goods were often shipped in amphorae.</data>
      <data key="d3">chunk-26ccbf3441b6b8fad246e6cd56535b53</data>
      <data key="d4">dumps/World_History_Volume_1/pages_content.json</data>
