    <node id="Thutmose III">
      <data key="d0">Thutmose III</data>
      <data key="d1">historical_figure</data>
      <data key="d2">The second pharaoh of the 18th Dynasty, who succeeded Hatshepsut and played crucial roles in military campaigns and political reforms.</data>
