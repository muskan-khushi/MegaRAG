      <data key="d0">&lt;"Akhetaten"</data>
      <data key="d1">&lt;"geographical_location</data>
      <data key="d2">&lt;"Akhetaten was an alternative name for Amarna used in ancient Egyptian texts, signifying its status as the newly designated religious and political capital by Akhenaten."&lt;|</data>
      <data key="d3">chunk-e99b695e71f9120e8fa39e113560a3bc</data>
      <data key="d4">dumps/World_History_Volume_1/pages_content.json</data>
