    <node id="The Eastward Shift">
      <data key="d0">The Eastward Shift</data>
      <data key="d1">historical_event</data>
      <data key="d2">The Eastward Shift event depicts the geographical and cultural shift towards Eastern civilizations.</data>
      <data key="d3">chunk-c13c9d68535c84e9a2084524eeed3c86</data>
      <data key="d4">dumps/World_History_Volume_1/pages_content.json</data>
