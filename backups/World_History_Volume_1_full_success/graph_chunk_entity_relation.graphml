    </node>
    <node id="Mongol Conquests">
      <data key="d0">Mongol Conquests</data>
      <data key="d1">historical_event</data>
      <data key="d2">The Mongol Conquests refer to the vast military campaigns and territorial expansions conducted by the Mongols during the thirteenth century, encompassing China and other regions. These conquests significantly altered the political landscape of Asia through warfare, diplomacy, and administrative reforms.</data>
      <data key="d3">chunk-dfd43568e4817f7de7fa5fd0bbb3f2e0</data>
      <data key="d4">dumps/World_History_Volume_1/pages_content.json</data>
      <data key="d5">1783211012</data>
    </node>
