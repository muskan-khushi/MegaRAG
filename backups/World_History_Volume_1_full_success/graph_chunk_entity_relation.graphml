    <node id="Olmec Civilization">
      <data key="d0">Olmec Civilization</data>
      <data key="d1">civilization_or_empire</data>
      <data key="d2">The Olmec civilization is recognized as Mesoamerica’s first complex culture, emerging around 1350 BCE with significant architectural works such as ceremonial structures, water reservoirs, stone art, and massive stone heads.</data>
      <data key="d3">chunk-08fb9bfb38f84b34683dfd75182299f8</data>
      <data key="d4">dumps/World_History_Volume_1/pages_content.json</data>
