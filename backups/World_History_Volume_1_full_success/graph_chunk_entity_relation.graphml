    <edge source="Byzantine Empire" target="Constantinople">
      <data key="d6">14.0</data>
      <data key="d7">As a significant city in the Byzantine Empire, Constantinople faced a challenge from within its own civilization represented by Władysław III.</data>
      <data key="d8">conflict,internal-external</data>
