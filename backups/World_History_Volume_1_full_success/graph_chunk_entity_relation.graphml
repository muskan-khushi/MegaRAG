    </edge>
    <edge source="Bantu Migrations" target="Sangha River Interval">
      <data key="d6">12.0</data>
      <data key="d7">The Sangha River Interval was a key geographical location that facilitated the southward movement of Bantu speakers during their migrations.</data>
      <data key="d8">migration_pathways</data>
