    <node id="Gaya confederacy">
      <data key="d0">Gaya confederacy</data>
      <data key="d1">civilization_or_empire</data>
      <data key="d2">The Gaya confederacy existed from 42 to 532 CE and was eventually absorbed by the kingdom of Silla during the Three Kingdoms period.</data>
