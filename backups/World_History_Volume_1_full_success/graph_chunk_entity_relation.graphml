      <data key="d0">Palace of Heavenly Purity</data>
      <data key="d1">cultural_or_religious_movement</data>
      <data key="d2">The Palace of Heavenly Purity was the main residence of the emperor during the Ming dynasty, reflecting the cultural and religious importance within the imperial court.</data>
      <data key="d3">chunk-c01365a1973af158b0d688c24d6fe6d2</data>
      <data key="d4">dumps/World_History_Volume_1/pages_content.json</data>
      <data key="d5">1783211033</data>
    </node>
    <node id="Palace of Earthly Tranquility">
      <data key="d0">Palace of Earthly Tranquility</data>
      <data key="d1">cultural_or_religious_movement</data>
      <data key="d2">The Palace of Earthly Tranquility served as the residence for the empress near the Forbidden City, indicating a balance in traditional societal values and roles.</data>
      <data key="d3">chunk-c01365a1973af158b0d688c24d6fe6d2</data>
      <data key="d4">dumps/World_History_Volume_1/pages_content.json</data>
      <data key="d5">1783211033</data>
    </node>
