    </edge>
    <edge source="The Arnolfini Portrait" target="wealthy people">
      <data key="d6">16.0</data>
      <data key="d7">"Various elements in the painting suggest that the Arnolfinis were wealthy, such as the richly decorated room, expensive clothing, and the presence of a chandelier, all of which indicate their socio-economic status."/&gt;</data>
      <data key="d8">8</data>
      <data key="d9">chunk-39f50645a1a52a72b5d8d61856942487</data>
      <data key="d10">dumps/World_History_Volume_1/pages_content.json</data>
      <data key="d11">1783211101</data>
    </edge>
    <edge source="The Arnolfini Portrait" target="humanism">
      <data key="d6">14.0</data>
      <data key="d7">"The painting may reflect humanist values through its focus on realism and detail, potentially depicting the couple in an intimate setting as well as highlighting artifacts that signify their social standing."/&gt;</data>
      <data key="d8">7</data>
      <data key="d9">chunk-39f50645a1a52a72b5d8d61856942487</data>
      <data key="d10">dumps/World_History_Volume_1/pages_content.json</data>
      <data key="d11">1783211101</data>
    </edge>
