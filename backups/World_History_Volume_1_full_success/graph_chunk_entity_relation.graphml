      <data key="d1">&lt;"historical_figure</data>
      <data key="d2">&lt;"Amenhotep IV is known for his later shift to the worship of the Aten, a sun disk god, which led to the establishment of the cult and city of Akhetaten (Amarna) under the name Akhenaten."&lt;|</data>
      <data key="d3">chunk-e99b695e71f9120e8fa39e113560a3bc</data>
