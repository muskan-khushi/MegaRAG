    </node>
    <node id="&lt;Bronze Age&gt;">
      <data key="d0">&lt;Bronze Age&gt;</data>
      <data key="d1">time_period</data>
      <data key="d2">From 3500 to 1110 BCE, characterized by the use of bronze for tools and weapons.</data>
      <data key="d3">chunk-bacddcb0411fbd18f80694e00c36c414</data>
