    <node id="The Arch of Constantine in Rome">
      <data key="d0">The Arch of Constantine in Rome</data>
      <data key="d1">source_or_artifact</data>
      <data key="d2">The source or artifact, The Arch of Constantine, is described and its dedication date.</data>
