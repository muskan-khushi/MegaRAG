    </node>
    <node id="&lt;entity_name&gt;Rome">
      <data key="d0">&lt;entity_name&gt;Rome</data>
      <data key="d1">&lt;entity_type&gt;geographical_location</data>
      <data key="d2">&lt;entity_description&gt;The capital city of the Roman Empire and a pivotal center for culture, politics, and administration.&gt;</data>
      <data key="d3">chunk-35dabc1121dedf5713913da08d2b42e7</data>
