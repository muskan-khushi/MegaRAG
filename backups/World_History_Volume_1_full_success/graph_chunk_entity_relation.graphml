    </edge>
    <edge source="Galileo Galilei" target="Heliocentric Universe">
      <data key="d6">18.0</data>
      <data key="d7">Galileo Galilei supported and helped popularize the heliocentric model of the universe with his observational evidence and improvements in telescope technology.</data>
      <data key="d8">Support and Popularization</data>
      <data key="d9">chunk-6472411bb2f04035fe16270eda293c74</data>
      <data key="d10">dumps/World_History_Volume_1/pages_content.json</data>
      <data key="d11">1783211101</data>
    </edge>
    <edge source="Heliocentric Universe" target="&quot;Copernicus'">
      <data key="d6">20.0</data>
      <data key="d7">Nicolaus Copernicus proposed and described the heliocentric model of the universe through his work 'De revolutionibus orbium coelestium'.</data>
      <data key="d8">Proposed Model</data>
      <data key="d9">chunk-6472411bb2f04035fe16270eda293c74</data>
      <data key="d10">dumps/World_History_Volume_1/pages_content.json</data>
      <data key="d11">1783211101</data>
    </edge>
    <edge source="13th Century" target="Mamluk Sultanate">
      <data key="d6">10.0</data>
      <data key="d7">The Mamluk Sultanate originated during the 13th century, indicating its existence from this time period.</data>
      <data key="d8">establishment,inception</data>
