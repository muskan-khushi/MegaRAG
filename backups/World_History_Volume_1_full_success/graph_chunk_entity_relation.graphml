    </node>
    <node id="Yuan Dynasty">
      <data key="d0">Yuan Dynasty</data>
      <data key="d1">civilization_or_empire</data>
      <data key="d2">The Yuan Dynasty was established by Kublai Khan as an empire that included both China and other conquered territories, marking a significant era in Chinese history.</data>
      <data key="d3">chunk-dfd43568e4817f7de7fa5fd0bbb3f2e0</data>
      <data key="d4">dumps/World_History_Volume_1/pages_content.json</data>
      <data key="d5">1783211012</data>
    </node>
    <node id="Paper Money">
      <data key="d0">Paper Money</data>
      <data key="d1">textbook_structure</data>
      <data key="d2">Paper money was an innovation introduced during the Yuan dynasty to expand economic activities and facilitate trade within the empire.</data>
      <data key="d3">chunk-dfd43568e4817f7de7fa5fd0bbb3f2e0</data>
      <data key="d4">dumps/World_History_Volume_1/pages_content.json</data>
      <data key="d5">1783211012</data>
    </node>
    <node id="Urban Areas">
      <data key="d0">Urban Areas</data>
      <data key="d1">cultural_or_religious_movement</data>
      <data key="d2">Urban areas in Yuan China were characterized by ethnic and religious diversity, fostering a cosmopolitan spirit under Mongol rule.</data>
      <data key="d3">chunk-dfd43568e4817f7de7fa5fd0bbb3f2e0</data>
      <data key="d4">dumps/World_History_Volume_1/pages_content.json</data>
