    <node id="&lt;&quot;Umayyad Dynasty&quot;">
      <data key="d0">&lt;"Umayyad Dynasty"</data>
      <data key="d1">&lt;"civilization_or_empire</data>
      <data key="d2">&lt;Entity_description: A hereditary Muslim dynasty that succeeded the Rashidun period from 661-750 CE. The Umayyads established their capital in Damascus, expanded Islamic influence through conquests and centralized rule, and faced both internal conflicts and external challenges.</data>
      <data key="d3">chunk-eca248d7090f58e7e1c63a9bfb407080</data>
      <data key="d4">dumps/World_History_Volume_1/pages_content.json</data>
