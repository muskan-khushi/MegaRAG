    </node>
    <node id="Rigveda">
      <data key="d0">Rigveda</data>
      <data key="d1">source_or_artifact</data>
      <data key="d2">A religious text or source originating from the Indo-European group, dated between 1500 and 1000 BCE, containing hymns, rituals, descriptions of deities, and other topics with a focus on divine nature.</data>
      <data key="d3">chunk-eda2368f7c0ef00cbce121f87fbbdaa1</data>
      <data key="d4">dumps/World_History_Volume_1/pages_content.json</data>
