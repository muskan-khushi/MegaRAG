    <node id="Roman Military Commanders">
      <data key="d0">Roman Military Commanders</data>
      <data key="d1">historical_figure</data>
      <data key="d2">Historical figures such as Stilicho, a Roman commander of Vandal origin who served as guardian to Emperor Honorius and sought control over the western empire, are notable during this period.</data>
      <data key="d3">chunk-e8b93582db5d7a873cf44814a77997d9</data>
      <data key="d4">dumps/World_History_Volume_1/pages_content.json</data>
