      <data key="d11">1783211050</data>
    </edge>
    <edge source="Climate Change" target="Pastoralism">
      <data key="d6">10.0</data>
      <data key="d7">Climate change influenced the practice of pastoralism by changing pasture availability and necessitating adaptation among herding communities.</data>
      <data key="d8">Environmental Adaptation</data>
