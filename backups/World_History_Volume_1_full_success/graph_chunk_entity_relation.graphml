    <node id="Israelites">
      <data key="d0">Israelites</data>
      <data key="d1">civilization_or_empire</data>
      <data key="d2">The Israelites are described as a group with roots in Jewish and Christian traditions, linked to the figure of Abraham.</data>
      <data key="d3">chunk-7114383587a4baf0af7064a88a7b0f99</data>
