    <node id="Lower Egypt">
      <data key="d0">Lower Egypt</data>
      <data key="d1">geographical_location</data>
      <data key="d2">Lower Egypt refers to the northern part of ancient Egypt and was controlled by Hyksos during much of the Second Intermediate Period.</data>
      <data key="d3">chunk-01819cdf305281e0ef22ba7cb3469e6a</data>
      <data key="d4">dumps/World_History_Volume_1/pages_content.json</data>
