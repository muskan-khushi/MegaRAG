    <node id="The Code of Justinian">
      <data key="d0">The Code of Justinian</data>
      <data key="d1">source_or_artifact</data>
      <data key="d2">The Code of Justinian is the legal document compiled by Justinian to address inconsistencies in imperial edicts since the early second century.</data>
      <data key="d3">chunk-622311a2741b1845b3a8c00c6e5d7b93</data>
