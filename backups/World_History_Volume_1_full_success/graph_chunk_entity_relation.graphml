    <node id="&lt;&quot;fourth and fifth centuries CE&quot;">
      <data key="d0">&lt;"fourth and fifth centuries CE"</data>
      <data key="d1">&lt;time_period</data>
      <data key="d2">&lt;"The period spanning from the 4th to the 5th centuries AD, marked by significant political, social, and economic changes in North Africa, including barbarian incursions and invasions."|</data>
      <data key="d3">chunk-a8af48913c15cba43ba646a75127490d</data>
