    <edge source="Nazca culture" target="Chavín area">
      <data key="d6">8.0</data>
      <data key="d7">The Chavín area exerted an influence on the Nazca culture in terms of artistic styles and religious practices.</data>
      <data key="d8">cultural diffusion</data>
      <data key="d9">chunk-71f7f5f2f0b6e70e490afffdd36ed2fe</data>
