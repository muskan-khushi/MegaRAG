    <edge source="Uruk" target="population_estimate">
      <data key="d6">16.0</data>
      <data key="d7">The population estimate for Uruk was around 20,000 people.</data>
      <data key="d8">demographic_information</data>
      <data key="d9">chunk-c204cf87ddccb43d29862abf65e2506f</data>
