      <data key="d1">historical_figure</data>
      <data key="d2">This refers to individuals from lower castes converting to Islam under the Delhi Sultanate, an event that reshaped social dynamics and religious demographics during the late 13th to early 14th centuries.</data>
      <data key="d3">chunk-7083273cf1feba343b800d63e994ddde</data>
      <data key="d4">dumps/World_History_Volume_1/pages_content.json</data>
      <data key="d5">1783211001</data>
