    </node>
    <node id="Art and Architecture">
      <data key="d0">Art and Architecture</data>
      <data key="d1">historical_concept_or_event</data>
      <data key="d2">The New Kingdom period saw significant advancements in art and architecture. Pharaohs like Ahmose contributed to these developments.</data>
      <data key="d3">chunk-01819cdf305281e0ef22ba7cb3469e6a</data>
      <data key="d4">dumps/World_History_Volume_1/pages_content.json</data>
