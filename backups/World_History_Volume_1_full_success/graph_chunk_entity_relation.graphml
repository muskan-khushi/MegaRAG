    <node id="Warring States period">
      <data key="d0">Warring States period</data>
      <data key="d1">time_period</data>
      <data key="d2">The Warring States period is a significant era in Chinese history characterized by intense political and military competition among various warring states. This period saw significant advancements in philosophy, including Confucianism and Legalism, and cultural shifts.</data>
      <data key="d3">chunk-92d40e92f75ab6af9420387ca6d2a691</data>
      <data key="d4">dumps/World_History_Volume_1/pages_content.json</data>
      <data key="d5">1783210870</data>
    </node>
