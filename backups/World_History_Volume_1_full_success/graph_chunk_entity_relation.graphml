    <node id="&lt;&quot;cultural legacy of the Mongols&quot;&gt;">
      <data key="d0">&lt;"cultural legacy of the Mongols"&gt;</data>
      <data key="d1">&lt;historical_figure&gt;</data>
      <data key="d2">&lt;"The legacy of the Mongol Empire spans across multiple cultures and continues to influence political landscapes in various regions."&gt;</data>
      <data key="d3">chunk-405d14b235f769c3d78504b096eb8659</data>
