    </node>
    <node id="Theodosian Code">
      <data key="d0">Theodosian Code</data>
      <data key="d1">textbook_structure</data>
      <data key="d2">Theodosian Code is a previous set of laws that predates the Code of Justinian, which addressed inconsistencies in imperial edicts.</data>
      <data key="d3">chunk-622311a2741b1845b3a8c00c6e5d7b93</data>
      <data key="d4">dumps/World_History_Volume_1/pages_content.json</data>
