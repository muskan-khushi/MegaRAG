      <data key="d0">&lt;"479 BCE"</data>
      <data key="d1">&lt;time_period</data>
      <data key="d2">&lt;"A pivotal year in Ancient Greek history marking the end of the Persian Wars and the subsequent Athenian Empire's growth."</data>
      <data key="d3">chunk-2950474ba33f47bb39e303f028b2774e</data>
