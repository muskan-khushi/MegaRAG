    </edge>
    <edge source="Third Millennium BCE" target="Clovis People">
      <data key="d6">8.0</data>
      <data key="d7">The Clovis people represent one of the earliest known cultures associated with hunter-gatherer practices during the third millennium BCE, providing context for later agricultural developments in North America.</data>
      <data key="d8">agriculture,hunter-gatherer</data>
