    <edge source="&lt;&quot;Early Horizon (or Formative period)&quot;&gt;" target="&lt;&quot;Chavín culture&quot;">
      <data key="d6">2.0</data>
      <data key="d7">&lt;"Chavín culture started the Early Horizon or Formative period by expanding across the Andes region."&gt;</data>
