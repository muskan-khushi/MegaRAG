    </node>
    <node id="Indo-European Works">
      <data key="d0">Indo-European Works</data>
      <data key="d1">textbook_structure</data>
      <data key="d2">Texts from Indo-European origin that include works like the Rigveda, produced between 1500 and 1000 BCE, which discusses religious topics and the arrival of Aryans.</data>
      <data key="d3">chunk-eda2368f7c0ef00cbce121f87fbbdaa1</data>
      <data key="d4">dumps/World_History_Volume_1/pages_content.json</data>
