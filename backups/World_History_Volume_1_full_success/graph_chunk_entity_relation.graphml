    <node id="imperial edicts">
      <data key="d0">imperial edicts</data>
      <data key="d1">source_or_artifact</data>
      <data key="d2">Imperial edicts are legal documents issued by the emperor that were regulated according to The Code of Justinian.</data>
      <data key="d3">chunk-622311a2741b1845b3a8c00c6e5d7b93</data>
      <data key="d4">dumps/World_History_Volume_1/pages_content.json</data>
