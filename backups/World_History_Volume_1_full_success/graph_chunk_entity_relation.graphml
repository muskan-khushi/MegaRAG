    </node>
    <node id="&quot;1400 BCE&quot;">
      <data key="d0">"1400 BCE"</data>
      <data key="d1">time_period</data>
      <data key="d2">A time period during which important historical events took place in the Near East, highlighted by the construction and significance of Persepolis.</data>
