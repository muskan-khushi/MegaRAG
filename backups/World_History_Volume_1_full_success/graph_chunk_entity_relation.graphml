      <data key="d1">historical_concept_or_event</data>
      <data key="d2">The Hall of Supreme Harmony is an important structure where the emperor held court during the Ming dynasty, symbolizing power and imperial majesty.</data>
      <data key="d3">chunk-c01365a1973af158b0d688c24d6fe6d2</data>
