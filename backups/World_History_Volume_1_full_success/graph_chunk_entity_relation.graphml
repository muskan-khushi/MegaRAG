      <data key="d0">&lt;"Twelve Tribes of Israel"</data>
      <data key="d1">&lt;"historical_concept_or_event"&gt;</data>
      <data key="d2">&lt;"A collective group descended from Jacob's twelve sons, central to Jewish religious and cultural identity."</data>
      <data key="d3">chunk-39ae02e5e637fac459bc83d51db22137</data>
      <data key="d4">dumps/World_History_Volume_1/pages_content.json</data>
