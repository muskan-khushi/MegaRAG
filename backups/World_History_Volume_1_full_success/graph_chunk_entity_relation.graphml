    <node id="Arabian Peninsula">
      <data key="d0">Arabian Peninsula</data>
      <data key="d1">geographical_location</data>
      <data key="d2">The Arabian Peninsula is a significant geopolitical and historical region located southwest of the Arabian Sea, positioned to the east of Egypt and Libya, and south of Syria and Iraq. This diverse area has been home to various tribes and historical empires, serving as an important origin for Islamic conquests throughout history.</data>
      <data key="d3">chunk-3047d60403fb89082b52beb809b2b4c2&lt;SEP&gt;chunk-70d03803311b31d7e11f7ace07e0a57f</data>
      <data key="d4">dumps/World_History_Volume_1/pages_content.json</data>
      <data key="d5">1783210963</data>
    </node>
    <node id="Bedouin">
      <data key="d0">Bedouin</data>
      <data key="d1">civilization_or_empire</data>
      <data key="d2">Bedouin are nomadic Arab tribes that existed on the Arabian Peninsula during the 7th century, often practicing animal herding and raiding trade caravans or settled communities.</data>
      <data key="d3">chunk-3047d60403fb89082b52beb809b2b4c2</data>
