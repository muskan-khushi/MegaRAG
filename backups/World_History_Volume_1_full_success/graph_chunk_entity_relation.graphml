    </node>
    <node id="Hammurabi ">
      <data key="d0">Hammurabi </data>
      <data key="d1">historical_figure</data>
      <data key="d2">Hammurabi was the sixth king of Babylon who ruled from c. 1792 BC to c. 1750 BC, during which time he established his well-known code of laws.</data>
      <data key="d3">chunk-37a92110d64655a1b7585b3fb61d29b5</data>
      <data key="d4">dumps/World_History_Volume_1/pages_content.json</data>
      <data key="d5">1783210817</data>
    </node>
