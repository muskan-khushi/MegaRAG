    </edge>
    <edge source="Timur" target="defeated_Tokhtamish">
      <data key="d6">18.0</data>
      <data key="d7">"After defeating Tokhtamish's army in 1391, Timur expanded his control over central Asia.")</data>
      <data key="d8">military_success</data>
