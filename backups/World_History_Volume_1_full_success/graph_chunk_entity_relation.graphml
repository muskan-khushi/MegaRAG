    <edge source="&lt;Temple of Isis&gt;" target="&lt;Isis Worship&gt;">
      <data key="d6">6.0</data>
      <data key="d7">The Temple of Isis hosted rituals and gatherings that integrated foreign practices, including Isis worship, into Roman civic life.</data>
      <data key="d8">Public religious integration</data>
      <data key="d9">chunk-a1a606296ab27c5dc7d129e54471d9c8</data>
      <data key="d10">dumps/World_History_Volume_1/pages_content.json</data>
      <data key="d11">1783211064</data>
    </edge>
    <edge source="&lt;Temple of Isis&gt;" target="&lt;Roman Society&gt;">
      <data key="d6">8.0</data>
      <data key="d7">The Temple of Isis was a significant part of Roman society, fostering communal activities and integrating diverse religious groups within it.</data>
      <data key="d8">Religious diversity in public space</data>
      <data key="d9">chunk-a1a606296ab27c5dc7d129e54471d9c8</data>
      <data key="d10">dumps/World_History_Volume_1/pages_content.json</data>
      <data key="d11">1783211064</data>
    </edge>
    <edge source="&lt;Nero's Persecution (64 CE, 68-69 CE)&gt;" target="&lt;Perpetua's Martyrdom&gt;">
      <data key="d6">10.0</data>
      <data key="d7">Recorded during Nero’s reign, Perpetua’s martyrdom is a direct result of the persecution policies initiated by Emperor Nero.</data>
      <data key="d8">Historical context</data>
      <data key="d9">chunk-a1a606296ab27c5dc7d129e54471d9c8</data>
      <data key="d10">dumps/World_History_Volume_1/pages_content.json</data>
      <data key="d11">1783211064</data>
    </edge>
    <edge source="&lt;Caracalla's Edict (212 CE)&gt;" target="&lt;Persecution Policies&gt;">
      <data key="d6">6.0</data>
      <data key="d7">Extended Roman citizenship with responsibilities like state sacrifices, indirectly affecting Christian communities through imperial policies.</data>
      <data key="d8">Imperial policy impact</data>
      <data key="d9">chunk-a1a606296ab27c5dc7d129e54471d9c8</data>
      <data key="d10">dumps/World_History_Volume_1/pages_content.json</data>
      <data key="d11">1783211064</data>
    </edge>
    <edge source="&lt;Decius' Edict (250 CE)&gt;" target="&lt;Persecution Policies&gt;">
      <data key="d6">8.0</data>
      <data key="d7">Issued to enforce uniform religious practices and loyalty to the emperor, leading to persecutions of Christians.</data>
      <data key="d8">Enforcement by edicts</data>
      <data key="d9">chunk-a1a606296ab27c5dc7d129e54471d9c8</data>
      <data key="d10">dumps/World_History_Volume_1/pages_content.json</data>
      <data key="d11">1783211064</data>
    </edge>
    <edge source="&lt;Diocletians Persecution (303-311 CE)&gt;" target="&lt;Persecution Policies&gt;">
      <data key="d6">10.0</data>
      <data key="d7">One of the most severe campaigns against Christianity targeting their places of worship, marking a continuation of imperial persecution policies.</data>
      <data key="d8">Severe persecution</data>
      <data key="d9">chunk-a1a606296ab27c5dc7d129e54471d9c8</data>
      <data key="d10">dumps/World_History_Volume_1/pages_content.json</data>
      <data key="d11">1783211064</data>
    </edge>
    <edge source="&lt;Constantine's Edict of Milan (313 CE)&gt;" target="&lt;Persecution Policies&gt;">
      <data key="d6">8.0</data>
      <data key="d7">Initiated religious toleration as an emperor recognized the practical benefits of religious diversity and unity in his empire, marking a shift from previous policies.</data>
      <data key="d8">Policy evolution</data>
      <data key="d9">chunk-a1a606296ab27c5dc7d129e54471d9c8</data>
      <data key="d10">dumps/World_History_Volume_1/pages_content.json</data>
      <data key="d11">1783211064</data>
    </edge>
    <edge source="North Africa" target="Byzantine Egypt">
      <data key="d6">18.0</data>
      <data key="d7">Egypt served as a bridgehead for further expansion into North Africa after being conquered by the Islamic forces during the early seventh century.</data>
      <data key="d8">bridging</data>
      <data key="d9">chunk-70d03803311b31d7e11f7ace07e0a57f</data>
      <data key="d10">dumps/World_History_Volume_1/pages_content.json</data>
      <data key="d11">1783211096</data>
    </edge>
    <edge source="conquest" target="Rome's conquests'">
      <data key="d6">2.0</data>
      <data key="d7">Through conflicts with Carthaginians, Rome took control of coastal North African territories leading to settlement reforms and urban developments.</data>
      <data key="d8">conquests_settlement</data>
      <data key="d9">chunk-cdc7bbe967c34e7d69b34931a2e372ce</data>
      <data key="d10">dumps/World_History_Volume_1/pages_content.json</data>
      <data key="d11">1783211064</data>
    </edge>
    <edge source="embalming" target="Egyptian religious cults'">
      <data key="d6">2.0</data>
      <data key="d7">Local belief systems in Egypt became popular among Romans, influencing the practice of embalming in both cultures.</data>
      <data key="d8">religious_influence</data>
      <data key="d9">chunk-cdc7bbe967c34e7d69b34931a2e372ce</data>
      <data key="d10">dumps/World_History_Volume_1/pages_content.json</data>
      <data key="d11">1783211064</data>
    </edge>
    <edge source="&lt;Cleopatra&gt;" target="&lt;Roman Empire&gt;">
      <data key="d6">16.0</data>
      <data key="d7">Cleopatra was a significant figure during a critical period in Roman history, interacting with Roman political figures such as Julius Caesar and Mark Antony, highlighting her impact on the broader historical context of the Roman Empire.</data>
      <data key="d8">cultural interaction</data>
      <data key="d9">chunk-ada1cb5eb9784a9ea1025f60a1b39b64</data>
      <data key="d10">dumps/World_History_Volume_1/pages_content.json</data>
      <data key="d11">1783211064</data>
    </edge>
    <edge source="&lt;Cleopatra&gt;" target="&lt;citizenship_and_foreigners_in_the_Roman_Empire&gt;">
      <data key="d6">14.0</data>
      <data key="d7">Her status as a foreign queen in Rome influenced discussions about citizenship and foreigners within the empire, reflecting on how she was managed by Roman authorities.</data>
      <data key="d8">status management</data>
      <data key="d9">chunk-ada1cb5eb9784a9ea1025f60a1b39b64</data>
      <data key="d10">dumps/World_History_Volume_1/pages_content.json</data>
      <data key="d11">1783211064</data>
    </edge>
    <edge source="&lt;Cleopatra&gt;" target="&lt;Judaism&gt;">
      <data key="d6">8.0</data>
      <data key="d7">Although not directly related to Judaism, Cleopatra's complex interactions with various cultures could have influenced Jewish communities within her jurisdiction, showing indirect connections through broader socio-political contexts.</data>
      <data key="d8">cultural interaction</data>
      <data key="d9">chunk-ada1cb5eb9784a9ea1025f60a1b39b64</data>
      <data key="d10">dumps/World_History_Volume_1/pages_content.json</data>
      <data key="d11">1783211064</data>
    </edge>
    <edge source="&lt;Roman Empire&gt;" target="&lt;Cleopatra VII&gt;">
      <data key="d6">12.0</data>
      <data key="d7">Her rule and identity challenged established norms within Roman society, particularly as a foreign female ruler.</data>
      <data key="d8">Rule and Social Norms</data>
      <data key="d9">chunk-de110e24d0bf04c8c01e0288d95ba2e8</data>
      <data key="d10">dumps/World_History_Volume_1/pages_content.json</data>
      <data key="d11">1783211064</data>
    </edge>
    <edge source="&lt;Roman Empire&gt;" target="&lt;Greece (Ancient)&gt;">
      <data key="d6">2.0</data>
      <data key="d7">&lt;The Roman Empire emerged from the remnants of ancient Greek civilization, adopting many aspects of Greek culture and governance. Greek city-states and philosophy were foundational for Roman intellectual life.</data>
      <data key="d8">&lt;cultural_continuity&gt;</data>
      <data key="d9">chunk-2b5f6c1ce60c5a963cfeed75216a1324</data>
      <data key="d10">dumps/World_History_Volume_1/pages_content.json</data>
      <data key="d11">1783211106</data>
    </edge>
    <edge source="Official Roman attitudes to the Jewish people" target="Augustuss actions towards Jews">
      <data key="d6">8.0</data>
      <data key="d7">While Roman-ruled areas had mixed feelings, Augustus's reign saw favorable treatment of Judaism compared to other eras and rulers.</data>
      <data key="d8">Attitudes &amp; Policies</data>
      <data key="d9">chunk-9e131b6d032e817cf8fce3b119011788</data>
      <data key="d10">dumps/World_History_Volume_1/pages_content.json</data>
      <data key="d11">1783211064</data>
    </edge>
    <edge source="Philo, an Alexandrian Jewish ambassador" target="The Embassy to Gaius">
      <data key="d6">10.0</data>
      <data key="d7">Philo provided detailed information on the historical context of Jewish-Roman relations through his embassy documentation.</data>
      <data key="d8">Jewish-Roman Relations Documentation</data>
      <data key="d9">chunk-9e131b6d032e817cf8fce3b119011788</data>
      <data key="d10">dumps/World_History_Volume_1/pages_content.json</data>
      <data key="d11">1783211064</data>
    </edge>
    <edge source="Philo, an Alexandrian Jewish ambassador" target="Augustuss actions towards Jews">
      <data key="d6">8.0</data>
      <data key="d7">During Augustus's reign, Philo would have observed the positive treatment of Judaism and its integration into Roman society as a Jewish diplomat.</data>
      <data key="d8">Attitudes &amp; Policies,Diplomatic Observation</data>
      <data key="d9">chunk-9e131b6d032e817cf8fce3b119011788</data>
      <data key="d10">dumps/World_History_Volume_1/pages_content.json</data>
      <data key="d11">1783211064</data>
    </edge>
    <edge source="The Embassy to Gaius" target="Caligulas hostility toward Jews">
      <data key="d6">10.0</data>
      <data key="d7">Philo also highlighted Caligula's negative attitude towards Jewish people during his reign.</data>
      <data key="d8">Jewish-Roman Relations Documentation</data>
      <data key="d9">chunk-9e131b6d032e817cf8fce3b119011788</data>
      <data key="d10">dumps/World_History_Volume_1/pages_content.json</data>
      <data key="d11">1783211064</data>
    </edge>
    <edge source="Emperor Caligula" target="Caligulas hostility toward Jews">
      <data key="d6">6.0</data>
      <data key="d7">Under Emperor Caligula's rule, there was clear antagonism towards the Jewish people.</data>
      <data key="d8">Ruler Perceptions</data>
      <data key="d9">chunk-9e131b6d032e817cf8fce3b119011788</data>
      <data key="d10">dumps/World_History_Volume_1/pages_content.json</data>
      <data key="d11">1783211064</data>
    </edge>
    <edge source="&lt;Rome's Later Empire" target="Egypt and Britain and Gaul and eastern regions of the Roman Empire">
      <data key="d6">10.0</data>
      <data key="d7">These regions were part of Rome’s imperial conquests and economic networks, contributing to the empire's expansion and wealth.</data>
      <data key="d8">Conquest,Economic Domination</data>
      <data key="d9">chunk-393dfda9192e61fbe365e44f11da2c6f</data>
      <data key="d10">dumps/World_History_Volume_1/pages_content.json</data>
      <data key="d11">1783211064</data>
    </edge>
    <edge source="&lt;Rome's Later Empire" target="imperial cults (emperors)">
      <data key="d6">8.0</data>
      <data key="d7">Imperial cult emphasized the divinity of Roman emperors, reinforcing their authority and power within the empire.</data>
      <data key="d8">Cult Worship,Power</data>
      <data key="d9">chunk-393dfda9192e61fbe365e44f11da2c6f</data>
      <data key="d10">dumps/World_History_Volume_1/pages_content.json</data>
      <data key="d11">1783211064</data>
    </edge>
    <edge source="&lt;Rome's Later Empire" target="vestal virgins">
      <data key="d6">6.0</data>
      <data key="d7">Vestal virgins played a crucial role in maintaining Rome’s religious institutions, symbolizing holiness and social stability but also facing precarious lives.</data>
      <data key="d8">Holiness,Social Stability</data>
      <data key="d9">chunk-393dfda9192e61fbe365e44f11da2c6f</data>
      <data key="d10">dumps/World_History_Volume_1/pages_content.json</data>
      <data key="d11">1783211064</data>
    </edge>
    <edge source="&lt;Rome's Later Empire" target="mystery cults (Mithras and Isis)">
      <data key="d6">8.0</data>
      <data key="d7">Popularity of these esoteric rituals among the Roman populace reflects a diverse religious landscape within the empire.</data>
      <data key="d8">Religious Diversity,Secrecy</data>
      <data key="d9">chunk-393dfda9192e61fbe365e44f11da2c6f</data>
      <data key="d10">dumps/World_History_Volume_1/pages_content.json</data>
      <data key="d11">1783211065</data>
    </edge>
    <edge source="&lt;Rome's Later Empire" target="early Christians">
      <data key="d6">6.0</data>
      <data key="d7">Resistance from early Christians to traditional religions and practices led to persecution but also contributed to religious diversity.</data>
      <data key="d8">Persecution,Religious Pluralism</data>
      <data key="d9">chunk-393dfda9192e61fbe365e44f11da2c6f</data>
      <data key="d10">dumps/World_History_Volume_1/pages_content.json</data>
      <data key="d11">1783211065</data>
    </edge>
    <edge source="&lt;Rome's Later Empire" target="Roman elite">
      <data key="d6">8.0</data>
      <data key="d7">Adoption of Hellenistic elements and Egyptian features among the Roman upper class demonstrates cultural exchange within the empire.</data>
      <data key="d8">Cultural Exchange,Hellenization</data>
      <data key="d9">chunk-393dfda9192e61fbe365e44f11da2c6f</data>
      <data key="d10">dumps/World_History_Volume_1/pages_content.json</data>
      <data key="d11">1783211065</data>
    </edge>
    <edge source="&lt;Rome's Later Empire" target="Jewish people in Rome">
      <data key="d6">6.0</data>
      <data key="d7">Complex relationship involving both respect and conflicts, with eventual destructive actions against Jewish communities due to differing religious practices.</data>
      <data key="d8">Conflict,Religious Tensions,Respect</data>
      <data key="d9">chunk-393dfda9192e61fbe365e44f11da2c6f</data>
      <data key="d10">dumps/World_History_Volume_1/pages_content.json</data>
      <data key="d11">1783211065</data>
    </edge>
    <edge source="&lt;Rome's Later Empire" target="law against adultery">
      <data key="d6">4.0</data>
      <data key="d7">Reflects changes and norms within Roman social and legal frameworks during this period.</data>
      <data key="d8">Law,Social Norms</data>
      <data key="d9">chunk-393dfda9192e61fbe365e44f11da2c6f</data>
      <data key="d10">dumps/World_History_Volume_1/pages_content.json</data>
      <data key="d11">1783211065</data>
    </edge>
    <edge source="&lt;Rome's Later Empire" target="toga virilis">
      <data key="d6">6.0</data>
      <data key="d7">Symbol of manhood and citizenship within the Roman political system, indicative of status and responsibilities.</data>
