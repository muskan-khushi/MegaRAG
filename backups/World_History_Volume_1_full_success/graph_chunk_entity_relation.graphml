    <edge source="Peloponnesian War" target="Athens">
      <data key="d6">8.0</data>
      <data key="d7">Athens was at odds with Sparta during the Peloponnesian War and was a central figure in the Athenian Empire's efforts to oppose Sparta.</data>
      <data key="d8">conflict_participant</data>
