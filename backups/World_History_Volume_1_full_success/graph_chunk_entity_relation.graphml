    <node id="Empress Wuzong">
      <data key="d0">Empress Wuzong</data>
      <data key="d1">historical_figure</data>
      <data key="d2">Emperor Wen of Tang, also known as Emperor Wuzong, was known for his strong commitment to the state’s traditional values. His reign saw a major persecution of Buddhist monks and nuns in an attempt to restore Confucianism's dominant role.</data>
      <data key="d3">chunk-68886ae6bf0868f51bdd288cf9f2091f</data>
      <data key="d4">dumps/World_History_Volume_1/pages_content.json</data>
      <data key="d5">1783210980</data>
    </node>
    <node id="Umayyads">
      <data key="d0">Umayyads</data>
      <data key="d1">civilization_or_empire</data>
      <data key="d2">The Umayyad Caliphate was an Islamic Arab state that existed from 661 to 750 CE. It was based in Damascus, Syria, following the first Islamic conquests and played a crucial role in spreading Islam.</data>
      <data key="d3">chunk-68886ae6bf0868f51bdd288cf9f2091f</data>
