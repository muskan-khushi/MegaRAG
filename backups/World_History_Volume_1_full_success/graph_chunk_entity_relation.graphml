    <node id="Ethnic Hierarchies by Mongols">
      <data key="d0">Ethnic Hierarchies by Mongols</data>
      <data key="d1">historical_concept_or_event</data>
      <data key="d2">"&lt;description&gt;"The rigid social structure instituted by Yuan rulers with Mongols at the top, Semu ren next, and ethnic Han Chinese divided into higher and lower categories based on their submission to Mongol rule."</data>
      <data key="d3">chunk-6259dc7dab010ce384b0b2df8038b744</data>
      <data key="d4">dumps/World_History_Volume_1/pages_content.json</data>
