      <data key="d5">1783210967</data>
    </node>
    <node id="Creation of Baghdad as a new capital city">
      <data key="d0">Creation of Baghdad as a new capital city</data>
      <data key="d1">historical_concept_or_event</data>
      <data key="d2">The construction of Baghdad by the Abbasid Caliphate as a new capital to consolidate their power, administer affairs and showcase cultural achievements, located in northeastern Mesopotamia rather than western Arabia.</data>
      <data key="d3">chunk-1446ed4b941391bd4aa671377ea66c91</data>
      <data key="d4">dumps/World_History_Volume_1/pages_content.json</data>
      <data key="d5">1783210967</data>
    </node>
    <node id="Khurasan Province">
      <data key="d0">Khurasan Province</data>
      <data key="d1">geographical_location</data>
      <data key="d2">Located in northeastern Persia</data>
      <data key="d3">chunk-1446ed4b941391bd4aa671377ea66c91</data>
      <data key="d4">dumps/World_History_Volume_1/pages_content.json</data>
