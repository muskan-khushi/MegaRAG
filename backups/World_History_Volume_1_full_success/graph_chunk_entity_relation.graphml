    <node id="Song dynasty">
      <data key="d0">Song dynasty</data>
      <data key="d1">historical_figure</data>
      <data key="d2">The Song dynasty refers to a period of Chinese history that differs from earlier unified dynasties such as Tang and Han in terms of governance and societal changes.</data>
