      <data key="d1">&lt;"geographical_location"\|"historical_concept_or_event'</data>
      <data key="d2">&lt;"'Regions with increasing cultural and economic interaction due to migration and technological advancements from the Yayoi period."</data>
      <data key="d3">chunk-2837c43f553cbb300fb213aeacfbd742</data>
      <data key="d4">dumps/World_History_Volume_1/pages_content.json</data>
      <data key="d5">1783210868</data>
    </node>
    <node id="&lt;&quot;Society Change&quot;">
      <data key="d0">&lt;"Society Change"</data>
      <data key="d1">&lt;"historical_concept_or_event</data>
      <data key="d2">&lt;"Society changes associated with changing climate and political dynamics during the Yamato period (c. 300-579 AD). These changes included new religious affiliations, technological imports, and societal structures."</data>
      <data key="d3">chunk-6a717a9cc91941f9644696170c9a7c09</data>
      <data key="d4">dumps/World_History_Volume_1/pages_content.json</data>
      <data key="d5">1783210868</data>
    </node>
    <node id="&lt;&quot;Keyhole Tomb&quot;">
      <data key="d0">&lt;"Keyhole Tomb"</data>
      <data key="d1">&lt;"historical_concept_or_event</data>
      <data key="d2">&lt;"Large underground tombs characteristic of the Asuka period, built by skilled laborers to house elite figures. They reflect cultural advancements and centralized power dynamics during the Yamato era."</data>
      <data key="d3">chunk-6a717a9cc91941f9644696170c9a7c09</data>
      <data key="d4">dumps/World_History_Volume_1/pages_content.json</data>
