    <node id="Thucydides">
      <data key="d0">Thucydides</data>
      <data key="d1">historical_figure</data>
      <data key="d2">Thucydides, a Greek historian from the Golden Age, wrote objectively about the Peloponnesian War and is influential in historical methodologies.</data>
      <data key="d3">chunk-d1b923a222fa396828cfac46f7a026c9</data>
      <data key="d4">dumps/World_History_Volume_1/pages_content.json</data>
