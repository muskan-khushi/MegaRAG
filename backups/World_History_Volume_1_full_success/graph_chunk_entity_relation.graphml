    <edge source="&lt;The Aryans and Brahmanism&gt;" target="&lt;Indus Valley Civilization&gt;">
      <data key="d6">6.0</data>
      <data key="d7">Aryans enter Indian subcontinent during the Indus Valley's decline, leading to religious transformation from Vedic to Brahmanism</data>
      <data key="d8">civilization decline,conquerors,religious transformation</data>
      <data key="d9">chunk-6cbd9d663b9bcdcbd4f8a3f2604aa0a3</data>
