      <data key="d0">&lt;"Thutmose IV"</data>
      <data key="d1">&lt;"historical_figure</data>
      <data key="d2">&lt;"Thutmose IV was a Pharaoh of the Eighteenth Dynasty of Egypt and is known for inheriting his father's throne during the early part of Amenhotep III's reign. He later conducted military campaigns expanding Egyptian territory, particularly in Syria-Palestine."&lt;|</data>
      <data key="d3">chunk-e99b695e71f9120e8fa39e113560a3bc</data>
