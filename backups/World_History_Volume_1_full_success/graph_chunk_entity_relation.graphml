      <data key="d3">chunk-0f3483082d977617409e75f5948382d4</data>
      <data key="d2">&lt;"Procopius's work provides vivid depictions of Justinian's personal and political life, particularly his questionable path to power. This portrayal affects the reader's perception of the emperor’s fitness for rule."</data>
      <data key="d1">UNKNOWN</data>
      <data key="d4">dumps/World_History_Volume_1/pages_content.json</data>
