      <data key="d3">chunk-cd9c7f6e58d53fe2d7895baaf718081c</data>
      <data key="d2">The burial mounds at Cahokia were used for significant burials, reflecting complex cultural or religious practices within the Mississippian period society.</data>
      <data key="d1">UNKNOWN</data>
      <data key="d4">dumps/World_History_Volume_1/pages_content.json</data>
