    <node id="Little Ice Age">
      <data key="d0">Little Ice Age</data>
      <data key="d1">historical_concept_or_event</data>
      <data key="d2">The Little Ice Age refers to a historical period of cooling temperatures that lasted for centuries and significantly impacted agriculture, society, and technology. This colder phase affected numerous regions worldwide, shaping various aspects of human life and development during its duration.</data>
      <data key="d3">chunk-7bd3827bfd5334056018dfe31cb0eb60&lt;SEP&gt;chunk-70dd94547656099792d4fef912e447e8</data>
      <data key="d4">dumps/World_History_Volume_1/pages_content.json</data>
