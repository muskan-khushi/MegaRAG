    </node>
    <node id="Process of Islamization during the Abbasid period">
      <data key="d0">Process of Islamization during the Abbasid period</data>
      <data key="d1">historical_concept_or_event</data>
      <data key="d2">A gradual and selective adoption of Islamic culture, practices, and beliefs by non-Arab populations, without necessarily requiring a full religious conversion for all individuals.</data>
      <data key="d3">chunk-1446ed4b941391bd4aa671377ea66c91</data>
      <data key="d4">dumps/World_History_Volume_1/pages_content.json</data>
      <data key="d5">1783210967</data>
    </node>
    <node id="Shia supporters'">
      <data key="d0">Shia supporters'</data>
      <data key="d1">historical_figure</data>
      <data key="d2">Supporters of Ali who accepted him as the true caliph and upheld his lineage through his son-in-law Fatimah's marriage to him, thus elevating his family’s status in Islamic tradition.</data>
      <data key="d3">chunk-1446ed4b941391bd4aa671377ea66c91</data>
      <data key="d4">dumps/World_History_Volume_1/pages_content.json</data>
      <data key="d5">1783210967</data>
    </node>
    <node id="Role of Mecca and Medina in formation of Islam">
      <data key="d0">Role of Mecca and Medina in formation of Islam</data>
      <data key="d1">historical_concept_or_event</data>
      <data key="d2">Central religious cities where Muhammad lived and received revelations; primary places associated with the early history and spread of Islam.</data>
      <data key="d3">chunk-1446ed4b941391bd4aa671377ea66c91</data>
      <data key="d4">dumps/World_History_Volume_1/pages_content.json</data>
      <data key="d5">1783210967</data>
    </node>
    <node id="Map identification'">
      <data key="d0">Map identification'</data>
      <data key="d1">source_or_artifact</data>
      <data key="d2">Geographical regions such as Kingdom of Aksum, Byzantine Empire, Kingdom of Himyar, and Sasanian Empire on a map. Mecca was not targeted due to its significance in early Islamic history, pilgrimage importance, and local alliances.</data>
      <data key="d3">chunk-1446ed4b941391bd4aa671377ea66c91</data>
      <data key="d4">dumps/World_History_Volume_1/pages_content.json</data>
