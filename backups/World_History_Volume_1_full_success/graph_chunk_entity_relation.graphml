    <node id="&lt;&quot;Conquest&quot;">
      <data key="d0">&lt;"Conquest"</data>
      <data key="d1">&lt;"historical_concept_or_event</data>
      <data key="d2">&lt;Entity_description: A process by which one state, society or civilization subdues another group and integrates its territory into an empire. The Rashidun Caliphs initiated extensive territorial expansion and consolidation of Islamic communities during their rule.</data>
      <data key="d3">chunk-eca248d7090f58e7e1c63a9bfb407080</data>
      <data key="d4">dumps/World_History_Volume_1/pages_content.json</data>
