      <data key="d0">Islamization and Religious Rule under Islam</data>
      <data key="d1">historical_concept_or_event</data>
      <data key="d2">Islamization refers to the spread of Islamic religious and cultural practices over non-Muslim regions.</data>
      <data key="d3">chunk-7114383587a4baf0af7064a88a7b0f99</data>
