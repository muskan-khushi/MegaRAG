      <data key="d0">&lt;"geographical_location"</data>
      <data key="d1">&lt;"North Africa</data>
      <data key="d2">&lt;"A region encompassing modern-day Egypt, Libya, Sudan, Tunisia, Morocco, Algeria, and western Mauritania, central to trade routes and political activities during the described period."|</data>
      <data key="d3">chunk-a8af48913c15cba43ba646a75127490d</data>
