    <node id="&lt;&quot;unbounding determination&quot;&gt;">
      <data key="d0">&lt;"unbounding determination"&gt;</data>
      <data key="d1">&lt;cultural_or_religious_movement&gt;</data>
      <data key="d2">&lt;"Unbounding determination refers to the unwavering resolve of the American people as expressed by Roosevelt in his speech. This phrase emphasizes the resolute spirit and commitment to victory, emphasizing the collective will of the nation."&gt;</data>
      <data key="d3">chunk-22e11e00c89a73ab13d5224fcee3fd78</data>
      <data key="d4">dumps/World_History_Volume_1/pages_content.json</data>
      <data key="d5">1783210791</data>
    </node>
    <node id="&lt;&quot;inevitable triumph&quot;&gt;">
      <data key="d0">&lt;"inevitable triumph"&gt;</data>
      <data key="d1">&lt;cultural_or_religious_movement&gt;</data>
      <data key="d2">&lt;"Inevitable triumph is a phrase used by Franklin D. Roosevelt to convey his belief in the certainty of American success. It reflects a confident and uplifting sentiment towards the future outcome of the war, assuring the nation that they will ultimately prevail."&gt;</data>
      <data key="d3">chunk-22e11e00c89a73ab13d5224fcee3fd78</data>
      <data key="d4">dumps/World_History_Volume_1/pages_content.json</data>
