    </node>
    <node id="Almoravid Movement">
      <data key="d0">Almoravid Movement</data>
      <data key="d1">historical_concept_or_event</data>
      <data key="d2">The Almoravid movement was a militant Islamic group that emerged in the southern Sahara, leading to significant changes in West African politics and cultural landscape.</data>
      <data key="d3">chunk-d32d7ef2fac445505a9bd6f9b878a6f4</data>
      <data key="d4">dumps/World_History_Volume_1/pages_content.json</data>
