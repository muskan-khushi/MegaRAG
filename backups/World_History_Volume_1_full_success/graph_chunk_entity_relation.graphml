    <node id="War Elephants">
      <data key="d0">War Elephants</data>
      <data key="d1">historical_concept_or_event</data>
      <data key="d2">War elephants used as a significant military asset by both Carthage and Rome during their conflicts. Used for shock tactics and breaking enemy lines.</data>
      <data key="d3">chunk-9d01b2bc7f0fa2a526074ddf9298f4dc</data>
