      <data key="d0">&lt;"King Ezana of Aksum"</data>
      <data key="d1">&lt;"historical_figure</data>
      <data key="d2">&lt;"The ruler of the Kingdom of Aksum, known for his Christian conversion and issuing of inscriptions in Ge'ez, Greek, and Aramaic. He is a significant historical figure in Late Antiquity with contributions to early Christianity and Ethiopian history."&gt;</data>
      <data key="d3">chunk-8380859d289f759870d05deb1753edc3</data>
      <data key="d4">dumps/World_History_Volume_1/pages_content.json</data>
