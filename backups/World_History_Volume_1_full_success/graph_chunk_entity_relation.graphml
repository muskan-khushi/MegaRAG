    <node id="&lt;&quot;Bambuk goldfields&quot;">
      <data key="d0">&lt;"Bambuk goldfields"</data>
      <data key="d1">&lt;geographical_location&gt;</data>
      <data key="d2">&lt;"The Bambuk goldfields, located within the Saharan region, were rich sources of gold but challenging to control due to their distance from the capital. The king had difficulty enforcing rules over these areas."&lt;|</data>
      <data key="d3">chunk-69012398e94fc567ca6593314057bcf0</data>
