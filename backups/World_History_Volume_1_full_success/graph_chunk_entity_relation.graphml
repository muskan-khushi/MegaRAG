    <node id="&lt;Artistic_Depictions&gt;">
      <data key="d0">&lt;Artistic_Depictions&gt;</data>
      <data key="d1">&lt;source_or_artifact&gt;</data>
      <data key="d2">Early human artistic depictions include small animal and human sculptures made of carved bone or stone, hand prints, and cave paintings dating back approximately 40,000 years ago. Notable art surviving from the Cave of Altamira in northern Spain.</data>
      <data key="d3">chunk-d050ba72d7011fbfc01fd9092fd65a57</data>
      <data key="d4">dumps/World_History_Volume_1/pages_content.json</data>
      <data key="d5">1783210799</data>
    </node>
    <node id="&lt;Cave_Paintings_Coimbra&gt;">
      <data key="d0">&lt;Cave_Paintings_Coimbra&gt;</data>
      <data key="d1">&lt;source_or_artifact&gt;</data>
      <data key="d2">Cave paintings found in various locations date back to about 40,000 years ago. Specifically mentioned are cave paintings from the Cave of Altamira in northern Spain.</data>
      <data key="d3">chunk-d050ba72d7011fbfc01fd9092fd65a57</data>
      <data key="d4">dumps/World_History_Volume_1/pages_content.json</data>
      <data key="d5">1783210799</data>
