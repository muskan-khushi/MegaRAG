    <node id="&lt;&quot;Damascus&quot;">
      <data key="d0">&lt;"Damascus"</data>
      <data key="d1">&lt;"geographical_location</data>
      <data key="d2">&lt;Entity_description: The capital of the Umayyad Dynasty, known for the relocation of political center and significant architectural developments during the late 7th century. Damascus became a symbol of centralized power and Islamic culture under Umayyad rule.</data>
      <data key="d3">chunk-eca248d7090f58e7e1c63a9bfb407080</data>
      <data key="d4">dumps/World_History_Volume_1/pages_content.json</data>
