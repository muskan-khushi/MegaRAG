    <node id="Ghanaians">
      <data key="d0">Ghanaians</data>
      <data key="d1">historical_figure</data>
      <data key="d2">The Ghanaians are the central people in this historical context, whose tolerance was tested by the introduction of radical Islamic sects.</data>
      <data key="d3">chunk-d32d7ef2fac445505a9bd6f9b878a6f4</data>
      <data key="d4">dumps/World_History_Volume_1/pages_content.json</data>
