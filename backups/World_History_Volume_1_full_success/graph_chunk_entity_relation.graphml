      <data key="d0">&lt;"Delphi"&gt;</data>
      <data key="d1">&lt;geographical_location&gt;</data>
      <data key="d2">&lt;"A sacred site and home of the oracle of Apollo located in central Greece. Known for its spiritual significance and oracular pronouncements influential in Greek society."&gt;</data>
