      <data key="d0">&lt;"Boeotia"</data>
      <data key="d1">&lt;geographical_location</data>
      <data key="d2">&lt;"An ancient region in central Greece, known for its part in various historical conflicts, including those with Sparta and Thebes."</data>
      <data key="d3">chunk-2950474ba33f47bb39e303f028b2774e</data>
