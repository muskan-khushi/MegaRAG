    </node>
    <node id="&lt;&quot;Uthman ibn Affan&quot;">
      <data key="d0">&lt;"Uthman ibn Affan"</data>
      <data key="d1">&lt;"historical_figure</data>
      <data key="d2">&lt;Entity_description: The third caliph whose reign is marked by the compilation of the Quran and widespread dissemination of Islamic law. Uthman ruled from 644-656 CE, ending with his assassination in 656 CE.</data>
      <data key="d3">chunk-eca248d7090f58e7e1c63a9bfb407080</data>
      <data key="d4">dumps/World_History_Volume_1/pages_content.json</data>
