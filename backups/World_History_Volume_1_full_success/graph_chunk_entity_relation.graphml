    </node>
    <node id="&lt;Georgian Kingdom&gt;">
      <data key="d0">&lt;Georgian Kingdom&gt;</data>
      <data key="d1">&lt;geographical_location&gt;</data>
      <data key="d2">&lt;The Georgian Kingdom, an ancient state located in the Caucasus region, was influenced by and engaged in trade with both the Khwarazmians and Mongol empires.&gt;</data>
      <data key="d3">chunk-4e57e6349a7929fcf289f8da82a3abde</data>
      <data key="d4">dumps/World_History_Volume_1/pages_content.json</data>
      <data key="d5">1783210993</data>
    </node>
    <node id="&lt;Rus&gt;">
      <data key="d0">&lt;Rus&gt;</data>
      <data key="d1">&lt;culture_or_religious_movement&gt;</data>
      <data key="d2">&lt;Rus referred to the northeastern group of East Slavic tribes and later an early state that played a crucial role in the historical context of interactions between the Khwarazmians, Mongols, and other Central Asian powers.&gt;</data>
      <data key="d3">chunk-4e57e6349a7929fcf289f8da82a3abde</data>
      <data key="d4">dumps/World_History_Volume_1/pages_content.json</data>
