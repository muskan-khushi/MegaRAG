      <data key="d0">Early Seventh Century</data>
      <data key="d1">time_period</data>
      <data key="d2">The period marking the beginning of significant Islamic conquests in North Africa and beyond.</data>
      <data key="d3">chunk-70d03803311b31d7e11f7ace07e0a57f</data>
