    </node>
    <node id="Jomon Innovation Response">
      <data key="d0">Jomon Innovation Response</data>
      <data key="d1">civilization_or_empire</data>
      <data key="d2">The Jōmon people developed innovations like pottery in response to environmental pressures around twelve thousand years ago.</data>
      <data key="d3">chunk-6444c71b86edf5337c96dbb26fdca53e</data>
