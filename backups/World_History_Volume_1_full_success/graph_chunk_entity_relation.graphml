    <edge source="&lt;Clothing&gt;" target="&lt;Leggings&gt;">
      <data key="d6">8.4</data>
      <data key="d7">The leggings are a specific type of clothing that demonstrates adaptive practices during the Paleolithic Age.</data>
      <data key="d8">Item_typology</data>
      <data key="d9">chunk-959d0e5d4763f5423c8c6e422ec0cdb2</data>
