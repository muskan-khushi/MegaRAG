      <data key="d0">San Lorenzo (Site)&lt;\/Site)</data>
      <data key="d1">historical_concept_or_event</data>
      <data key="d2">San Lorenzo was a major site in the Olmec civilization known for large earthen platforms and notable architectural works like the 'red palace' and numerous stone sculptures.</data>
      <data key="d3">chunk-08fb9bfb38f84b34683dfd75182299f8</data>
      <data key="d4">dumps/World_History_Volume_1/pages_content.json</data>
