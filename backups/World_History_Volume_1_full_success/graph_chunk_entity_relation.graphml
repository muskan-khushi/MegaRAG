      <data key="d1">historical_concept_or_event</data>
      <data key="d2">The Swahili city-states were a series of coastal East African city-states that emerged during the medieval period, characterized by their unique blend of Bantu and Arabic cultures, significant engagement in long-distance trade networks, and architectural achievements like stone buildings.</data>
      <data key="d3">chunk-6fbcde17381f5e9dee30a651c33fb9e9</data>
      <data key="d4">dumps/World_History_Volume_1/pages_content.json</data>
      <data key="d5">1783210979</data>
