    <node id="Monte Albán">
      <data key="d0">Monte Albán</data>
      <data key="d1">geographical_location</data>
      <data key="d2">Perched on a flattened mountaintop, Monte Albán served as the capital of the Zapotec civilization from approximately 500 BCE to 800 CE in Oaxaca, Mexico.</data>
      <data key="d3">chunk-03a15d067f74707fd348b5bcb5e978e7</data>
