    <node id="Annona">
      <data key="d0">Annona</data>
      <data key="d1">historical_concept_or_event</data>
      <data key="d2">The official distribution of grain to Romans by the government was known as 'Annona', particularly important during Emperor Augustus' reign and a tool for political influence.</data>
      <data key="d3">chunk-26ccbf3441b6b8fad246e6cd56535b53</data>
