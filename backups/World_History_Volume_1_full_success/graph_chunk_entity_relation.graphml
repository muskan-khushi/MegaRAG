    <node id="&lt;&quot;Theodora&quot;&gt;">
      <data key="d0">&lt;"Theodora"&gt;</data>
      <data key="d1">&lt;"historical_figure"&gt;</data>
      <data key="d2">&lt;"Empress Theodora was known for her scandalous past as depicted by Procopius. She became both the Empress of Byzantine Emperor Justinian I and a highly influential figure in early 6th-century Constantinople."</data>
      <data key="d3">chunk-0f3483082d977617409e75f5948382d4</data>
      <data key="d4">dumps/World_History_Volume_1/pages_content.json</data>
