    </edge>
    <edge source="&lt;&quot;Qin Dynasty&quot;" target="&lt;&quot;Confucius&quot;">
      <data key="d6">2.0</data>
      <data key="d7">Although Confucius lived long before the Qin Dynasty, his ideas indirectly influenced Han and later dynasties that expanded on his teachings.</data>
      <data key="d8">philosophical-influence</data>
      <data key="d9">chunk-dff0e11d470077fc40e0d05ff82a3124</data>
      <data key="d10">dumps/World_History_Volume_1/pages_content.json</data>
      <data key="d11">1783211050</data>
    </edge>
    <edge source="&lt;&quot;Qin Dynasty&quot;" target="&lt;&quot;Imperial Court of Qin Shihuang Emperor&quot;">
      <data key="d6">2.0</data>
      <data key="d7">&lt;"The Imperial Court of Qin Shihuang Emperor was established during the Qin Dynasty when it became the central administrative hub for the new unified state."</data>
      <data key="d8">&lt;"establishment"</data>
      <data key="d9">chunk-cb1fcf0230e00461dcf4e472b596b4c2</data>
      <data key="d10">dumps/World_History_Volume_1/pages_content.json</data>
      <data key="d11">1783211054</data>
    </edge>
    <edge source="&lt;&quot;Qin Dynasty&quot;" target="&lt;&quot;Terracotta Army&quot;">
      <data key="d6">2.0</data>
      <data key="d7">&lt;"As a project during the Qin Dynasty, the Terracotta Army was a testimony to the technological and cultural achievements of this era."</data>
      <data key="d8">&lt;"royal engineering,military innovation"</data>
      <data key="d9">chunk-cb1fcf0230e00461dcf4e472b596b4c2</data>
      <data key="d10">dumps/World_History_Volume_1/pages_content.json</data>
      <data key="d11">1783211054</data>
    </edge>
    <edge source="&lt;&quot;Qin Dynasty&quot;" target="&lt;&quot;Great Wall of China&quot;">
      <data key="d6">2.0</data>
      <data key="d7">&lt;"While not directly built during his reign, the Great Wall was a vision that the Qin Emperor conceptualized as part of his strategy to secure his borders and unify China."</data>
      <data key="d8">&lt;"unification,territorial expansion"</data>
      <data key="d9">chunk-cb1fcf0230e00461dcf4e472b596b4c2</data>
      <data key="d10">dumps/World_History_Volume_1/pages_content.json</data>
