    </edge>
    <edge source="Mamluk Sultanate" target="Slavery in Islamic World">
      <data key="d6">18.0</data>
      <data key="d7">The Mamluk Sultanate was characterized by a reliance on a system of slavery for both administrative and defensive purposes, employing a distinctive form of slave-based governance that distinguished it within the broader context of the Islamic world.</data>
      <data key="d8">governance,institution,military,military service,slavery</data>
      <data key="d9">chunk-47fec5d364392047eb02361961d78934</data>
      <data key="d10">dumps/World_History_Volume_1/pages_content.json</data>
      <data key="d11">1783211103</data>
    </edge>
    <edge source="Slavery in Islamic World" target="Oxus River">
      <data key="d6">8.0</data>
      <data key="d7">The Oxus River was a source for enslaved slaves used in the military and administrative roles within the Islamic world.</data>
      <data key="d8">recruitment,river,slaves</data>
      <data key="d9">chunk-47fec5d364392047eb02361961d78934</data>
      <data key="d10">dumps/World_History_Volume_1/pages_content.json</data>
      <data key="d11">1783211103</data>
    </edge>
    <edge source="Slavery in Islamic World" target="Caucasus">
      <data key="d6">8.0</data>
      <data key="d7">People from the Caucasus were sources of enslaved soldiers used by Islamic states.</data>
