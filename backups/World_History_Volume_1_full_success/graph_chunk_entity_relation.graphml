    <node id="Homosapiens">
      <data key="d0">Homosapiens</data>
      <data key="d1">historical_figure</data>
      <data key="d2">Homo sapiens were present in Eurasia by at least 300,000 years ago and began migrating to the Americas around 18,000 years ago, marking a significant development period for Native Americans.</data>
      <data key="d3">chunk-97ab4cac183886ee18d87b065b2e0ad5</data>
