    </node>
    <node id="Rome's Conquests in Italy">
      <data key="d0">Rome's Conquests in Italy</data>
      <data key="d1">geographical_location</data>
      <data key="d2">The expansion of Rome's influence over various regions in Italy through military campaigns and alliances during the Punic wars, particularly focusing on Sicily and the Italian peninsula.</data>
      <data key="d3">chunk-9d01b2bc7f0fa2a526074ddf9298f4dc</data>
