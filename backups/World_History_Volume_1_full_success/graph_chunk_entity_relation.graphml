    <node id="spread of Islam and death in 632">
      <data key="d0">spread of Islam and death in 632</data>
      <data key="d1">event</data>
      <data key="d2">The expansion efforts continued until Muhammad's natural death in 632, marking the end of his life as a leader.</data>
      <data key="d3">chunk-33708cfaea8613ac13f575367841658f</data>
      <data key="d4">dumps/World_History_Volume_1/pages_content.json</data>
      <data key="d5">1783210962</data>
