    <node id="Foederati">
      <data key="d0">Foederati</data>
      <data key="d1">historical_concept_or_event</data>
      <data key="d2">Foederati refer to Germanic groups bound by treaty with the Roman Empire, maintaining some autonomy while providing military service in exchange.</data>
      <data key="d3">chunk-e8b93582db5d7a873cf44814a77997d9</data>
