    <node id="Early Hunter-Gatherers">
      <data key="d0">Early Hunter-Gatherers</data>
      <data key="d1">time_period</data>
      <data key="d2">Early Hunter-Gatherers refers to a period in prehistory when humans lived in small groups and relied on hunting, gathering, and fishing for their subsistence.</data>
      <data key="d3">chunk-150c128f9135f3abab674671136e1bb2</data>
      <data key="d4">dumps/World_History_Volume_1/pages_content.json</data>
      <data key="d5">1783210801</data>
    </node>
    <node id="San People">
      <data key="d0">San People</data>
      <data key="d1">cultural_or_religious_movement</data>
      <data key="d2">The San people are a group who were known by Samuel Daniell during a 1804 British expedition as early hunter-gatherers living in southern Africa.</data>
      <data key="d3">chunk-150c128f9135f3abab674671136e1bb2</data>
      <data key="d4">dumps/World_History_Volume_1/pages_content.json</data>
      <data key="d5">1783210801</data>
    </node>
    <node id="Samuel Daniell">
      <data key="d0">Samuel Daniell</data>
      <data key="d1">historical_figure</data>
      <data key="d2">Samuel Daniell was an artist employed by the British for their expeditions across southern Africa, known for sketching scenes such as those of the San people around 1804.</data>
      <data key="d3">chunk-150c128f9135f3abab674671136e1bb2</data>
      <data key="d4">dumps/World_History_Volume_1/pages_content.json</data>
      <data key="d5">1783210801</data>
    </node>
    <node id="San Hottentots">
      <data key="d0">San Hottentots</data>
      <data key="d1">geographical_location</data>
      <data key="d2">The term 'San Hottentots' refers specifically to a group living in southern Africa during this period and is referenced in art from the early 19th century.</data>
      <data key="d3">chunk-150c128f9135f3abab674671136e1bb2</data>
      <data key="d4">dumps/World_History_Volume_1/pages_content.json</data>
      <data key="d5">1783210801</data>
    </node>
    <node id="African SceneryandAnimals">
      <data key="d0">African SceneryandAnimals</data>
      <data key="d1">textbook_structure</data>
      <data key="d2">'African SceneryandAnimals' is likely the name of an old textbook or book series that includes the artwork attributed to Samuel Daniell, depicting scenes from southern Africa and its animals.</data>
      <data key="d3">chunk-150c128f9135f3abab674671136e1bb2</data>
      <data key="d4">dumps/World_History_Volume_1/pages_content.json</data>
      <data key="d5">1783210801</data>
    </node>
    <node id="Lush Environments">
      <data key="d0">Lush Environments</data>
      <data key="d1">geographical_location</data>
      <data key="d2">Lush environments refer to warm areas with abundant vegetation where hunter-gatherers could find a wide variety of edible plants and animals.</data>
      <data key="d3">chunk-150c128f9135f3abab674671136e1bb2</data>
      <data key="d4">dumps/World_History_Volume_1/pages_content.json</data>
      <data key="d5">1783210801</data>
    </node>
    <node id="Frigid Environments">
      <data key="d0">Frigid Environments</data>
      <data key="d1">geographical_location</data>
      <data key="d2">Frigid environments describe cold, icy regions where food sources such as fish, birds, and smaller land animals were more prominent.</data>
      <data key="d3">chunk-150c128f9135f3abab674671136e1bb2</data>
      <data key="d4">dumps/World_History_Volume_1/pages_content.json</data>
      <data key="d5">1783210801</data>
    </node>
    <node id="kalahari desert">
      <data key="d0">kalahari desert</data>
      <data key="d1">geographical_location</data>
      <data key="d2">Kalahari Desert of southern Africa, known for its arid conditions and home to the San people who live a hunter-gatherer lifestyle.</data>
      <data key="d3">chunk-9556c4c62dde493845781e64a44ca00c</data>
      <data key="d4">dumps/World_History_Volume_1/pages_content.json</data>
      <data key="d5">1783210801</data>
    </node>
    <node id="inuit">
      <data key="d0">inuit</data>
      <data key="d1">civilization_or_empire</data>
      <data key="d2">Inuit people practicing a form of hunter-gatherer lifestyle in the Arctic region of northern Alaska, Canada, and Greenland.</data>
      <data key="d3">chunk-9556c4c62dde493845781e64a44ca00c</data>
      <data key="d4">dumps/World_History_Volume_1/pages_content.json</data>
      <data key="d5">1783210801</data>
    </node>
    <node id="hunter-gatherer lifestyle">
      <data key="d0">hunter-gatherer lifestyle</data>
      <data key="d1">cultural_or_religious_movement</data>
      <data key="d2">Way of life involving hunting and gathering food that requires no agricultural cultivation or permanent settlements, prevalent among both San people and Inuit.</data>
      <data key="d3">chunk-9556c4c62dde493845781e64a44ca00c</data>
      <data key="d4">dumps/World_History_Volume_1/pages_content.json</data>
      <data key="d5">1783210801</data>
    </node>
    <node id="egalitarianism">
      <data key="d0">egalitarianism</data>
      <data key="d1">historical_concept_or_event</data>
      <data key="d2">Principle of equal status and rights within the San and Inuit groups, where there is minimal social hierarchy in these hunter-gatherer societies.</data>
      <data key="d3">chunk-9556c4c62dde493845781e64a44ca00c</data>
      <data key="d4">dumps/World_History_Volume_1/pages_content.json</data>
      <data key="d5">1783210801</data>
    </node>
    <node id="southern alaska">
      <data key="d0">southern alaska</data>
      <data key="d1">geographical_location</data>
      <data key="d2">Location associated with the Inuit people's habitat, specifically in northern regions including Alaska, Canada, and Greenland.</data>
      <data key="d3">chunk-9556c4c62dde493845781e64a44ca00c</data>
      <data key="d4">dumps/World_History_Volume_1/pages_content.json</data>
      <data key="d5">1783210801</data>
    </node>
    <node id="caribou">
      <data key="d0">caribou</data>
      <data key="d1">historical_figure</data>
      <data key="d2">Relevant animal to the Inuit’s diet, used for meat but also hides which they utilize for clothing and boats.</data>
      <data key="d3">chunk-9556c4c62dde493845781e64a44ca00c</data>
      <data key="d4">dumps/World_History_Volume_1/pages_content.json</data>
      <data key="d5">1783210801</data>
    </node>
    <node id="Kalahari Desert">
      <data key="d0">Kalahari Desert</data>
      <data key="d1">geographical_location</data>
      <data key="d2">Kalahari Desert is a large arid region situated in southern Africa, known for its harsh and dry conditions that have remained largely unchanged over thousands of years. This desert supports diverse environments characterized by sparse vegetation, which allows certain wildlife species such as antelope and giraffes to thrive. The San people inhabit the area in small communities, practicing a traditional hunter-gatherer lifestyle. The Kalahari Desert provides an interesting contrast to the extremes found in the Sahara, another major desert located further north in Africa's southwestern region.</data>
      <data key="d3">chunk-9556c4c62dde493845781e64a44ca00c&lt;SEP&gt;chunk-fe1025f0b9f819b6ebc89df353b87d27</data>
      <data key="d4">dumps/World_History_Volume_1/pages_content.json</data>
      <data key="d5">1783210806</data>
    </node>
    <node id="Inuit people">
      <data key="d0">Inuit people</data>
      <data key="d1">civilization_or_empire</data>
      <data key="d2">The Inuit are an indigenous group that inhabits the Arctic regions, primarily north of the Arctic Circle in Alaska, Canada, and Greenland. They practice a subsistence lifestyle based on hunting and fishing, using resources such as caribou for food and materials.</data>
      <data key="d3">chunk-9556c4c62dde493845781e64a44ca00c</data>
      <data key="d4">dumps/World_History_Volume_1/pages_content.json</data>
      <data key="d5">1783210801</data>
    </node>
    <node id="southern Africa">
      <data key="d0">southern Africa</data>
      <data key="d1">geographical_location</data>
      <data key="d2">Southern Africa, geographically situated in the southern parts of sub-Saharan Africa, encompasses diverse landscapes including deserts and savannas, and experiences varying climate zones ranging from semi-arid to tropical conditions. This region is home to numerous ethnic groups, notably including the San people. Historically, it was also a locus of significant cultural and political developments, particularly marked by the innovations brought about by Bantu-speaking peoples. These advancements facilitated the establishment of notable medieval kingdoms such as Mapungubwe and Zimbabwe.</data>
      <data key="d3">chunk-9556c4c62dde493845781e64a44ca00c&lt;SEP&gt;chunk-ad97ea1ef8e2c731dddc24e3eecbe4f2</data>
      <data key="d4">dumps/World_History_Volume_1/pages_content.json</data>
      <data key="d5">1783210806</data>
    </node>
    <node id="Alaska">
      <data key="d0">Alaska</data>
      <data key="d1">geographical_location</data>
      <data key="d2">A state in the United States located in the northwest region of North America. Alaska is part of the Arctic region and home to various Indigenous groups including the Inuit people who practice traditional ways of life.</data>
      <data key="d3">chunk-9556c4c62dde493845781e64a44ca00c</data>
      <data key="d4">dumps/World_History_Volume_1/pages_content.json</data>
      <data key="d5">1783210801</data>
    </node>
    <node id="Neolithic Period">
      <data key="d0">Neolithic Period</data>
      <data key="d1">time_period</data>
      <data key="d2">The Neolithic Period is a significant era in human history that began approximately 10,000 years ago. This period marked a fundamental shift from nomadic hunting and gathering lifestyles to settled agricultural practices, leading to the emergence of cities and increasingly complex societal structures. During this time, stone tools were replaced by those made from pottery, copper, or bronze. This transition not only changed technological aspects but also had profound impacts on social organization and economic systems, laying foundational elements for modern civilization.</data>
      <data key="d3">chunk-76038e7863fa5215fe1897473013b781&lt;SEP&gt;chunk-93c39510d11fc933bbd94a1b6ff98dad</data>
      <data key="d4">dumps/World_History_Volume_1/pages_content.json</data>
      <data key="d5">1783210807</data>
    </node>
    <node id="&lt;Göbekli Tepe&gt;">
      <data key="d0">&lt;Göbekli Tepe&gt;</data>
      <data key="d1">geographical_location</data>
      <data key="d2">Located in southeastern Turkey, Göbekli Tepe is a Neolithic archaeological site that has provided significant insights into the early development of religion and society. The site features multiple layers of structures dating back to around 10,000 BCE, which are believed to be temple-like complexes.</data>
      <data key="d3">chunk-e6f92e2d85bc1a39ec443d848d05d2af</data>
      <data key="d4">dumps/World_History_Volume_1/pages_content.json</data>
      <data key="d5">1783210802</data>
    </node>
    <node id="&lt;Neolithic Revolution&gt;">
      <data key="d0">&lt;Neolithic Revolution&gt;</data>
      <data key="d1">historical_concept_or_event</data>
      <data key="d2">Signifies the transition from hunting and gathering to agricultural societies during this period大约1万年前，人类开始定居、培养农作物和家畜，这是人类社会的一次重要变革。</data>
      <data key="d3">chunk-e6f92e2d85bc1a39ec443d848d05d2af</data>
      <data key="d4">dumps/World_History_Volume_1/pages_content.json</data>
      <data key="d5">1783210802</data>
    </node>
    <node id="&lt;Göbekli Tepe artifact&gt;">
      <data key="d0">&lt;Göbekli Tepe artifact&gt;</data>
      <data key="d1">source_or_artifact</data>
      <data key="d2">Archeological findings at Göbekli Tepe, particularly the carvings and sculptures which suggest religious activities before food production.</data>
      <data key="d3">chunk-e6f92e2d85bc1a39ec443d848d05d2af</data>
      <data key="d4">dumps/World_History_Volume_1/pages_content.json</data>
      <data key="d5">1783210802</data>
    </node>
    <node id="&lt;Schmidt&gt;">
      <data key="d0">&lt;Schmidt&gt;</data>
      <data key="d1">historical_figure</data>
      <data key="d2">A German archaeologist who conducted extensive research at Göbekli Tepe and concluded that it was a site with temple-like structures dating to the early Neolithic period.</data>
      <data key="d3">chunk-e6f92e2d85bc1a39ec443d848d05d2af</data>
      <data key="d4">dumps/World_History_Volume_1/pages_content.json</data>
      <data key="d5">1783210802</data>
    </node>
    <node id="&lt;Lee Clare&gt;">
      <data key="d0">&lt;Lee Clare&gt;</data>
      <data key="d1">historical_figure</data>
      <data key="d2">An advocate of alternative theories regarding Göbekli Tepe, she suggested that its construction by hunter-gatherers may have been an early form of resistance against agricultural lifestyles imposed by emergent civilizations.</data>
      <data key="d3">chunk-e6f92e2d85bc1a39ec443d848d05d2af</data>
      <data key="d4">dumps/World_History_Volume_1/pages_content.json</data>
      <data key="d5">1783210802</data>
    </node>
    <node id="&lt;Fertile Crescent&gt;">
      <data key="d0">&lt;Fertile Crescent&gt;</data>
      <data key="d1">geographical_location</data>
      <data key="d2">Middle Eastern region known for its early development of agriculture and civilization. The area includes parts of modern-day Iraq, Syria, Lebanon, Jordan, Israel, and Palestine.</data>
      <data key="d3">chunk-e6f92e2d85bc1a39ec443d848d05d2af</data>
      <data key="d4">dumps/World_History_Volume_1/pages_content.json</data>
      <data key="d5">1783210802</data>
    </node>
    <node id="&lt;Plant domestication&gt;">
      <data key="d0">&lt;Plant domestication&gt;</data>
      <data key="d1">historical_concept_or_event</data>
      <data key="d2">The process by which wild plants were genetically modified over generations to produce crops.</data>
      <data key="d3">chunk-e6f92e2d85bc1a39ec443d848d05d2af</data>
      <data key="d4">dumps/World_History_Volume_1/pages_content.json</data>
      <data key="d5">1783210802</data>
    </node>
    <node id="Neolithic Age">
      <data key="d0">Neolithic Age</data>
      <data key="d1">time_period</data>
      <data key="d2">The Neolithic Age is a period in prehistory characterized by the development of agriculture and sedentary lifestyles. It began approximately 10,000 years ago with the domestication of plants and animals.</data>
      <data key="d3">chunk-a4d6f532dbc20aade1c93b0700c3b84d</data>
      <data key="d4">dumps/World_History_Volume_1/pages_content.json</data>
      <data key="d5">1783210802</data>
    </node>
    <node id="Peru">
      <data key="d0">Peru</data>
      <data key="d1">geographical_location</data>
      <data key="d2">Peru, a country located in South America, is renowned for its diverse ecosystems and rich cultural heritage, playing a significant role in agricultural history, particularly in the domestication of llamas. This Andean nation is also home to important archaeological sites, including Norte Chico sites, which contribute to our understanding of prehistoric settlements within Peru's territory.</data>
      <data key="d3">chunk-a4d6f532dbc20aade1c93b0700c3b84d&lt;SEP&gt;chunk-01fbacc5fd9d868563c8694a482de678</data>
      <data key="d4">dumps/World_History_Volume_1/pages_content.json</data>
      <data key="d5">1783210808</data>
    </node>
    <node id="Llamas">
      <data key="d0">Llamas</data>
      <data key="d1">source_or_artifact</data>
      <data key="d2">Llamas are pack animals indigenous to South America, known for their large size and versatility in providing labor, fiber, and meat. They were domesticated in Peru during prehistoric times.</data>
      <data key="d3">chunk-a4d6f532dbc20aade1c93b0700c3b84d</data>
      <data key="d4">dumps/World_History_Volume_1/pages_content.json</data>
      <data key="d5">1783210803</data>
    </node>
    <node id="Hunter-gatherers">
      <data key="d0">Hunter-gatherers</data>
      <data key="d1">historical_figure</data>
      <data key="d2">Anarchic group of people who lived by hunting wild animals and gathering plants before the advent of agriculture.</data>
      <data key="d3">chunk-a4d6f532dbc20aade1c93b0700c3b84d</data>
      <data key="d4">dumps/World_History_Volume_1/pages_content.json</data>
      <data key="d5">1783210803</data>
    </node>
    <node id="Domestication of Humans">
      <data key="d0">Domestication of Humans</data>
      <data key="d1">historical_concept_or_event</data>
      <data key="d2">"The process where humans may have selected and reproduced advantaged traits such as docility and cooperativeness to develop agricultural populations and vice versa."|</data>
      <data key="d3">chunk-93c39510d11fc933bbd94a1b6ff98dad</data>
      <data key="d4">dumps/World_History_Volume_1/pages_content.json</data>
      <data key="d5">1783210803</data>
    </node>
    <node id="Plant Domestication">
      <data key="d0">Plant Domestication</data>
      <data key="d1">historical_concept_or_event</data>
      <data key="d2">The process of humans selecting, cultivating, and modifying plants to suit their needs, with some arguing that agriculture also influenced human traits.</data>
      <data key="d3">chunk-93c39510d11fc933bbd94a1b6ff98dad</data>
      <data key="d4">dumps/World_History_Volume_1/pages_content.json</data>
      <data key="d5">1783210803</data>
    </node>
    <node id="Agriculture">
      <data key="d0">Agriculture</data>
      <data key="d1">concept_or_activity</data>
      <data key="d2">Agriculture marks a crucial cultural transformation that emerged in settlements such as Mehrgarh, following the Natufian culture by thousands of years. This entity involves the practice of farming and raising crops or animals for both sustenance and economic gain.</data>
      <data key="d3">chunk-93c39510d11fc933bbd94a1b6ff98dad&lt;SEP&gt;chunk-747e78751c03e9ed731d7029e8f71270</data>
      <data key="d4">dumps/World_History_Volume_1/pages_content.json</data>
      <data key="d5">1783210807</data>
    </node>
    <node id="Docility and Cooperativeness">
      <data key="d0">Docility and Cooperativeness</data>
      <data key="d1">trait</data>
      <data key="d2">Traits selected through the process of domestication, indicating a shift towards more peaceful interactions and group cooperation among humans.</data>
      <data key="d3">chunk-93c39510d11fc933bbd94a1b6ff98dad</data>
      <data key="d4">dumps/World_History_Volume_1/pages_content.json</data>
      <data key="d5">1783210803</data>
    </node>
    <node id="Çatalhöyük">
      <data key="d0">Çatalhöyük</data>
      <data key="d1">historical_figure</data>
      <data key="d2">Çatalhöyük is a significant archaeological site located in southeastern Turkey, where evidence suggests human societies established large permanent settlements around 7200-6000 BCE. This Neolithic settlement is notable for its complex cultural practices, including beliefs and rituals related to bull sacrifices.</data>
      <data key="d3">chunk-93c39510d11fc933bbd94a1b6ff98dad&lt;SEP&gt;chunk-2b63f6d20ffb060f0c413763b316d411</data>
      <data key="d4">dumps/World_History_Volume_1/pages_content.json</data>
      <data key="d5">1783210808</data>
    </node>
    <node id="Near East">
      <data key="d0">Near East</data>
      <data key="d1">geographical_location</data>
      <data key="d2">A broad region that encompasses a large part of Western Asia, including countries such as Turkey, Syria, Iraq, Jordan, Lebanon, Israel, Palestine, and Cyprus.</data>
      <data key="d3">chunk-93c39510d11fc933bbd94a1b6ff98dad</data>
      <data key="d4">dumps/World_History_Volume_1/pages_content.json</data>
      <data key="d5">1783210804</data>
    </node>
    <node id="Wheat">
      <data key="d0">Wheat</data>
      <data key="d1">source_or_artifact</data>
      <data key="d2">The plant species that has been intensively cultivated by humans for thousands of years, used to exemplify the mutual domestication process between plants and people.</data>
      <data key="d3">chunk-93c39510d11fc933bbd94a1b6ff98dad</data>
      <data key="d4">dumps/World_History_Volume_1/pages_content.json</data>
      <data key="d5">1783210804</data>
    </node>
    <node id="Modern Humans Less Aggressive and Cooperative">
      <data key="d0">Modern Humans Less Aggressive and Cooperative</data>
      <data key="d1">trait</data>
      <data key="d2">A change in human behavior that suggests an adaptation towards more peaceful interactions over tens of thousands of years.</data>
      <data key="d3">chunk-93c39510d11fc933bbd94a1b6ff98dad</data>
      <data key="d4">dumps/World_History_Volume_1/pages_content.json</data>
      <data key="d5">1783210804</data>
    </node>
    <node id="&lt;Çatalhöyük&gt;">
      <data key="d0">&lt;Çatalhöyük&gt;</data>
      <data key="d1">&lt;geographical_location&gt;</data>
      <data key="d2">&lt;"Çatalhöyük is a Neolithic archaeological site located in Anatolia, Turkey, known for its mud-brick houses and unique architectural features. The inhabitants engaged in agriculture, hunting, and trade, using materials such as obsidian."&gt;</data>
      <data key="d3">chunk-dbfe0b8551a1c1ccdee815dd5bff6442</data>
      <data key="d4">dumps/World_History_Volume_1/pages_content.json</data>
      <data key="d5">1783210804</data>
    </node>
    <node id="&lt;Neolithic Age&gt;">
      <data key="d0">&lt;Neolithic Age&gt;</data>
      <data key="d1">&lt;time_period&gt;</data>
      <data key="d2">&lt;"The Neolithic Age is characterized by the development of agriculture, permanent settlements, and the emergence of complex social structures. Çatalhöyük exemplifies this period with its agricultural practices, diverse occupations, and religious artifacts."&gt;</data>
      <data key="d3">chunk-dbfe0b8551a1c1ccdee815dd5bff6442</data>
      <data key="d4">dumps/World_History_Volume_1/pages_content.json</data>
      <data key="d5">1783210804</data>
    </node>
    <node id="&lt;Mud brick&gt;">
      <data key="d0">&lt;Mud brick&gt;</data>
      <data key="d1">&lt;source_or_artifact&gt;</data>
      <data key="d2">&lt;"Mud brick was a common building material used in constructing the houses of Çatalhöyük, characterized by its clay-based composition and practicality for Neolithic construction techniques."&gt;</data>
      <data key="d3">chunk-dbfe0b8551a1c1ccdee815dd5bff6442</data>
      <data key="d4">dumps/World_History_Volume_1/pages_content.json</data>
      <data key="d5">1783210804</data>
    </node>
    <node id="&lt;Farmers, hunters, and skilled craftspeople&gt;">
      <data key="d0">&lt;Farmers, hunters, and skilled craftspeople&gt;</data>
      <data key="d1">&lt;cultural_or_religious_movement&gt;</data>
      <data key="d2">&lt;"These groups represent the diverse occupations found in Çatalhöyük, including farmers who cultivated crops, hunters who pursued game, and craftsmen who produced goods like tools and art."&gt;</data>
      <data key="d3">chunk-dbfe0b8551a1c1ccdee815dd5bff6442</data>
      <data key="d4">dumps/World_History_Volume_1/pages_content.json</data>
      <data key="d5">1783210804</data>
    </node>
    <node id="&lt;Cattle imagery&gt;">
      <data key="d0">&lt;Cattle imagery&gt;</data>
      <data key="d1">&lt;textbook_structure&gt;</data>
      <data key="d2">&lt;"Cattle imagery, such as bull heads and horns, likely held religious significance within Çatalhöyük, indicating veneration of cattle or mythological figures related to livestock."&gt;</data>
      <data key="d3">chunk-dbfe0b8551a1c1ccdee815dd5bff6442</data>
      <data key="d4">dumps/World_History_Volume_1/pages_content.json</data>
      <data key="d5">1783210804</data>
    </node>
    <node id="&lt;Obsidian&gt;">
      <data key="d0">&lt;Obsidian&gt;</data>
      <data key="d1">&lt;source_or_artifact&gt;</data>
      <data key="d2">&lt;"Obsidian was an important volcanic glass material used for tool-making and trade in Çatalhöyük. It was likely acquired through trade with distant regions such as Syria and Cyprus."&gt;</data>
