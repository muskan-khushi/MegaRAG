    <node id="&lt;Allah al-Din Muhammad&gt;">
      <data key="d0">&lt;Allah al-Din Muhammad&gt;</data>
      <data key="d1">&lt;historical_figure&gt;</data>
      <data key="d2">&lt;Allah al-Din Muhammad was a Muslim ruler who governed the Khwarazmian state, known for his resistance against Mongol invasions and his leadership within the Persianate world.&gt;</data>
      <data key="d3">chunk-4e57e6349a7929fcf289f8da82a3abde</data>
      <data key="d4">dumps/World_History_Volume_1/pages_content.json</data>
