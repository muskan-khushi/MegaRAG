    <node id="&lt;entity_name&gt;Caesar Augustus">
      <data key="d0">&lt;entity_name&gt;Caesar Augustus</data>
      <data key="d1">&lt;entity_type&gt;historical_figure</data>
      <data key="d2">&lt;entity_description&gt;The first emperor of the Roman Empire, who played a crucial role in establishing the empire in 27 BC. He is responsible for significant cultural and political reforms.&gt;</data>
      <data key="d3">chunk-35dabc1121dedf5713913da08d2b42e7</data>
      <data key="d4">dumps/World_History_Volume_1/pages_content.json</data>
      <data key="d5">1783210951</data>
    </node>
    <node id="&lt;entity_name&gt;Ancient Rome Textbook">
      <data key="d0">&lt;entity_name&gt;Ancient Rome Textbook</data>
      <data key="d1">&lt;entity_type&gt;textbook_structure</data>
      <data key="d2">&lt;entity_description&gt;An educational resource that covers history, culture, and politics of ancient Rome, often used in academic settings to teach students about the Roman Empire.&gt;</data>
      <data key="d3">chunk-35dabc1121dedf5713913da08d2b42e7</data>
      <data key="d4">dumps/World_History_Volume_1/pages_content.json</data>
      <data key="d5">1783210951</data>
