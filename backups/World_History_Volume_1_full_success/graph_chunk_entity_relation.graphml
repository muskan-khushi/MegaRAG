    <node id="&lt;&quot;gold trade&quot;">
      <data key="d0">&lt;"gold trade"</data>
      <data key="d1">&lt;historical_concept_or_event&gt;</data>
      <data key="d2">&lt;"Gold trade was a significant source of wealth for the Ghana Empire, especially in the Bambuk goldfields. Despite the challenges in controlling these mines, gold remained an important commodity both internally and for external trade."&lt;|</data>
      <data key="d3">chunk-69012398e94fc567ca6593314057bcf0</data>
