    </node>
    <node id="&lt;Paleolithic Age&gt;">
      <data key="d0">&lt;Paleolithic Age&gt;</data>
      <data key="d1">time_period</data>
      <data key="d2">A historical period characterized by the use of stone tools, beginning with the earliest stone tools and ending around 10,000 years ago.</data>
      <data key="d3">chunk-959d0e5d4763f5423c8c6e422ec0cdb2</data>
      <data key="d4">dumps/World_History_Volume_1/pages_content.json</data>
      <data key="d5">1783210800</data>
    </node>
    <node id="&lt;Ötzi&gt;">
      <data key="d0">&lt;Ötzi&gt;</data>
      <data key="d1">historical_figure</data>
      <data key="d2">An iceman from the late Neolithic or early Bronze Age (circa 3400–2500 BCE), found in the Alps and considered a significant historical figure of the Copper Age, providing insights into the life of paleolithic people.</data>
      <data key="d3">chunk-959d0e5d4763f5423c8c6e422ec0cdb2</data>
      <data key="d4">dumps/World_History_Volume_1/pages_content.json</data>
      <data key="d5">1783210800</data>
    </node>
    <node id="&lt;Austria and Italy alpine region&gt;">
      <data key="d0">&lt;Austria and Italy alpine region&gt;</data>
      <data key="d1">geographical_location</data>
      <data key="d2">The area where Ötzi was discovered, characterized by mountainous terrain. This location is crucial for understanding paleolithic human habitation and survival strategies.</data>
      <data key="d3">chunk-959d0e5d4763f5423c8c6e422ec0cdb2</data>
      <data key="d4">dumps/World_History_Volume_1/pages_content.json</data>
