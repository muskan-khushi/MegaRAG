      <data key="d0">Gaul (modern-day France and Belgium)</data>
      <data key="d1">geographical_location</data>
      <data key="d2">Modern geographical locations like France and Belgium were once under Roman control before being occupied by Germanic kingdoms.</data>
      <data key="d3">chunk-e8b93582db5d7a873cf44814a77997d9</data>
      <data key="d4">dumps/World_History_Volume_1/pages_content.json</data>
