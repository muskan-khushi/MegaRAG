    <edge source="Conquest-related texts" target="Historical books on military campaigns">
      <data key="d6">1.8</data>
      <data key="d7">(1) Detailed accounts in conquest texts provided key data for later historical works; (2) Primary sources informing the narratives of military history.</data>
      <data key="d8">source_material</data>
      <data key="d9">chunk-c5228e6c35a7a85bef70ff1dbbea5597</data>
      <data key="d10">dumps/World_History_Volume_1/pages_content.json</data>
      <data key="d11">1783211063</data>
    </edge>
    <edge source="&lt;&quot;Column Base of Antoninus Pius&quot;" target="&lt;&quot;Apotheosis&quot;">
      <data key="d6">2.0</data>
      <data key="d7">&lt;"The Column Base of Antoninus Pius visually represents the process of apotheosis, depicting the divine elevation of both emperor and his wife. This artifact provides tangible evidence of how deification was practiced during the Imperial Cult Period."|</data>
      <data key="d8">&lt;"apotheosis visualization"|</data>
      <data key="d9">chunk-035528ca825e083d04a2873ad0606500</data>
      <data key="d10">dumps/World_History_Volume_1/pages_content.json</data>
      <data key="d11">1783211063</data>
    </edge>
    <edge source="&lt;&quot;Imperial Cult Period&quot;" target="&lt;&quot;Cult of Deified Emperors&quot;">
      <data key="d6">2.0</data>
      <data key="d7">&lt;"The Imperial Cult Period marks the establishment and expansion of the worship of deified emperors, central to Roman religious practices. This institution was a core component of the period's cultural and religious landscape."|</data>
      <data key="d8">&lt;"emperor worship"|</data>
      <data key="d9">chunk-035528ca825e083d04a2873ad0606500</data>
      <data key="d10">dumps/World_History_Volume_1/pages_content.json</data>
      <data key="d11">1783211063</data>
    </edge>
    <edge source="&lt;&quot;Imperial Cult Period&quot;" target="&lt;&quot;Deification (Apoteosi)&quot;">
      <data key="d6">2.0</data>
      <data key="d7">&lt;"The process of deification, Apoteosi, was institutionalized during the Imperial Cult Period, reflecting the shift towards worshipping living and deceased emperors."|</data>
      <data key="d8">&lt;"deification practice"|</data>
      <data key="d9">chunk-035528ca825e083d04a2873ad0606500</data>
      <data key="d10">dumps/World_History_Volume_1/pages_content.json</data>
      <data key="d11">1783211064</data>
    </edge>
    <edge source="&lt;&quot;Imperial Cult Period&quot;" target="&lt;&quot;Apotheosis&quot;">
      <data key="d6">2.0</data>
      <data key="d7">&lt;"The Imperial Cult Period is characterized by the regular occurrence of apotheosis ceremonies for emperors, marking their transition to divine status."|</data>
      <data key="d8">&lt;"apotheosis ceremony"|</data>
      <data key="d9">chunk-035528ca825e083d04a2873ad0606500</data>
      <data key="d10">dumps/World_History_Volume_1/pages_content.json</data>
      <data key="d11">1783211064</data>
    </edge>
    <edge source="&lt;&quot;Roman Religion&quot;" target="&lt;&quot;Apotheosis&quot;">
      <data key="d6">2.0</data>
      <data key="d7">&lt;"The practice of apotheosis was deeply integrated into Roman religious practices. This ceremony transformed individuals into divine beings, thereby emphasizing the connection between religion and political power in ancient Rome."|</data>
      <data key="d8">&lt;"apotheosis ritual"|</data>
      <data key="d9">chunk-035528ca825e083d04a2873ad0606500</data>
      <data key="d10">dumps/World_History_Volume_1/pages_content.json</data>
      <data key="d11">1783211064</data>
    </edge>
    <edge source="&lt;&quot;Rome&quot;" target="&lt;&quot;Belisarius&quot;">
      <data key="d6">2.0</data>
      <data key="d7">Occupied Rome in 536.</data>
      <data key="d8">Conquest of key territories.</data>
