    <node id="&lt;&quot;Battle of Plataea&quot;">
      <data key="d0">&lt;"Battle of Plataea"</data>
      <data key="d1">&lt;historical_concept_or_event</data>
      <data key="d2">The Battle of Plataea, fought between the Greeks (led primarily by Athens) and the Persians in 479 BCE, is recognized as a significant conflict that effectively concluded the first Persian invasion. This battle marks a crucial turning point in favor of the Greek alliance, significantly impacting the course of the Persian Wars. It is also considered pivotal for the rise of Athenian power, ultimately concluding the Persian Wars and underscoring the leadership role of Athens in the Greek resistance against Persia.</data>
      <data key="d3">chunk-2950474ba33f47bb39e303f028b2774e</data>
      <data key="d4">dumps/World_History_Volume_1/pages_content.json</data>
      <data key="d5">1783210886</data>
    </node>
    <node id="&lt;&quot;Sparta&quot;">
      <data key="d0">&lt;"Sparta"</data>
      <data key="d1">&lt;historical_figure</data>
      <data key="d2">&lt;"One of the principal city-states in Ancient Greece, known for its militaristic culture and leading role during the Peloponnesian War against Athens."</data>
      <data key="d3">chunk-2950474ba33f47bb39e303f028b2774e</data>
      <data key="d4">dumps/World_History_Volume_1/pages_content.json</data>
      <data key="d5">1783210880</data>
    </node>
    <node id="&lt;&quot;Athenian Empire&quot;">
      <data key="d0">&lt;"Athenian Empire"</data>
      <data key="d1">&lt;civilization_or_empire</data>
      <data key="d2">&lt;"The empire built by Athens following the Persian Wars, characterized by its dominance and influence over other Greek city-states through the Delian League."</data>
      <data key="d3">chunk-2950474ba33f47bb39e303f028b2774e</data>
      <data key="d4">dumps/World_History_Volume_1/pages_content.json</data>
      <data key="d5">1783210880</data>
    </node>
