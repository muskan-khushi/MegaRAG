      <data key="d0">Human Resilience</data>
      <data key="d1">cultural_or_religious_movement</data>
      <data key="d2">The concept of Human Resilience is explored as a response to various crises, highlighting the adaptability and recovery of societies during challenging times.</data>
      <data key="d3">chunk-0f4d8efbf198b190c61398bff7ef3200</data>
      <data key="d4">dumps/World_History_Volume_1/pages_content.json</data>
      <data key="d5">1783211012</data>
    </node>
    <node id="Mongol China and Beyond">
      <data key="d0">Mongol China and Beyond</data>
      <data key="d1">geographical_location</data>
      <data key="d2">Mongol China and Beyond refers to the extensive territories conquered and administered by Mongols during the thirteenth century, including regions beyond traditional Chinese territories.</data>
      <data key="d3">chunk-dfd43568e4817f7de7fa5fd0bbb3f2e0</data>
