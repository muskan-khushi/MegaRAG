    <node id="&lt;Pastoralists (Nomadic Herders)">
      <data key="d0">&lt;Pastoralists (Nomadic Herders)</data>
      <data key="d1">cultural_or_religious_movement</data>
      <data key="d2">Groups of people who move seasonally to follow grazing lands and water sources, often associated with nomadic lifestyles and pastoral traditions.</data>
      <data key="d3">chunk-bacddcb0411fbd18f80694e00c36c414</data>
