    <node id="&lt;Khwarazmian state&gt;">
      <data key="d0">&lt;Khwarazmian state&gt;</data>
      <data key="d1">&lt;civilization_or_empire&gt;</data>
      <data key="d2">&lt;The Khwarazmian state was a major Central Asian empire that existed from 997 to 1231 and faced destruction by the Mongol invasions under Chinggis Khan.&gt;</data>
      <data key="d3">chunk-4e57e6349a7929fcf289f8da82a3abde</data>
      <data key="d4">dumps/World_History_Volume_1/pages_content.json</data>
